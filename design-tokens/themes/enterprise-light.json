{
  "schema": "xtend.design-tokens.pack.v1",
  "type": "theme",
  "name": "enterprise-light",
  "extends": "light",
  "workpackage": "WP-E12-12",
  "tokens": {
    "--xtend-color-primary": "#2563eb",
    "--xtend-color-primary-dark": "#1d4ed8",
    "--xtend-color-accent": "#ffffff",
    "--xtend-surface": "#ffffff",
    "--xtend-surface-muted": "#f8fafc",
    "--xtend-text": "#111827",
    "--xtend-overlay-bg": "rgba(17, 24, 39, 0.56)",
    "--xtend-border-color": "rgba(17, 24, 39, 0.16)",
    "--xtend-border": "1px solid rgba(17, 24, 39, 0.16)",
    "--xtend-focus-outline": "2px solid #2563eb",
    "--xtend-focus-outline-offset": "2px",
    "--xtend-info-bg": "#2563eb",
    "--xtend-info-fg": "#ffffff",
    "--xtend-success-bg": "#15803d",
    "--xtend-success-fg": "#ffffff",
    "--xtend-warning-bg": "#facc15",
    "--xtend-warning-fg": "#111827",
    "--xtend-error-bg": "#dc2626",
    "--xtend-error-fg": "#ffffff",
    "--xtend-glass-bg": "rgba(255, 255, 255, 0.72)",
    "--xtend-glass-blur": "16px",
    "--xtend-shadow": "0 12px 40px rgba(15, 23, 42, 0.14)",
    "--xtend-radius": "12px",
    "--xtend-font-family": "'Inter', 'Segoe UI', Arial, sans-serif",
    "--xtend-motion-duration-fast": "160ms",
    "--xtend-motion-duration-base": "220ms",
    "--xtend-motion-scale": "1"
  },
  "densityPacks": ["comfortable", "compact", "dense"],
  "cssParts": ["root", "control", "label", "content", "helper", "error"],
  "kernelBoundary": "no-rmt-kernel-import-of-xtend-types",
  "localOnly": true
}
