    "--xtend-radius-xs": "3px",
    "--xtend-radius-sm": "6px",
    "--xtend-radius-md": "10px",
    "--xtend-radius-lg": "14px",
    "--xtend-radius-panel": "12px",
    "--xtend-radius-control": "8px",
    "--xtend-elevation-0": "none",
    "--xtend-elevation-1": "0 1px 2px rgba(22, 27, 38, 0.08)",
    "--xtend-elevation-2": "0 12px 32px rgba(22, 27, 38, 0.14)",
    "--xtend-elevation-3": "0 28px 72px rgba(10, 16, 26, 0.24)",
    "--xtend-elevation-focus": "0 0 0 3px rgba(13, 126, 167, 0.22)",
    "--xtend-font-family-body": "\"Aptos\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "--xtend-font-family-heading": "\"Aptos Display\", \"Aptos\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "--xtend-font-family-control": "\"Aptos\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "--xtend-font-family-code": "\"Cascadia Code\", \"SFMono-Regular\", Consolas, monospace",
    "--xtend-font-size-display": "2rem",
    "--xtend-font-size-heading-lg": "1.375rem",
    "--xtend-font-size-heading-md": "1.125rem",
    "--xtend-font-size-heading-sm": "1rem",
    "--xtend-font-size-body": "0.95rem",
    "--xtend-font-size-label": "0.8125rem",
    "--xtend-font-size-control": "0.925rem",
    "--xtend-font-size-caption": "0.75rem",
    "--xtend-line-height-display": "1.12",
    "--xtend-line-height-heading": "1.22",
    "--xtend-line-height-body": "1.55",
    "--xtend-line-height-control": "1.2",
    "--xtend-font-weight-heading": "680",
    "--xtend-font-weight-body": "400",
    "--xtend-font-weight-label": "620",
    "--xtend-font-weight-control": "560",
    "--xtend-font-weight-strong": "720",
    "--xtend-font-feature-numeric": "\"tnum\" 1, \"lnum\" 1",
    "--xtend-motion-duration-instant": "80ms",
    "--xtend-motion-easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "--xtend-motion-easing-enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--xtend-motion-easing-exit": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "densityPacks": ["comfortable", "compact", "dense"],
  "cssParts": [
    "root",
    "control",
    "label",
    "content",
    "helper",
    "error",
    "icon",
    "surface",
    "panel",
    "overlay",
    "backdrop",
    "menu",
    "menu-surface",
    "trigger",
    "trigger-icon"
  ],
  "signaturePrinciples": [
    "quiet-precision",
    "material-ohne-dekor",
    "productive-density",
    "strong-defaults-strong-overrides",
    "distinct-enterprise-voice"
  ],
  "typographyRoles": [
    "display",
    "heading",
    "body",
    "label",
    "control",
    "caption",
    "numeric",
    "code"
  ],
  "kernelBoundary": "no-rmt-kernel-import-of-xtend-types",
  "localOnly": true,
  "exportPolicy": "reference-only-until-ECH-WP-03"
}
