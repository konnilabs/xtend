{
  "schema": "xtend.design-tokens.pack.v1",
  "type": "theme",
  "name": "xtend-signature",
  "extends": "light",
  "workpackage": "ECH-WP-00",
  "status": "reference-draft",
  "description": "Reference token pack for the XTend Signature UI and typography direction.",
  "tokens": {
    "--xtend-color-primary": "#0d7ea7",
    "--xtend-color-primary-dark": "#075f80",
    "--xtend-color-accent": "#f6fbff",
    "--xtend-surface": "#f4f6f9",
    "--xtend-surface-muted": "#e9edf3",
    "--xtend-text": "#18212f",
    "--xtend-overlay-bg": "rgba(24, 33, 47, 0.58)",
    "--xtend-border-color": "rgba(24, 33, 47, 0.14)",
    "--xtend-border": "1px solid rgba(24, 33, 47, 0.14)",
    "--xtend-focus-outline": "2px solid #0d7ea7",
    "--xtend-focus-outline-offset": "2px",
    "--xtend-info-bg": "#0d7ea7",
    "--xtend-info-fg": "#f6fbff",
    "--xtend-success-bg": "#127a4a",
    "--xtend-success-fg": "#f6fff9",
    "--xtend-warning-bg": "#b7791f",
    "--xtend-warning-fg": "#1e1607",
    "--xtend-error-bg": "#b8323a",
    "--xtend-error-fg": "#fff7f7",
    "--xtend-glass-bg": "rgba(247, 249, 252, 0.82)",
    "--xtend-glass-blur": "12px",
    "--xtend-shadow": "0 18px 48px rgba(22, 27, 38, 0.16)",
    "--xtend-radius": "10px",
    "--xtend-font-family": "\"Aptos\", \"Inter\", \"Segoe UI\", system-ui, sans-serif",
    "--xtend-motion-duration-fast": "140ms",
    "--xtend-motion-duration-base": "210ms",
    "--xtend-motion-scale": "1",
    "--xtend-signature-surface-page": "#f4f6f9",
    "--xtend-signature-surface-raised": "#fbfcfe",
    "--xtend-signature-surface-panel": "#ffffff",
    "--xtend-signature-surface-inset": "#edf1f6",
    "--xtend-signature-edge-subtle": "rgba(24, 33, 47, 0.12)",
    "--xtend-signature-edge-strong": "rgba(24, 33, 47, 0.22)",
    "--xtend-signature-ink": "#18212f",
    "--xtend-signature-ink-muted": "#536070",
    "--xtend-signature-accent": "#0d7ea7",
    "--xtend-signature-accent-soft": "rgba(13, 126, 167, 0.12)",
