    "description": "Sicherer dom_descriptor Template Record fuer shell-first Rendering."
  },
  "RMT HTML Fragment Template": {
    "scope": "rmt",
    "prefix": "rmt-template-html",
    "body": [
      "{",
      "  \"id\": \"${1:article.shell}\",",
