      "  \"id\": \"${1:home.shell}\",",
      "  \"mode\": \"dom_descriptor\",",
      "  \"nodes\": [",
      "    {",
      "      \"tag\": \"${2:main}\",",
      "      \"children\": []",
      "    }",
      "  ],",
      "  \"hydration\": {",
