{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xtend.xtensions.url-state-restore-plan.v1",
  "title": "xtend.xtensions.url-state-restore-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "policyId",
    "policyVersion",
    "navigationId",
    "status",
    "changes",
    "missing"
  ],
  "properties": {
    "schema": {
      "const": "xtend.xtensions.url-state-restore-plan.v1"
    },
    "documentId": {
      "$ref": "#/definitions/name"
    },
    "policyId": {
      "$ref": "#/definitions/name"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "navigationId": {
      "$ref": "#/definitions/name"
    },
    "status": {
      "enum": [
        "ready",
        "unchanged",
        "deferred"
      ]
    },
    "changes": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declarationId",
          "keys",
          "field",
          "previous",
          "value"
        ],
        "properties": {
          "declarationId": {
            "$ref": "#/definitions/name"
          },
          "keys": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/definitions/key"
            }
          },
          "field": {
            "$ref": "#/definitions/field"
          },
          "previous": {
            "$ref": "#/definitions/scalar"
          },
          "value": {
            "$ref": "#/definitions/scalar"
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/address"
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarationId",
        "keys"
      ],
      "properties": {
        "declarationId": {
          "$ref": "#/definitions/name"
        },
        "keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/key"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "minItems": 1,
            "type": "array"
          },
          "missing": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unchanged"
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "maxItems": 0,
            "type": "array"
          },
          "missing": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deferred"
          }
        }
      },
      "then": {
        "properties": {
          "changes": {
            "maxItems": 0,
            "type": "array"
          },
          "missing": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
