{
  "schema": "xtend.rmt.editor.vscode-grammar.v1",
  "name": "XTendRMT",
  "scopeName": "source.rmt",
  "fileTypes": [
    "rmt"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#componentTags"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#lanes"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "source.json"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rmt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rmt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rmt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rmt",
              "match": "\\\\."
            },
            {
              "name": "variable.other.interpolation.rmt",
              "match": "\\$\\{[^}]+\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rmt",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "componentTags": {
      "patterns": [
        {
          "name": "entity.name.tag.xtend.rmt",
          "match": "\\bx-[a-z][a-z0-9-]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rmt",
          "match": "\\b(import|template|remote|surface|lane|slot|on|when|from|to|as|state|selector|datasource|dataSource|action|effect|resource|event|validation|transition|portal|overlay|stream|mount|hydrate|suspend|resume|invalidate|dispose|prewarm|recycle|detach|reattach|trigger|target|field|include|route|schedule|component|part|theme|emit|open|close|focus|minimize|restore|destroy|exposes|emits|consumes)\\b"
        },
        {
          "name": "storage.type.rmt",
          "match": "\\b(dom_descriptor|html_fragment|json|record|array|string|number|boolean|integer|object|file|body|owner|key|props|attrs|events|bindings|cleanup|mode|type|source|repeat|bounds|preserve|releases|required|email|minLength|maxLength|pattern|message|method|contract|result|fallback|status|input|output|reduce|payload|preventDefault|where|find|sort|by|effect|durationMs|easing|surfaces|blocking|root|layer|z|kind|origin|version|integrity|direction|policy|adapterRef|queryState|resultState|actionRefRequired|registeredCommands|collectionViews|commandSources|searchSources|securityPolicies|sourceMap)\\b"
        },
        {
          "name": "support.constant.transition.rmt",
          "match": "\\b(fade|crossfade|slide-left|slide-right|slide-up|slide-down|scale|none)\\b"
        },
        {
          "name": "constant.language.boolean.rmt",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "lanes": {
      "patterns": [
        {
          "name": "support.constant.lane.rmt",
          "match": "\\b(critical|visible|user-blocking|transition|resource|a11y|idle|background|diagnostics)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.rmt",
          "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.rmt",
          "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)+\\b"
        }
      ]
    }
  }
}
