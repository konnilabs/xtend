{
  "name": "@ccslabs/xtend-cli",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "XTend scaffold, builder and component authoring CLI.",
  "license": "Apache-2.0",
  "keywords": [
    "ccslabs",
    "xtend",
    "cli",
    "scaffold",
    "builder"
  ],
  "main": "./scaffold.js",
  "types": "./scaffold.d.ts",
  "bin": {
    "xt": "./scaffold.js",
    "xtend": "./scaffold.js",
    "xtend-scaffold": "./scaffold.js"
  },
  "files": [
    "a11y",
    "blueprints",
    "extensions",
    "generators",
    "lib",
    "performance",
    "preview",
    "templates",
    "typing",
    "utils",
    "wiring",
    "workflows",
    "writing",
    "builder-public-types.d.ts",
    "scaffold.config.d.ts",
    "scaffold.config.js",
    "scaffold.d.ts",
    "scaffold.js",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./scaffold.d.ts",
      "default": "./scaffold.js"
    },
    "./scaffold": {
      "types": "./scaffold.d.ts",
      "default": "./scaffold.js"
    },
    "./builder-types": {
      "types": "./builder-public-types.d.ts",
      "default": "./builder-public-types.d.ts"
    },
    "./generators/*": {
      "types": "./generators/*.d.ts",
      "default": "./generators/*.js"
    },
    "./templates/*": {
      "types": "./templates/*.d.ts",
      "default": "./templates/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@ccslabs/xtend": "0.1.0-rc.1",
    "@ccslabs/xtend-compiler": "0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@ccslabs/xtend": {
      "optional": true
    },
    "@ccslabs/xtend-compiler": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "engines": {
    "node": ">=18"
  }
}
