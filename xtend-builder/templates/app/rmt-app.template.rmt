// @generated by XTend Scaffold - maraca-rmt-app
template app.scaffold {
  state app.status type object preserve {
    initial {
      id "app-status"
      text "Ready."
      tone "neutral"
    }
  }
  state app.command type object preserve {
    initial {
      id "app-run-check"
      text "Run check"
      tone "primary"
      disabled false
    }
  }

  selector app.status from state app.status { output AppStatus }
  selector app.command from state app.command { output AppCommand }

  datasource app.health from host app.health {
    mode invoke
    contract "xtend.maraca.health.v1"
  }

  action app.runCheck {
    input label string
    effect fetch datasource app.health
    reduce state.app.status.text = "Check passed."
    reduce state.app.status.tone = "success"
  }

  portal app.root root "#app" layer surface

  surface app.status kind card component x-status {
    source selector app.status
    key status.id
    portal app.root
    lane visible weight 100 { hydrate app-status from selector app.status }
  }
  surface app.command kind action component x-button {
    source selector app.command
    key command.id
    portal app.root
    lane visible weight 90 { hydrate app-run-check from selector app.command }
    on click "#app-run-check" -> action app.runCheck {
      preventDefault true
      payload label from target.dataset.label
    }
  }
}
