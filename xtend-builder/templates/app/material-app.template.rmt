// @generated by XTend Scaffold - material-maraca-app
template material.scaffold.app {
  state material.app.shell type object preserve {
    initial {
      id "material-app-shell"
      viewTemplate { class "xtm-app-shell" }
    }
  }
  state material.app.header type object preserve {
    initial {
      id "material-top-app-bar"
      title "{{appTitle}}"
      viewTemplate { class "xtm-top-app-bar" }
    }
  }
  state material.app.workspace type object preserve {
    initial {
      id "material-workspace"
      viewTemplate { class "xtm-workspace" }
    }
  }
  state material.app.content type object preserve {
    initial {
      id "material-content-page"
      viewTemplate { class "xtm-content-page" }
    }
  }
  state material.app.empty type object preserve {
    initial {
      id "material-empty-state"
      text "Start building with XTend Material."
      tone "neutral"
      viewTemplate { class "xtm-empty-state" }
    }
  }
  state material.app.command type object preserve {
    initial {
      id "material-run-check"
      text "Run compatibility check"
      tone "primary"
      disabled false
      viewTemplate { class "xtm-primary-action" }
    }
  }
  state material.app.feedback type object preserve {
    initial {
      id "material-check-result"
      text "Compatibility check ready."
      tone "neutral"
      viewTemplate { class "xtm-feedback-stack" }
    }
  }
  state material.app.navigation type object preserve {
    initial {
      id "material-navigation"
      label "Workspace navigation"
      open true
      viewTemplate {
        class "xtm-navigation-rail"
        attributes { "data-state" "open" }
        children [
          {
            type "element"
            tag "a"
            class "xtm-primary-action"
            attributes { href "#/dashboard" "data-xtm-route-link" "dashboard" }
            text "Dashboard"
          }
          {
            type "element"
            tag "a"
            class "xtm-primary-action"
            attributes { href "#/details" "data-xtm-route-link" "details" }
            text "Details"
          }
        ]
      }
    }
  }
  state material.app.dashboard type object preserve {
    initial {
      id "material-dashboard"
      title "Operations dashboard"
      text "A neutral starting surface for everyday applications."
      viewTemplate { class "xtm-dashboard" }
    }
  }
  state material.app.detail type object preserve {
    initial {
      id "material-detail"
      title "Details"
      text "A second routable content surface."
      viewTemplate { class "xtm-card" }
    }
  }
  state material.app.form type object preserve {
    initial {
      id "material-form"
      viewTemplate { class "xtm-form-flow" }
    }
  }
  state material.app.field type object preserve {
    initial {
      id "material-name-field"
      field "name"
      label "Name"
      value ""
      inputType "text"
      required true
    }
  }
  state material.app.requestReview type object preserve {
    initial {
      id "material-review"
      text "Review input"
      tone "primary"
      disabled true
      viewTemplate { class "xtm-primary-action" }
    }
  }
  state material.app.confirmation type object preserve {
    initial {
      id "material-confirmation"
      title "Confirm review"
      open false
      viewTemplate { class "xtm-confirmation-flow" }
    }
  }

  selector material.app.shell from state material.app.shell { output MaterialAppShell }
  selector material.app.header from state material.app.header { output MaterialTopAppBar }
  selector material.app.workspace from state material.app.workspace { output MaterialWorkspace }
  selector material.app.content from state material.app.content { output MaterialContentPage }
  selector material.app.empty from state material.app.empty { output MaterialEmptyState }
  selector material.app.command from state material.app.command { output MaterialCommand }
  selector material.app.feedback from state material.app.feedback { output MaterialFeedback }
  selector material.app.navigation from state material.app.navigation { output MaterialNavigation }
  selector material.app.dashboard from state material.app.dashboard { output MaterialDashboard }
  selector material.app.detail from state material.app.detail { output MaterialDetail }
  selector material.app.form from state material.app.form { output MaterialForm }
  selector material.app.field from state material.app.field { output MaterialField }
  selector material.app.requestReview from state material.app.requestReview { output MaterialReview }
  selector material.app.confirmation from state material.app.confirmation { output MaterialConfirmation }

  validation material.app.name {
    mode blocking
    target action material.app.requestReview
    field material.app.field required message "Enter a name before review."
  }

  datasource material.app.health from host material.app.health {
    mode invoke
    contract "xtend.maraca.health.v1"
  }

  action material.app.runCheck {
    input label string
    effect fetch datasource material.app.health
    reduce state.material.app.feedback.text = "Compatibility check passed."
    reduce state.material.app.feedback.tone = "success"
  }
  action material.app.updateName {
    input value string
    reduce state.material.app.field.value = input.value
  }
  action material.app.requestReview {
    input label string
    reduce state.material.app.confirmation.open = true
  }
  action material.app.confirmReview {
    input label string
    reduce state.material.app.confirmation.open = false
    reduce state.material.app.feedback.text = "Review confirmed."
    reduce state.material.app.feedback.tone = "success"
  }

  transition material.app.reviewFlow {
    trigger action material.app.requestReview
    from surfaces [material.app.dashboard material.app.detail material.app.requestReview]
    to surfaces [material.app.confirmation]
    effect crossfade
    durationMs 160
    easing "ease-out"
    interrupt replace
    reducedMotion fade
    lane transition
  }

  portal material.app.root root "#material-app" layer surface

  surface material.app.shell kind workspace component x-surface-manager {
    source selector material.app.shell
    key shell.id
    portal material.app.root
    lane visible weight 100 { hydrate material-app-shell from selector material.app.shell }
  }
  surface material.app.header kind content component x-header {
    source selector material.app.header
    key header.id
    portal material.app.root
    lane visible weight 95 { hydrate material-top-app-bar from selector material.app.header }
  }
  surface material.app.workspace kind content component x-surface-region {
    source selector material.app.workspace
    key workspace.id
    portal material.app.root
    lane visible weight 90 { hydrate material-workspace from selector material.app.workspace }
  }
  surface material.app.content kind content component x-summary {
    source selector material.app.content
    key content.id
    portal material.app.root
    lane visible weight 80 { hydrate material-content-page from selector material.app.content }
  }
  surface material.app.empty kind card component x-status {
    source selector material.app.empty
    key empty.id
    portal material.app.root
    lane visible weight 70 { hydrate material-empty-state from selector material.app.empty }
  }
  surface material.app.command kind action component x-button {
    source selector material.app.command
    key command.id
    portal material.app.root
    lane visible weight 65 { hydrate material-run-check from selector material.app.command }
    on click "#material-run-check" -> action material.app.runCheck {
      preventDefault true
      payload label from target.dataset.label
    }
  }
  surface material.app.feedback kind card component x-status {
    source selector material.app.feedback
    key feedback.id
    portal material.app.root
    lane visible weight 60 { hydrate material-check-result from selector material.app.feedback }
  }
  surface material.app.navigation kind navigation component x-drawer {
    source selector material.app.navigation
    key navigation.id
    portal material.app.root
    lane visible weight 58 { hydrate material-navigation from selector material.app.navigation }
  }
  surface material.app.dashboard kind card component x-cards {
    source selector material.app.dashboard
    key dashboard.id
    portal material.app.root
    lane visible weight 56 { hydrate material-dashboard from selector material.app.dashboard }
  }
  surface material.app.detail kind content component x-summary {
    source selector material.app.detail
    key detail.id
    portal material.app.root
    lane visible weight 54 { hydrate material-detail from selector material.app.detail }
  }
  surface material.app.form kind window component x-form {
    source selector material.app.form
    key form.id
    portal material.app.root
    lane visible weight 52 { hydrate material-form from selector material.app.form }
  }
  surface material.app.field kind field component x-input {
    source selector material.app.field
    key field.id
    portal material.app.root
    lane visible weight 50 { hydrate material-name-field from selector material.app.field }
    on input-changed "#material-name-field" -> action material.app.updateName {
      payload value from detail.value
    }
  }
  surface material.app.requestReview kind action component x-button {
    source selector material.app.requestReview
    key requestReview.id
    portal material.app.root
    lane visible weight 48 { hydrate material-review from selector material.app.requestReview }
    on click "#material-review" -> action material.app.requestReview {
      preventDefault true
      payload label from target.dataset.label
    }
  }
  surface material.app.confirmation kind modal component x-dialog {
    source selector material.app.confirmation
    key confirmation.id
    portal material.app.root
    lane transition weight 46 { hydrate material-confirmation from selector material.app.confirmation }
    on click "[data-action='confirm']" -> action material.app.confirmReview {
      payload label from target.dataset.label
    }
  }
}
