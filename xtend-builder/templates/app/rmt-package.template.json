{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "Generated provider-neutral XTend Maraca application.",
  "scripts": {
    "plan": "xt maraca plan --config maraca.config.json --json",
    "build": "xt maraca build --config maraca.config.json --json",
    "serve": "{{serveCommand}}",
    "start": "{{startCommand}}",
    "tune": "xt maraca tune src/app.rmt --config maraca.config.json --out dist --write --json",
    "test": "node --test test/app.smoke.test.cjs",
    "test:catfood": "npm run build && node --test"
  },
  "dependencies": {
    "@ccslabs/xtend": "^0.8.0",
    "@ccslabs/xtend-maraca": "^0.8.0"
  },
  "devDependencies": {
    "@ccslabs/xtend-cli": "^0.8.0",
    {{nodeTypesDependencyLine}}"typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
