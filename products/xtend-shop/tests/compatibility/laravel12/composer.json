{
  "name": "ccslabs/xtend-shop",
  "description": "XTend.store PHP SSR reference application",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "ccslabs/xtend-laravel": "0.8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "XtendStore\\Payment\\": "payment-provider/src/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": ".packages/xtend-laravel",
      "options": {
        "symlink": false
      }
    }
  ],
  "config": {
    "allow-plugins": false,
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  }
}
