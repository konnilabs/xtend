{
  "name": "xtend-store/demopay",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ccslabs/xtend-laravel": "0.8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": ".packages/xtend-laravel",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "XtendStore\\Payment\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {}
  }
}
