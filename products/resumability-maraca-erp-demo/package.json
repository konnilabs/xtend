{
  "name": "xtend-resumability-maraca-erp-demo",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "description": "Tracked XTend RMT resumability ERP catfood product with signed SSR adoption and the full XTension matrix.",
  "xtend": {
    "schema": "xtend.rmt.erp-resumability-catfood.v1",
    "status": "required",
    "executionMode": "server_prerender_resume",
    "fallbackMode": "server_prerender_hydrate",
    "catalog": "../../package.json#xtend.erpResumabilityCatfooding",
    "lessons": "catfooding-lessons.json",
    "evidence": "catfooding-evidence.json"
  },
  "scripts": {
    "build": "npm run build:maraca && npm run build:xtensions",
    "build:maraca": "node scripts/build-maraca.mjs",
    "build:xtensions": "node scripts/build-xtensions.mjs",
    "tune": "node ../../xtend-builder/bin/xt maraca tune src/rmt/erp-shell.rmt --config maraca.tuned.config.json --out dist/maraca --write --json",
    "tune:check": "node ../../xtend-builder/bin/xt maraca tune src/rmt/erp-shell.rmt --config maraca.tuned.config.json --out dist/maraca --check --json",
    "catfood": "npm run build && npm run tune:check && npm run verify",
    "dev": "node server/index.mjs",
    "start": "node server/index.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@ccslabs/xtend": "file:../..",
    "@ccslabs/xtend-cli": "file:../../xtend-builder",
    "@ccslabs/xtend-compiler": "file:../../tools",
    "@ccslabs/xtend-maraca": "file:../../xtend-maraca",
    "@ccslabs/xtend-rmt": "file:../../xtendrmt",
    "@angular/common": "~19.2.0",
    "@angular/core": "~19.2.0",
    "@angular/platform-browser": "~19.2.0",
    "@angular/platform-server": "~19.2.0",
    "@openui5/sap.m": "1.149.1",
    "@openui5/sap.ui.core": "1.149.1",
    "@openui5/sap.ui.layout": "1.149.1",
    "@openui5/sap.ui.unified": "1.149.1",
    "@openui5/themelib_sap_horizon": "1.149.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^7.8.0",
    "three": "^0.170.0",
    "vue": "3.5.0",
    "@vue/server-renderer": "3.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@angular/compiler": "~19.2.0",
    "@angular/compiler-cli": "~19.2.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=24"
  }
}
