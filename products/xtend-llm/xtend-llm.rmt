    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    recipe "select-choice-menu" target state.xtend.llm.toolMenu value "auto"
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.cancel = result.cancel
    reduce state.xtend.llm.retry = result.retry
    reduce state.xtend.llm.progress = result.progress
    reduce state.xtend.llm.spinner = result.spinner
    reduce state.xtend.llm.error = result.error
  }

  action xtend.llm.newConversation {
    input label string
    effect fetch datasource xtend.llm.newConversation
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.error = result.error
  }

  action xtend.llm.selectConversation {
    input conversationId string
    effect fetch datasource xtend.llm.selectConversation
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.error = result.error
  }

  action xtend.llm.openConversationMenu {
    input conversationId string
    effect fetch datasource xtend.llm.openConversationMenu
    reduce state.xtend.llm.conversationList = result.conversationList
  }

  action xtend.llm.requestDeleteConversation {
    input conversationId string
    effect fetch datasource xtend.llm.requestDeleteConversation
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.deleteConversationDialog = result.deleteConversationDialog
  }

  action xtend.llm.closeDeleteConversation {
    input label string
    effect fetch datasource xtend.llm.closeDeleteConversation
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.deleteConversationDialog = result.deleteConversationDialog
  }

  action xtend.llm.confirmDeleteConversation {
    input label string
    effect fetch datasource xtend.llm.confirmDeleteConversation
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.deleteConversationDialog = result.deleteConversationDialog
    reduce state.xtend.llm.error = result.error
  }

  action xtend.llm.toggleToolMenu {
    input label string
    recipe "toggle-choice-menu" target state.xtend.llm.toolMenu
  }

  action xtend.llm.selectTool {
    input toolName string
    recipe "select-choice-menu" target state.xtend.llm.toolMenu value input.toolName
  }

  action xtend.llm.openSettings {
    input label string
    effect fetch datasource xtend.llm.openSettings
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
    reduce state.xtend.llm.runtimeDiagnostics = result.runtimeDiagnostics
  }

  action xtend.llm.closeSettings {
    input label string
    effect fetch datasource xtend.llm.closeSettings
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.selectSettingsTab {
    input selected string
    effect fetch datasource xtend.llm.selectSettingsTab
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.updateSettingsTheme {
    input mode string
    effect fetch datasource xtend.llm.updateSettingsTheme
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.updateSettingsInstructions {
    input value string
    effect fetch datasource xtend.llm.updateSettingsInstructions
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.saveSettings {
    input label string
    effect fetch datasource xtend.llm.saveSettings
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
    reduce state.xtend.llm.modelStatus = result.modelStatus
  }

  action xtend.llm.beginSettingsReset {
    input label string
    effect fetch datasource xtend.llm.beginSettingsReset
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.cancelSettingsReset {
    input label string
    effect fetch datasource xtend.llm.cancelSettingsReset
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
  }

  action xtend.llm.confirmSettingsReset {
    input label string
    effect fetch datasource xtend.llm.confirmSettingsReset
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
    reduce state.xtend.llm.runtimeDiagnostics = result.runtimeDiagnostics
  }

  action xtend.llm.readRuntimeDiagnostics {
    input label string
    effect fetch datasource xtend.llm.readRuntimeDiagnostics
    reduce state.xtend.llm.runtimeDiagnostics = result.runtimeDiagnostics
  }

  transition xtend.llm.idleToGenerating {
    trigger action xtend.llm.send
    from surfaces [xtend.llm.send]
    to surfaces [xtend.llm.cancel xtend.llm.spinner]
    effect crossfade
    durationMs 180
    easing "ease-out"
    lane transition
  }

  transition xtend.llm.generatingToIdle {
    trigger action xtend.llm.cancelGeneration
    from surfaces [xtend.llm.cancel xtend.llm.spinner]
    to surfaces [xtend.llm.send]
    effect fade
    durationMs 160
    easing "ease-out"
    lane transition
  }

  transition xtend.llm.snapshotToIdle {
    trigger action xtend.llm.applySnapshot
    from surfaces [xtend.llm.cancel xtend.llm.spinner xtend.llm.retry]
    to surfaces [xtend.llm.send xtend.llm.modelStatus xtend.llm.activeConversation]
    effect fade
    durationMs 140
    easing "ease-out"
    lane transition
  }

  transition xtend.llm.retryToGenerating {
    trigger action xtend.llm.retryGeneration
    from surfaces [xtend.llm.retry xtend.llm.error]
    to surfaces [xtend.llm.cancel xtend.llm.spinner xtend.llm.modelStatus]
    effect crossfade
    durationMs 180
    easing "ease-out"
    lane transition
  }

  transition xtend.llm.newConversationReset {
    trigger action xtend.llm.newConversation
    from surfaces [xtend.llm.activeConversation xtend.llm.transcript xtend.llm.prompt]
    to surfaces [xtend.llm.activeConversation xtend.llm.transcript xtend.llm.prompt]
    effect slide-left
    durationMs 180
    easing "ease-out"
    lane transition
  }

  transition xtend.llm.selectConversationRefresh {
    trigger action xtend.llm.selectConversation
    from surfaces [xtend.llm.activeConversation xtend.llm.transcript]
    to surfaces [xtend.llm.activeConversation xtend.llm.transcript]
    effect slide-left
    durationMs 160
    easing "ease-out"
    lane transition
  }

  portal surface.root root "#xtend-maraca-root" layer surface

  resource xtend.llm.session kind data owner surface.xtend.llm.modelStatus {
    dispose on surface.destroy
  }

  surface xtend.llm.conversationPanel kind navigation component x-side-panel {
    source selector xtend.llm.conversationPanel
    key conversationPanel.id
    portal surface.root
    bounds x 0 y 0 width 288 height 720

    lane visible weight 90 {
      hydrate conversation-panel from selector xtend.llm.conversationPanel {
        hydration mode server_prerender_hydrate
      }
    }
  }

  surface xtend.llm.conversationSearch kind field component x-input {
    source selector xtend.llm.conversationSearch
    key conversationSearch.id
    portal surface.root
    bounds x 20 y 152 width 248 height 76

    lane visible weight 80 {
      hydrate conversation-search from selector xtend.llm.conversationSearch {
        hydration mode server_prerender_hydrate
      }
    }

    on xtend-command "#conversation-search" -> action xtend.llm.updateConversationSearch {
      payload value from detail.payload.value
    }
  }

  surface xtend.llm.newConversation kind action component x-button {
    source selector xtend.llm.newConversation
    key newConversation.id
    portal surface.root
    bounds x 20 y 88 width 152 height 52

    lane visible weight 80 {
      mount new-conversation from selector xtend.llm.newConversation
    }

    on xtend-command "#new-conversation" -> action xtend.llm.newConversation {
      preventDefault true
      payload label from detail.payload.label
    }
  }

  surface xtend.llm.settingsButton kind action component x-button {
    source selector xtend.llm.settingsButton
    key settingsButton.id
    portal surface.root
    bounds x 216 y 88 width 52 height 52

    lane visible weight 80 {
      mount settings-button from selector xtend.llm.settingsButton
    }

    on xtend-command "#settings-button" -> action xtend.llm.openSettings {
      preventDefault true
      payload label from detail.payload.label
    }
  }

  surface xtend.llm.conversationList kind navigation component nav {
    source selector xtend.llm.conversationList
    key conversationList.id
    portal surface.root
    bounds x 20 y 244 width 248 height 432

    lane visible weight 60 {
      hydrate conversation-list from selector xtend.llm.conversationList {
        hydration mode server_prerender_hydrate
      }
    }

    on xtend-command ".xtend-llm-conversation-button" -> action xtend.llm.selectConversation {
      preventDefault true
      payload conversationId from detail.payload.conversationId
    }

    on xtend-command ".xtend-llm-conversation-more" -> action xtend.llm.openConversationMenu {
      preventDefault true
      payload conversationId from detail.payload.conversationId
    }

    on xtend-command ".xtend-llm-conversation-menu-item" -> action xtend.llm.requestDeleteConversation {
      preventDefault true
      payload conversationId from detail.payload.conversationId
    }
  }

  surface xtend.llm.modelStatus kind card component x-status {
    source selector xtend.llm.modelStatus
    key modelStatus.id
    portal surface.root
    bounds x 320 y 24 width 360 height 72
    destroy releases resource xtend.llm.session

    lane visible weight 90 {
      hydrate model-status from selector xtend.llm.modelStatus {
        hydration mode server_prerender_hydrate
      }
    }
  }

  surface xtend.llm.activeConversation kind card component x-status {
    source selector xtend.llm.activeConversation
    key activeConversation.id
    portal surface.root
    bounds x 696 y 24 width 400 height 72

    lane visible weight 80 {
      hydrate active-conversation from selector xtend.llm.activeConversation {
        hydration mode server_prerender_hydrate
      }
    }
  }

  surface xtend.llm.transcript kind content component section {
    source selector xtend.llm.transcript
    key transcript.id
    portal surface.root
    bounds x 320 y 120 width 776 height 456

    lane visible weight 70 {
      hydrate chat-transcript from selector xtend.llm.transcript {
        hydration mode server_prerender_hydrate
      }
    }

    on xtend-command ".xtend-llm-message-action-copy" -> action xtend.llm.copyAssistantMessage {
      preventDefault true
      payload action from detail.payload.action
      payload conversationId from detail.payload.conversationId
      payload messageId from detail.payload.messageId
    }

    on xtend-command ".xtend-llm-message-action-regenerate" -> action xtend.llm.regenerateAssistantMessage {
      preventDefault true
      payload action from detail.payload.action
      payload conversationId from detail.payload.conversationId
      payload messageId from detail.payload.messageId
    }
  }

  surface xtend.llm.prompt kind field component x-textarea {
    source selector xtend.llm.prompt
    key prompt.id
    portal surface.root
    bounds x 320 y 600 width 888 height 164

    lane visible weight 90 {
      hydrate prompt-input from selector xtend.llm.prompt {
        hydration mode server_prerender_hydrate
      }
    }

    on xtend-command "#prompt-input" -> action xtend.llm.routePromptCommand {
      payload command from detail.command
      payload value from detail.payload.value
      payload empty from detail.payload.empty
    }
  }

  surface xtend.llm.toolMenu kind action component div {
    source selector xtend.llm.toolMenu
    key toolMenu.id
    portal surface.root
    bounds x 340 y 700 width 210 height 44

    lane visible weight 85 {
      hydrate tool-menu from selector xtend.llm.toolMenu {
        hydration mode server_prerender_hydrate
      }
    }

    on xtend-command "#tool-menu-button" -> action xtend.llm.toggleToolMenu {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command ".xtend-llm-tool-menu-item" -> action xtend.llm.selectTool {
      preventDefault true
      payload toolName from detail.payload.toolName
    }
  }

  surface xtend.llm.send kind action component x-button {
    source selector xtend.llm.send
    key send.id
    portal surface.root
    bounds x 1104 y 700 width 84 height 44

    lane visible weight 90 {
      mount send-message from selector xtend.llm.send
    }

    on xtend-command "#send-message" -> action xtend.llm.send {
      preventDefault true
      payload label from detail.payload.label
    }
  }

  surface xtend.llm.cancel kind action component x-button {
    source selector xtend.llm.cancel
    key cancel.id
    portal surface.root
    bounds x 1104 y 700 width 84 height 44

    lane visible weight 90 {
      mount cancel-generation from selector xtend.llm.cancel
    }

    on xtend-command "#cancel-generation" -> action xtend.llm.cancelGeneration {
      preventDefault true
      payload label from detail.payload.label
    }
  }

  surface xtend.llm.retry kind action component x-button {
    source selector xtend.llm.retry
    key retry.id
    portal surface.root
    bounds x 1104 y 700 width 84 height 44

    lane visible weight 70 {
      mount retry-generation from selector xtend.llm.retry
    }

    lane idle weight 12 {
      hydrate retry-generation from selector xtend.llm.retry {
        hydration mode worker_prerender_hydrate
      }
      prewarm retry-generation
    }

    on xtend-command "#retry-generation" -> action xtend.llm.retryGeneration {
      preventDefault true
      payload label from detail.payload.label
    }
  }

  surface xtend.llm.spinner kind feedback component x-spinner {
    source selector xtend.llm.spinner
    key spinner.id
    portal surface.root
    bounds x 1084 y 728 width 52 height 52

    lane visible weight 70 {
      hydrate generation-spinner from selector xtend.llm.spinner {
        hydration mode worker_prerender_hydrate
      }
    }

    lane idle weight 12 {
      prewarm generation-spinner
    }
  }

  surface xtend.llm.error kind feedback component x-status {
    source selector xtend.llm.error
    key error.id
    portal surface.root
    bounds x 320 y 784 width 888 height 72

    lane visible weight 70 {
      hydrate runtime-error from selector xtend.llm.error {
        hydration mode worker_prerender_hydrate
      }
    }

    lane idle weight 10 {
      prewarm runtime-error
    }
  }

  surface xtend.llm.deleteConversationDialog kind modal component x-dialog {
    source selector xtend.llm.deleteConversationDialog
    key deleteConversationDialog.id
    portal surface.root
    bounds x 0 y 0 width 420 height 240

    lane visible weight 95 {
      hydrate delete-conversation-dialog from selector xtend.llm.deleteConversationDialog {
        hydration mode worker_prerender_hydrate
      }
    }

    lane idle weight 18 {
      prewarm delete-conversation-dialog
    }

    on xtend-command "#delete-conversation-cancel" -> action xtend.llm.closeDeleteConversation {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command "#delete-conversation-confirm" -> action xtend.llm.confirmDeleteConversation {
      preventDefault true
      payload label from detail.payload.label
    }

    on dialog-closed "#delete-conversation-dialog" -> action xtend.llm.closeDeleteConversation {
      payload label from detail.source
    }
  }

  surface xtend.llm.settingsDialog kind modal component x-dialog {
    source selector xtend.llm.settingsDialog
    key settingsDialog.id
    portal surface.root
    bounds x 0 y 0 width 960 height 600

    lane visible weight 95 {
      hydrate settings-dialog from selector xtend.llm.settingsDialog {
        hydration mode worker_prerender_hydrate
      }
    }

    lane idle weight 20 {
      prewarm settings-dialog
    }

    on xtend-command "#settings-cancel" -> action xtend.llm.closeSettings {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command "#settings-save" -> action xtend.llm.saveSettings {
      preventDefault true
      payload label from detail.payload.label
    }

    on tab-selected "#settings-tabs" -> action xtend.llm.selectSettingsTab {
      payload selected from detail.index
    }

    on xtend-command ".xtend-llm-theme-option" -> action xtend.llm.updateSettingsTheme {
      preventDefault true
      payload mode from detail.payload.mode
    }

    on xtend-command "#settings-custom-instructions" -> action xtend.llm.updateSettingsInstructions {
      payload value from detail.payload.value
    }

    on xtend-command "#settings-reset" -> action xtend.llm.beginSettingsReset {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command "#settings-reset-cancel" -> action xtend.llm.cancelSettingsReset {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command "#settings-reset-confirm" -> action xtend.llm.confirmSettingsReset {
      preventDefault true
      payload label from detail.payload.label
    }

    on xtend-command "#runtime-diagnostics-refresh" -> action xtend.llm.readRuntimeDiagnostics {
      preventDefault true
      payload label from detail.payload.label
    }

    on dialog-closed "#settings-dialog" -> action xtend.llm.closeSettings {
      payload label from detail.source
    }
  }

  surface xtend.llm.runtimeDiagnostics kind diagnostics component section {
    source selector xtend.llm.runtimeDiagnostics
    key runtimeDiagnostics.id
    portal surface.root
    bounds x 0 y 0 width 1 height 1

    lane idle weight 8 {
      hydrate runtime-diagnostics from selector xtend.llm.runtimeDiagnostics {
        hydration mode worker_prerender_hydrate
      }
      prewarm runtime-diagnostics
    }
  }

  surface xtend.llm.codeBridge kind content component x-code {
    source selector xtend.llm.codeBridge
    key codeBridge.id
    portal surface.root
    bounds x 0 y 0 width 1 height 1

    lane visible weight 5 {
      hydrate code-bridge from selector xtend.llm.codeBridge {
        hydration mode worker_prerender_hydrate
      }
    }

    lane idle weight 4 {
      prewarm code-bridge
    }
  }
}
