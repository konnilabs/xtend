  datasource xtend.llm.regenerateAssistantMessage from host xtend.llm.regenerateAssistantMessage { method "invoke" }
  datasource xtend.llm.applySnapshot from host xtend.llm.applySnapshot { method "invoke" }
  datasource xtend.llm.newConversation from host xtend.llm.newConversation { method "invoke" }
  datasource xtend.llm.selectConversation from host xtend.llm.selectConversation { method "invoke" }
  datasource xtend.llm.openConversationMenu from host xtend.llm.openConversationMenu { method "invoke" }
  datasource xtend.llm.requestDeleteConversation from host xtend.llm.requestDeleteConversation { method "invoke" }
  datasource xtend.llm.closeDeleteConversation from host xtend.llm.closeDeleteConversation { method "invoke" }
  datasource xtend.llm.confirmDeleteConversation from host xtend.llm.confirmDeleteConversation { method "invoke" }
  datasource xtend.llm.openSettings from host xtend.llm.openSettings { method "invoke" }
  datasource xtend.llm.closeSettings from host xtend.llm.closeSettings { method "invoke" }
  datasource xtend.llm.selectSettingsTab from host xtend.llm.selectSettingsTab { method "invoke" }
  datasource xtend.llm.updateSettingsTheme from host xtend.llm.updateSettingsTheme { method "invoke" }
  datasource xtend.llm.updateSettingsInstructions from host xtend.llm.updateSettingsInstructions { method "invoke" }
  datasource xtend.llm.saveSettings from host xtend.llm.saveSettings { method "invoke" }
  datasource xtend.llm.beginSettingsReset from host xtend.llm.beginSettingsReset { method "invoke" }
  datasource xtend.llm.cancelSettingsReset from host xtend.llm.cancelSettingsReset { method "invoke" }
  datasource xtend.llm.confirmSettingsReset from host xtend.llm.confirmSettingsReset { method "invoke" }
  datasource xtend.llm.routePromptCommand from host xtend.llm.routePromptCommand { method "invoke" }
  datasource xtend.llm.readRuntimeDiagnostics from host xtend.llm.readRuntimeDiagnostics { method "invoke" }

  validation xtend.llm.conversationSearchReady {
    mode blocking
    target action xtend.llm.newConversation
    field xtend.llm.conversationSearch maxLength 256 message "Search is too long."
  }

  action xtend.llm.bootstrap {
    input label string
    effect fetch datasource xtend.llm.bootstrap
    reduce state.xtend.llm.modelStatus = result.modelStatus
    reduce state.xtend.llm.conversationSearch = result.conversationSearch
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.cancel = result.cancel
    reduce state.xtend.llm.retry = result.retry
    reduce state.xtend.llm.progress = result.progress
    reduce state.xtend.llm.spinner = result.spinner
    reduce state.xtend.llm.error = result.error
    reduce state.xtend.llm.deleteConversationDialog = result.deleteConversationDialog
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
    reduce state.xtend.llm.runtimeDiagnostics = result.runtimeDiagnostics
  }

  action xtend.llm.applySnapshot {
    input label string
    effect fetch datasource xtend.llm.applySnapshot
    reduce state.xtend.llm.modelStatus = result.modelStatus
    reduce state.xtend.llm.conversationSearch = result.conversationSearch
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.cancel = result.cancel
    reduce state.xtend.llm.retry = result.retry
    reduce state.xtend.llm.progress = result.progress
    reduce state.xtend.llm.spinner = result.spinner
    reduce state.xtend.llm.error = result.error
    reduce state.xtend.llm.deleteConversationDialog = result.deleteConversationDialog
    reduce state.xtend.llm.settingsDialog = result.settingsDialog
    reduce state.xtend.llm.runtimeDiagnostics = result.runtimeDiagnostics
  }

  action xtend.llm.updatePrompt {
    input value string
    input empty boolean
    effect fetch datasource xtend.llm.updatePrompt
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    reduce state.xtend.llm.send = result.send
  }

  action xtend.llm.routePromptCommand {
    input command string
    input value string
    input empty boolean
    effect fetch datasource xtend.llm.routePromptCommand
    reduce state.xtend.llm.modelStatus = result.modelStatus
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.cancel = result.cancel
    reduce state.xtend.llm.retry = result.retry
    reduce state.xtend.llm.progress = result.progress
    reduce state.xtend.llm.spinner = result.spinner
    reduce state.xtend.llm.error = result.error
  }

  action xtend.llm.updateConversationSearch {
    input value string
    effect fetch datasource xtend.llm.updateConversationSearch
    reduce state.xtend.llm.conversationSearch = result.conversationSearch
    reduce state.xtend.llm.conversationList = result.conversationList
  }

  action xtend.llm.send {
    input label string
    effect fetch datasource xtend.llm.send
    reduce state.xtend.llm.modelStatus = result.modelStatus
    reduce state.xtend.llm.conversationList = result.conversationList
    reduce state.xtend.llm.activeConversation = result.activeConversation
    reduce state.xtend.llm.transcript = result.transcript
    reduce state.xtend.llm.prompt = result.prompt
    reduce state.xtend.llm.toolMenu.disabled = result.prompt.disabled
    recipe "select-choice-menu" target state.xtend.llm.toolMenu value "auto"
    reduce state.xtend.llm.send = result.send
    reduce state.xtend.llm.cancel = result.cancel
    reduce state.xtend.llm.retry = result.retry
    reduce state.xtend.llm.progress = result.progress
    reduce state.xtend.llm.spinner = result.spinner
    reduce state.xtend.llm.error = result.error
  }

