// XTend local LLM product shell.
// RMT owns the UI shell, command routing, state transitions, view templates and host-service effects.

template xtend.llm {
  state xtend.llm.modelStatus type object preserve {
    initial {
      id "model-status"
      text "Qwen3 WebGPU runtime is idle."
      tone "neutral"
      label "Model"
    }
  }

  state xtend.llm.conversationPanel type object preserve {
    initial {
      id "conversation-panel"
      surfaceId "conversation-panel"
      label "Chats"
      open true
      active true
      mode "docked"
      placement "inline"
      resizable true
      collapsible true
      closable "false"
      pinnable "false"
      initialWidth 288
      initialHeight 720
    }
  }

  state xtend.llm.conversationSearch type object preserve {
    initial {
      id "conversation-search"
      field "conversationSearch"
      label "Search chats"
      placeholder "Search chats"
      value ""
      inputType "search"
      command "xtend.llm.updateConversationSearch"
      required false
      hidden false
    }
  }

  state xtend.llm.newConversation type object preserve {
    initial {
      id "new-conversation"
      text "New chat"
      tone "secondary"
      command "xtend.llm.newConversation"
      disabled false
      hidden false
    }
  }

  state xtend.llm.settingsButton type object preserve {
    initial {
      id "settings-button"
      text "Settings"
      tone "secondary"
      iconName "settings"
      iconPack "core"
      ariaLabel "Open settings"
      command "xtend.llm.openSettings"
      disabled false
      hidden false
    }
  }

  state xtend.llm.conversationList type object preserve {
    initial {
      id "conversation-list"
      label "Conversation history"
      empty true
      emptyText "No conversations yet."
      conversations []
      hidden false
      viewTemplate {
        class "xtend-llm-conversation-list"
        children [
          {
            type "when"
            when "$model.xtend.llm.conversationList.empty"
            then {
              type "element"
              tag "p"
              class "xtend-llm-empty"
              text "$model.xtend.llm.conversationList.emptyText"
            }
            else {
              type "repeat"
              source "$model.xtend.llm.conversationList.conversations"
              key "$item.id"
              template {
                type "element"
                tag "div"
                class "xtend-llm-conversation-row"
                attributes {
                  "data-conversation-id" "$item.id"
                  "data-menu-open" "$item.menuOpen"
                }
                children [
                  {
                    type "element"
                    tag "button"
                    class "xtend-llm-conversation-button"
                    attributes {
                      type "button"
                      "aria-current" "$item.active"
                      "data-conversation-id" "$item.id"
                    }
                    command {
                      command "xtend.llm.selectConversation"
                      payload { conversationId "$item.id" }
                    }
                    text "$item.title"
                  }
                  {
                    type "element"
                    tag "button"
                    class "xtend-llm-conversation-more"
                    attributes {
                      type "button"
                      "aria-label" "$item.menuLabel"
                      "aria-expanded" "$item.menuOpen"
                      "data-conversation-id" "$item.id"
                    }
                    command {
                      command "xtend.llm.openConversationMenu"
                      payload { conversationId "$item.id" }
                    }
                    text "..."
                  }
                  {
                    type "element"
                    tag "div"
                    class "xtend-llm-conversation-menu"
                    attributes {
                      role "menu"
                      hidden { op "not" source "$item.menuOpen" }
                    }
                    children [
                      {
                        type "element"
                        tag "button"
                        class "xtend-llm-conversation-menu-item"
                        attributes {
                          type "button"
                          role "menuitem"
                          "data-conversation-id" "$item.id"
                        }
                        command {
                          command "xtend.llm.requestDeleteConversation"
                          payload { conversationId "$item.id" }
                        }
                        text "Delete chat"
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }

  state xtend.llm.activeConversation type object preserve {
    initial {
      id "active-conversation"
      text "Local XTend LLM"
      tone "neutral"
      label "Active chat"
    }
  }

  state xtend.llm.transcript type object preserve {
    initial {
      id "chat-transcript"
      label "Conversation transcript"
      empty true
      emptyText "Start a local WebGPU conversation."
      messages []
      hidden false
      viewTemplate {
        class "xtend-llm-transcript"
        attributes { "aria-live" "polite" }
        children [
          {
            type "when"
            when "$model.xtend.llm.transcript.empty"
            then {
              type "element"
              tag "p"
              class "xtend-llm-empty"
              text "$model.xtend.llm.transcript.emptyText"
            }
            else {
              type "repeat"
              source "$model.xtend.llm.transcript.messages"
              key "$item.id"
              template {
                type "element"
                tag "article"
                class [
                  "xtend-llm-message"
                  "$item.roleClass"
                  { "xtend-llm-message-streaming" "$item.streaming" }
                ]
                attributes {
                  "data-message-id" "$item.id"
                  "data-role" "$item.role"
                }
                children [
                  {
                    type "element"
                    tag "div"
                    class "xtend-llm-message-role"
                    text "$item.roleLabel"
                  }
                  {
                    type "element"
                    tag "div"
                    class "xtend-llm-message-body"
                    children [
                      {
                        type "rich-text"
                        source "$item.segments"
                      }
                    ]
                  }
                  {
                    type "when"
                    when "$item.hasActions"
                    then {
                      type "element"
                      tag "div"
                      class "xtend-llm-message-actions"
                      attributes {
                        id "$item.actionRowId"
                        "aria-label" "Message actions"
                      }
                      children [
                        {
                          type "element"
                          tag "button"
                          class "xtend-llm-message-action xtend-llm-message-action-copy"
                          attributes {
                            type "button"
                            title "$item.copyAction.label"
                            "aria-label" "$item.copyAction.label"
                            "aria-disabled" "$item.copyAction.disabled"
                            disabled "$item.copyAction.disabled"
                            "data-action" "$item.copyAction.action"
                            "data-message-id" "$item.copyAction.messageId"
                          }
                          command {
                            command "xtend.llm.copyAssistantMessage"
                            payload {
                              action "$item.copyAction.action"
                              conversationId "$item.copyAction.conversationId"
                              messageId "$item.copyAction.messageId"
                            }
                          }
                          children [
                            {
                              type "element"
                              tag "x-icon"
                              attributes {
                                name "$item.copyAction.icon"
                                pack "$item.copyAction.iconPack"
                                decorative true
                                size "1rem"
                              }
                            }
                          ]
                        }
                        {
                          type "element"
                          tag "button"
                          class [
                            "xtend-llm-message-action"
                            "xtend-llm-message-action-regenerate"
                            { "xtend-llm-message-action-busy" "$item.regenerateAction.busy" }
                          ]
                          attributes {
                            type "button"
                            title "$item.regenerateAction.label"
                            "aria-label" "$item.regenerateAction.label"
                            "aria-busy" "$item.regenerateAction.busy"
                            "aria-disabled" "$item.regenerateAction.disabled"
                            disabled "$item.regenerateAction.disabled"
                            "data-action" "$item.regenerateAction.action"
                            "data-message-id" "$item.regenerateAction.messageId"
                          }
                          command {
                            command "xtend.llm.regenerateAssistantMessage"
                            payload {
                              action "$item.regenerateAction.action"
                              conversationId "$item.regenerateAction.conversationId"
                              messageId "$item.regenerateAction.messageId"
                            }
                          }
                          children [
                            {
                              type "element"
                              tag "x-icon"
                              attributes {
                                name "$item.regenerateAction.icon"
                                pack "$item.regenerateAction.iconPack"
                                decorative true
                                size "1rem"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }

  state xtend.llm.prompt type object preserve {
    initial {
      id "prompt-input"
      field "prompt"
      label "Message"
      placeholder "Ask Qwen3 something..."
      value ""
      rows 4
      command "xtend.llm.updatePrompt"
      submitCommand "xtend.llm.send"
      submitOnEnter true
      required false
      disabled false
      hidden false
    }
  }

  state xtend.llm.toolMenu type object preserve {
    initial {
      id "tool-menu"
      label "Tool"
      text "Tool"
      open false
      activeTool "auto"
      activeToolLabel "Use tool"
      activeToolAttr ""
      disabled false
      hidden false
      items [
        {
          value "auto"
          label "Auto"
          triggerLabel "Use tool"
          activeAttr ""
        }
        {
          value "web_search"
          label "Web search"
          triggerLabel "Web search"
          activeAttr "web_search"
        }
        {
          value "rmt_knowledge"
          label "RMT knowledge"
          triggerLabel "RMT knowledge"
          activeAttr "rmt_knowledge"
        }
      ]
      viewTemplate {
        type "choice-menu"
        source "$model.xtend.llm.toolMenu"
        buttonId "tool-menu-button"
        buttonClass "xtend-llm-tool-menu-button"
        optionsId "tool-menu-options"
        optionsClass "xtend-llm-tool-menu-options"
        itemClass "xtend-llm-tool-menu-item"
        toggleCommand "xtend.llm.toggleToolMenu"
        selectCommand "xtend.llm.selectTool"
        selectPayloadField "toolName"
        label "Tool"
      }
    }
  }

  state xtend.llm.send type object preserve {
    initial {
      id "send-message"
      text "Send"
      tone "primary"
      command "xtend.llm.send"
      disabled true
      hidden false
    }
  }

  state xtend.llm.cancel type object preserve {
    initial {
      id "cancel-generation"
      text "Cancel"
      tone "secondary"
      command "xtend.llm.cancelGeneration"
      disabled false
      hidden true
    }
  }

  state xtend.llm.retry type object preserve {
    initial {
      id "retry-generation"
      text "Retry"
      tone "secondary"
      command "xtend.llm.retryGeneration"
      disabled false
      hidden true
    }
  }

  state xtend.llm.progress type object preserve {
    initial {
      id "generation-progress"
      label "Generation"
      status "Waiting"
      value 0
      max 100
      indeterminate true
      busy false
      hidden true
    }
  }

  state xtend.llm.spinner type object preserve {
    initial {
      id "generation-spinner"
      size "small"
      type "ring"
      paused true
      ariaLabel "Generation idle"
      ariaBusy false
      hidden true
    }
  }

  state xtend.llm.error type object preserve {
    initial {
      id "runtime-error"
      text "No runtime error."
      tone "error"
      label "Runtime"
      hidden true
    }
  }

  state xtend.llm.deleteConversationDialog type object preserve {
    initial {
      id "delete-conversation-dialog"
      title "Delete chat?"
      overlay true
      open false
      width "min(92vw, 420px)"
      height "auto"
      message "Delete this chat?"
      hidden false
      viewTemplate {
        children [
          {
            type "element"
            tag "p"
            class "xtend-llm-dialog-copy"
            attributes { id "delete-conversation-message" }
            text "$model.xtend.llm.deleteConversationDialog.message"
          }
          {
            type "element"
            tag "div"
            class "xtend-llm-settings-footer"
            children [
              {
                type "element"
                tag "button"
                class "xtend-llm-dialog-button"
                attributes {
                  id "delete-conversation-cancel"
                  type "button"
                }
                command { command "xtend.llm.closeDeleteConversation" payload { label "Cancel" } }
                text "Cancel"
              }
              {
                type "element"
                tag "button"
                class "xtend-llm-dialog-button xtend-llm-dialog-danger"
                attributes {
                  id "delete-conversation-confirm"
                  type "button"
                }
                command { command "xtend.llm.confirmDeleteConversation" payload { label "Delete chat" } }
                text "Delete"
              }
            ]
          }
        ]
      }
    }
  }

  state xtend.llm.settingsDialog type object preserve {
    initial {
      id "settings-dialog"
      title "Settings"
      overlay true
      open false
      width "min(90vw, 960px)"
      height "auto"
      selected 0
      themeMode "automatic"
      draftThemeMode "automatic"
      customInstructions ""
      dirty false
      resetConfirm false
      hidden false
      viewTemplate {
        children [
          {
            type "component"
            tag "x-tabs"
            component "x-tabs"
            class "xtend-llm-settings-tabs"
            attributes {
              id "settings-tabs"
              label "Settings"
              selected "$model.xtend.llm.settingsDialog.selected"
              orientation "vertical"
            }
            command {
              command "xtend.llm.selectSettingsTab"
              event "tab-selected"
              payload { selected "$detail.index" }
            }
            children [
              {
                type "element"
                tag "x-tab"
                attributes { label "Appearance" }
                children [
                  {
                    type "element"
                    tag "section"
                    class "xtend-llm-settings-section"
                    children [
                      {
                        type "element"
                        tag "p"
                        class "xtend-llm-settings-copy"
                        text "Choose how the local chat shell should be displayed."
                      }
                      {
                        type "element"
                        tag "div"
                        class "xtend-llm-theme-options"
                        children [
                          {
                            type "element"
                            tag "button"
                            class "xtend-llm-theme-option"
                            attributes {
                              type "button"
                              "data-theme-mode" "light"
                              "aria-pressed" { op "equals" left "$model.xtend.llm.settingsDialog.draftThemeMode" right "light" }
                            }
                            command { command "xtend.llm.updateSettingsTheme" payload { mode "light" } }
                            text "Light"
                          }
                          {
                            type "element"
                            tag "button"
                            class "xtend-llm-theme-option"
                            attributes {
                              type "button"
                              "data-theme-mode" "dark"
                              "aria-pressed" { op "equals" left "$model.xtend.llm.settingsDialog.draftThemeMode" right "dark" }
                            }
                            command { command "xtend.llm.updateSettingsTheme" payload { mode "dark" } }
                            text "Dark"
                          }
                          {
                            type "element"
                            tag "button"
                            class "xtend-llm-theme-option"
                            attributes {
                              type "button"
                              "data-theme-mode" "automatic"
                              "aria-pressed" { op "equals" left "$model.xtend.llm.settingsDialog.draftThemeMode" right "automatic" }
                            }
                            command { command "xtend.llm.updateSettingsTheme" payload { mode "automatic" } }
                            text "Automatic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
              {
                type "element"
                tag "x-tab"
                attributes {
                  label "$model.xtend.llm.settingsDialog.instructionsTabLabel"
                  disabled "$model.xtend.llm.settingsDialog.instructionsBusy"
                  "aria-disabled" "$model.xtend.llm.settingsDialog.instructionsBusy"
                }
                children [
                  {
                    type "element"
                    tag "section"
                    class "xtend-llm-settings-section"
                    children [
                      {
                        type "element"
                        tag "p"
                        class "xtend-llm-settings-copy"
                        text "Custom instructions are sent with each local model request."
                      }
                      {
                        type "element"
                        tag "textarea"
                        class "xtend-llm-instructions-input"
                        attributes {
                          id "settings-custom-instructions"
                          rows "7"
                        }
                        properties {
                          value "$model.xtend.llm.settingsDialog.customInstructions"
                        }
                        command {
                          command "xtend.llm.updateSettingsInstructions"
                          event "input"
                          payload { value "$target.value" }
                        }
                      }
                      {
                        type "element"
                        tag "button"
                        class "xtend-llm-settings-action"
                        attributes {
                          id "settings-reset"
                          type "button"
                        }
                        command { command "xtend.llm.beginSettingsReset" payload { label "Reset" } }
                        text "Reset"
                      }
                      {
                        type "element"
                        tag "div"
                        class "xtend-llm-reset-confirmation"
                        attributes {
                          id "settings-reset-confirmation"
                          hidden { op "not" source "$model.xtend.llm.settingsDialog.resetConfirm" }
                        }
                        children [
                          {
                            type "element"
                            tag "p"
                            class "xtend-llm-settings-copy"
                            text "Reset settings to defaults?"
                          }
                          {
                            type "element"
                            tag "button"
                            class "xtend-llm-settings-action"
                            attributes { id "settings-reset-cancel" type "button" }
                            command { command "xtend.llm.cancelSettingsReset" payload { label "Keep" } }
                            text "Keep"
                          }
                          {
                            type "element"
                            tag "button"
                            class "xtend-llm-settings-action"
                            attributes { id "settings-reset-confirm" type "button" }
                            command { command "xtend.llm.confirmSettingsReset" payload { label "Reset settings" } }
                            text "Reset settings"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
              {
                type "element"
                tag "x-tab"
                attributes { label "Runtime" }
                children [
                  {
                    type "element"
                    tag "section"
                    class "xtend-llm-settings-section"
                    children [
                      {
                        type "element"
                        tag "p"
                        class "xtend-llm-settings-copy"
                        text "Qwen3 runs locally through the XTend WebGPU worker bridge."
                      }
                      {
                        type "element"
                        tag "div"
                        class "xtend-llm-runtime-diagnostics"
                        attributes {
                          id "runtime-diagnostics-panel"
                          "data-backpressure" "$model.xtend.llm.runtimeDiagnostics.backpressureLevel"
                        }
                        children [
                          {
                            type "element"
                            tag "div"
                            class "xtend-llm-runtime-diagnostics-header"
                            children [
                              {
                                type "element"
                                tag "strong"
                                class "xtend-llm-runtime-diagnostics-title"
                                text "$model.xtend.llm.runtimeDiagnostics.status"
                              }
                              {
                                type "element"
                                tag "button"
                                class "xtend-llm-settings-action xtend-llm-runtime-refresh"
                                attributes {
                                  id "runtime-diagnostics-refresh"
                                  type "button"
                                }
                                command { command "xtend.llm.readRuntimeDiagnostics" payload { label "Refresh runtime" } }
                                text "Refresh"
                              }
                            ]
                          }
                          {
                            type "element"
                            tag "dl"
                            class "xtend-llm-runtime-diagnostics-list"
                            children [
                              {
                                type "element"
                                tag "div"
                                class "xtend-llm-runtime-diagnostics-row"
                                children [
                                  { type "element" tag "dt" text "Capabilities" }
                                  { type "element" tag "dd" text "$model.xtend.llm.runtimeDiagnostics.capabilitySummary" }
                                ]
                              }
                              {
                                type "element"
                                tag "div"
                                class "xtend-llm-runtime-diagnostics-row"
                                children [
                                  { type "element" tag "dt" text "Bundle" }
                                  { type "element" tag "dd" text "$model.xtend.llm.runtimeDiagnostics.closureSummary" }
                                ]
                              }
                              {
                                type "element"
                                tag "div"
                                class "xtend-llm-runtime-diagnostics-row"
                                children [
                                  { type "element" tag "dt" text "Worker" }
                                  { type "element" tag "dd" text "$model.xtend.llm.runtimeDiagnostics.workerSummary" }
                                ]
                              }
                              {
                                type "element"
                                tag "div"
                                class "xtend-llm-runtime-diagnostics-row"
                                children [
                                  { type "element" tag "dt" text "Backpressure" }
                                  { type "element" tag "dd" text "$model.xtend.llm.runtimeDiagnostics.streamSummary" }
                                ]
                              }
                              {
                                type "element"
                                tag "div"
                                class "xtend-llm-runtime-diagnostics-row"
                                children [
                                  { type "element" tag "dt" text "Recovery" }
                                  { type "element" tag "dd" text "$model.xtend.llm.runtimeDiagnostics.panicSummary" }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
          {
            type "element"
            tag "div"
            class "xtend-llm-settings-footer"
            children [
              {
                type "element"
                tag "button"
                class "xtend-llm-dialog-button"
                attributes {
                  id "settings-cancel"
                  type "button"
                }
                command { command "xtend.llm.closeSettings" payload { label "Cancel" } }
                text "Cancel"
              }
              {
                type "element"
                tag "button"
                class "xtend-llm-dialog-button"
                attributes {
                  id "settings-save"
                  type "button"
                  disabled { op "not" source "$model.xtend.llm.settingsDialog.dirty" }
                }
                command { command "xtend.llm.saveSettings" payload { label "Save" } }
                text "Save"
              }
            ]
          }
        ]
      }
    }
  }

  state xtend.llm.runtimeDiagnostics type object preserve {
    initial {
      id "runtime-diagnostics"
      label "Runtime diagnostics"
      status "Runtime telemetry pending"
      ok true
      backpressureLevel "normal"
      prewarmWorkerStatus "unknown"
      strictFallbackCount 0
      capabilitySummary "RKFA capabilities pending."
      closureSummary "Production closure pending."
      workerSummary "Worker telemetry pending."
      streamSummary "No stream pressure records."
      panicSummary "No panic or recovery records."
      hidden true
    }
  }

  state xtend.llm.codeBridge type object preserve {
    initial {
      id "code-bridge"
      label "Code block hydration bridge"
      lang "text"
      hidden false
    }
  }

  selector xtend.llm.modelStatus from state xtend.llm.modelStatus { output XtendLlmStatus }
  selector xtend.llm.conversationPanel from state xtend.llm.conversationPanel { output XtendLlmPanel }
  selector xtend.llm.conversationSearch from state xtend.llm.conversationSearch { output XtendLlmSearch }
  selector xtend.llm.newConversation from state xtend.llm.newConversation { output XtendLlmCommand }
  selector xtend.llm.settingsButton from state xtend.llm.settingsButton { output XtendLlmCommand }
  selector xtend.llm.conversationList from state xtend.llm.conversationList { output XtendLlmList }
  selector xtend.llm.activeConversation from state xtend.llm.activeConversation { output XtendLlmStatus }
  selector xtend.llm.transcript from state xtend.llm.transcript { output XtendLlmTranscript }
  selector xtend.llm.prompt from state xtend.llm.prompt { output XtendLlmPrompt }
  selector xtend.llm.toolMenu from state xtend.llm.toolMenu { output XtendLlmMenu }
  selector xtend.llm.send from state xtend.llm.send { output XtendLlmCommand }
  selector xtend.llm.cancel from state xtend.llm.cancel { output XtendLlmCommand }
  selector xtend.llm.retry from state xtend.llm.retry { output XtendLlmCommand }
  selector xtend.llm.progress from state xtend.llm.progress { output XtendLlmProgress }
  selector xtend.llm.spinner from state xtend.llm.spinner { output XtendLlmSpinner }
  selector xtend.llm.error from state xtend.llm.error { output XtendLlmStatus }
  selector xtend.llm.deleteConversationDialog from state xtend.llm.deleteConversationDialog { output XtendLlmDialog }
  selector xtend.llm.settingsDialog from state xtend.llm.settingsDialog { output XtendLlmDialog }
  selector xtend.llm.runtimeDiagnostics from state xtend.llm.runtimeDiagnostics { output XtendLlmRuntimeDiagnostics }
  selector xtend.llm.codeBridge from state xtend.llm.codeBridge { output XtendLlmCodeBridge }

  datasource xtend.llm.bootstrap from host xtend.llm.bootstrap { method "invoke" }
  datasource xtend.llm.updatePrompt from host xtend.llm.updatePrompt { method "invoke" }
  datasource xtend.llm.updateConversationSearch from host xtend.llm.updateConversationSearch { method "invoke" }
  datasource xtend.llm.send from host xtend.llm.send { method "invoke" }
  datasource xtend.llm.cancelGeneration from host xtend.llm.cancelGeneration { method "invoke" }
  datasource xtend.llm.retryGeneration from host xtend.llm.retryGeneration { method "invoke" }
