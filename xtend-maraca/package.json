{
  "name": "@ccslabs/xtend-maraca",
  "version": "0.3.1",
  "private": false,
  "description": "XTend Maraca modern ESM build and bundle planner for RMT-first applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konnilabs/xtend.git",
    "directory": "xtend-maraca"
  },
  "keywords": [
    "ccslabs",
    "xtend",
    "maraca",
    "rmt",
    "bundler"
  ],
  "main": "./index.js",
