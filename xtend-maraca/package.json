{
  "name": "@ccslabs/xtend-maraca",
  "version": "0.5.0",
  "private": false,
  "description": "XTend Maraca ESM build and bundle planner for RMT-first 0.5.0 apps, XScaler and XSurface Shard.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konnilabs/xtend.git",
    "directory": "xtend-maraca"
  },
  "keywords": [
    "ccslabs",
    "xtend",
    "maraca",
    "rmt",
    "bundler"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./plan-runtime": {
      "types": "./plan-runtime.d.ts",
      "default": "./plan-runtime.mjs"
    },
    "./css-provider": {
      "types": "./css-provider.d.ts",
      "default": "./css-provider.js"
    },
    "./app-services": {
      "types": "./app-services.d.ts",
      "browser": "./app-services.mjs",
      "import": "./app-services.mjs",
      "require": "./app-services.js",
      "default": "./app-services.mjs"
    },
    "./server-services": {
      "types": "./server-services.d.ts",
      "import": "./server-services.mjs",
      "require": "./server-services.js",
      "default": "./server-services.mjs"
    },
    "./node-app-service-host": {
      "types": "./node-app-service-host.d.ts",
      "import": "./node-app-service-host.mjs",
      "require": "./node-app-service-host.js",
      "default": "./node-app-service-host.mjs"
    },
    "./service-build-provider": {
      "types": "./service-build-provider.d.ts",
      "default": "./service-build-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "runtime.js",
    "runtime.d.ts",
    "plan-runtime.mjs",
    "plan-runtime.d.ts",
    "css-provider.js",
    "css-provider.d.ts",
    "app-services.js",
    "app-services.mjs",
    "app-services.d.ts",
    "server-services.js",
    "server-services.mjs",
    "server-services.d.ts",
    "node-app-service-host.js",
    "node-app-service-host.mjs",
    "node-app-service-host.d.ts",
    "service-build-provider.js",
    "service-build-provider.d.ts",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "rollup": "^4.60.4",
    "terser": "^5.48.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@ccslabs/xtend": "0.5.0",
    "@ccslabs/xtend-compiler": "0.5.0"
  },
  "peerDependenciesMeta": {
    "@ccslabs/xtend": {
      "optional": true
    },
    "@ccslabs/xtend-compiler": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  }
}
