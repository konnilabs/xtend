{
  "servers": {
    "xtend": {
      "type": "stdio",
      "command": "${execPath}",
      "cwd": "${workspaceFolder}",
      "env": {
        "ELECTRON_RUN_AS_NODE": "1"
      },
      "args": [
        "${workspaceFolder}/products/xtend-mcp/bin/xtend-mcp.mjs",
        "stdio",
        "--workspace",
        "${workspaceFolder}"
      ]
    }
  }
}
