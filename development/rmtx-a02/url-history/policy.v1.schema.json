{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xtend.xtensions.url-state-policy.v1",
  "title": "xtend.xtensions.url-state-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "documentId",
    "exposure",
    "fields",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "xtend.xtensions.url-state-policy.v1"
    },
    "id": {
      "$ref": "#/definitions/name"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "documentId": {
      "$ref": "#/definitions/name"
    },
    "exposure": {
      "const": "public-url"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface",
          "prop",
          "default"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/field"
          },
          "surface": {
            "$ref": "#/definitions/name"
          },
          "prop": {
            "$ref": "#/definitions/name"
          },
          "default": {
            "$ref": "#/definitions/scalar"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenBytes",
        "entries",
        "valueBytes",
        "instances"
      ],
      "properties": {
        "tokenBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "valueBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarationId",
        "keys"
      ],
      "properties": {
        "declarationId": {
          "$ref": "#/definitions/name"
        },
        "keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/key"
          }
        }
      }
    }
  }
}
