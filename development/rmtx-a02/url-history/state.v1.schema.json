{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xtend.xtensions.url-state.v1",
  "title": "xtend.xtensions.url-state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "policyId",
    "policyVersion",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "xtend.xtensions.url-state.v1"
    },
    "documentId": {
      "$ref": "#/definitions/name"
    },
    "policyId": {
      "$ref": "#/definitions/name"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declarationId",
          "keys",
          "values"
        ],
        "properties": {
          "declarationId": {
            "$ref": "#/definitions/name"
          },
          "keys": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "$ref": "#/definitions/key"
            }
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "propertyNames": {
              "$ref": "#/definitions/field"
            },
            "additionalProperties": {
              "$ref": "#/definitions/scalar"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarationId",
        "keys"
      ],
      "properties": {
        "declarationId": {
          "$ref": "#/definitions/name"
        },
        "keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/key"
          }
        }
      }
    }
  }
}
