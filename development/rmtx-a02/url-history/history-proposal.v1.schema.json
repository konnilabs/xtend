{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xtend.xtensions.url-history-proposal.v1",
  "title": "xtend.xtensions.url-history-proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "documentId",
    "policyId",
    "policyVersion",
    "navigationId",
    "parameter",
    "mode",
    "cause",
    "token"
  ],
  "properties": {
    "schema": {
      "const": "xtend.xtensions.url-history-proposal.v1"
    },
    "documentId": {
      "$ref": "#/definitions/name"
    },
    "policyId": {
      "$ref": "#/definitions/name"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "navigationId": {
      "$ref": "#/definitions/name"
    },
    "parameter": {
      "const": "xtend-state"
    },
    "mode": {
      "enum": [
        "none",
        "replace",
        "push"
      ]
    },
    "cause": {
      "enum": [
        "initialize",
        "commit",
        "checkpoint",
        "traverse",
        "reset"
      ]
    },
    "token": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^1\\.[A-Za-z0-9_-]+$"
        }
      ]
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarationId",
        "keys"
      ],
      "properties": {
        "declarationId": {
          "$ref": "#/definitions/name"
        },
        "keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/key"
          }
        }
      }
    }
  }
}
