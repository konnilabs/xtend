import { RMT, model, input, item, selectors } from '@ccslabs/xtend/rmt-language/rmtx';

// Closed source4 orchestration. Provider code and interfaces are externally pinned.
export default <RMT.Program id="inline.products">
  <RMT.State id="catalog" type="object" preserve initial={{ items: [
    { id: 'g', products: [
      { id: 1, slug: 'numeric', images: ['front', 'back'], selectedImageId: 'front', reviewsSort: 'recent', enabled: true },
      { id: '1', slug: 'text', images: ['front', 'back'], selectedImageId: 'front', reviewsSort: 'recent', enabled: true }
    ] },
    { id: 'h', products: [
      { id: 1, slug: 'other-parent', images: ['front', 'back'], selectedImageId: 'front', reviewsSort: 'recent', enabled: true }
    ] }
  ] }} />
  <RMT.State id="sharedImages" type="string[]" initial={["front", "back"]} />
  <RMT.Selector id="galleryImages" from={model.sharedImages}><RMT.Where test={item === "front" || item === "back"} /></RMT.Selector>
  <RMT.State id="intentCapture" type="object" initial={{ groupId: null, productId: null, value: '', kind: '' }} />
  <RMT.State id="nativeFlags" type="object" initial={{allow:false}} />
  <RMT.Action id="native.enable">
    <RMT.Input name="allow" type="boolean" optional={true} default={true} />
    <RMT.Reduce state="nativeFlags" value={{allow:input.allow}} />
  </RMT.Action>
  <RMT.Action id="image.select">
    <RMT.Input name="groupId" type="json" /><RMT.Input name="productId" type="json" /><RMT.Input name="imageId" type="string" />
    <RMT.Reduce state="intentCapture" path="groupId" value={input.groupId} />
    <RMT.Reduce state="intentCapture" path="productId" value={input.productId} />
    <RMT.Reduce state="intentCapture" path="value" value={input.imageId} />
    <RMT.Reduce state="intentCapture" path="kind" value="image" />
  </RMT.Action>
  <RMT.Action id="reviews.sort">
    <RMT.Input name="groupId" type="json" /><RMT.Input name="productId" type="json" /><RMT.Input name="sort" type="string" />
    <RMT.Reduce state="intentCapture" path="groupId" value={input.groupId} />
    <RMT.Reduce state="intentCapture" path="productId" value={input.productId} />
    <RMT.Reduce state="intentCapture" path="value" value={input.sort} />
    <RMT.Reduce state="intentCapture" path="kind" value="reviews" />
  </RMT.Action>
  <RMT.Action id="catalog.replace">
    <RMT.Input name="catalog" type="object" /><RMT.Reduce state="catalog" value={input.catalog} />
  </RMT.Action>
  <RMT.Portal id="surface.root" root="#xtend-maraca-root" layer="surface" />
  <RMT.Surface id="product-details" kind="region" component="section" portal="surface.root">
    <RMT.Lane name="visible"><RMT.Mount target="product-header" /></RMT.Lane>
    <RMT.On event="native-select" action="image.select" preventDefault={true}
      payload={{groupId:'detail.group',productId:'detail.product',imageId:'detail.image'}} when={model.nativeFlags.allow === true} />
  </RMT.Surface>
  <RMT.Repeat from={model.catalog.items} keyBy={item.id}>
    <RMT.Repeat from={item.products} keyBy={item.id}>
      <RMT.Surface id="product-gallery-host" kind="region" component="div" portal="surface.root" present={item.enabled}>
        <RMT.XTension id="product-gallery" provider="react-product-gallery" owner="product-details" lane="visible"
          props={{ images: selectors.galleryImages, selectedImageId: item.enabled === true ? item.selectedImageId : 'front', context: { displayId: item.slug, flags: [item.enabled, true] } }}
          intents={{ selectImage: { action: 'image.select', payload: { imageId: 'imageId' }, keys: { groupId: 0, productId: 1 } } }} />
      </RMT.Surface>
      <RMT.Surface id="product-reviews-host" kind="region" component="div" portal="surface.root" present={item.enabled}>
        <RMT.XTension id="product-reviews" provider="vue-product-reviews" owner="product-details" lane="idle"
          props={{ productId: item.slug, sort: item.reviewsSort }}
          intents={{ changeSort: { action: 'reviews.sort', payload: { sort: 'order' }, keys: { groupId: 0, productId: 1 } } }} />
      </RMT.Surface>
    </RMT.Repeat>
  </RMT.Repeat>
</RMT.Program>;
