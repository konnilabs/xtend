  "policies": [
    {
      "id": "authority",
      "rules": {
        "ownerChain": [
          "model",
          "kernel",
          "fabric",
          "surface"
        ],
        "parallelController": false,
        "restoreBeforeAdoption": true,
        "adoptionBeforeProviderReplay": true
      },
      "positiveCases": [
        "kernel-fabric-admission",
        "ssr-restore-adopt-replay"
      ],
      "negativeCases": [
        "csr-invalid-boundary",
        "ssr-identity-mismatch"
      ]
    },
    {
      "id": "lanes",
      "rules": {
        "names": [
          "user-blocking",
          "visible",
          "transition",
          "idle",
          "background",
          "diagnostics"
        ],
        "source6Mount": [
          "visible"
        ],
        "source7And8Mount": "all-six",
        "meaning": "kernel-priority",
        "strategy": "separate",
        "viewportActivation": false,
        "noAdmission": "remain-unmounted"
      },
      "positiveCases": [
        "lane-forwarding"
      ],
      "negativeCases": [
        "lane-invalid-retained-source6",
        "no-admission-no-load"
      ]
    },
    {
      "id": "loading",
      "rules": {
        "provider": "on-admitted-mount",
        "chain": [
          "kernel",
          "fabric",
          "provider",
          "peers",
          "synchronous-factory",
          "root"
        ],
        "peerProfiles": "retain-versioned-contracts",
        "cancellation": "revoke-continuations-not-esm-transport",
        "timeout": "explicit-timeoutMs-only",
        "retry": "new-authorized-attempt-only",
        "declarativeErrorTimeoutRetryUI": false,
        "providerInternalCsrUI": true
      },
      "positiveCases": [
        "kernel-fabric-admission",
        "shared-import-cancel",
        "explicit-retry"
      ],
      "negativeCases": [
        "no-admission-no-load",
        "timeout-no-retry-ui",
        "ssr-cancel-no-late-work"
      ]
    },
    {
      "id": "ssr",
      "rules": {
        "server": "node",
        "frameworks": [
          "react",
          "vue"
        ],
        "render": "synchronous-precompiled",
        "streaming": false,
        "nativeView": "light-dom-and-stable-managed-host-shells",
        "managedInternals": "client-owned",
        "replay": "declared-provider-intents-only",
        "projectIdentity": "source-and-composition-and-project",
        "newHandoff": "new-explicit-contract-version",
        "legacyWire": "retain-unmodified"
      },
      "positiveCases": [
        "ssr-native-react-vue",
        "ssr-typed-nested-keys",
        "ssr-intent-dedupe",
        "classic-compatibility"
      ],
      "negativeCases": [
        "ssr-async-streaming-denied",
        "ssr-old-wire-not-upgraded",
        "native-event-replay-denied",
        "native-shadow-ssr-denied"
      ]
    },
    {
      "id": "fallback",
      "rules": {
        "default": "reject",
        "optIn": "mount",
        "allowedMismatch": "framework-subtree-only",
        "requires": [
          "valid-signed-unexpired-snapshot",
          "exact-source-project-state-provider-interface-artifact-pins",
          "current-owner-generation",
          "unchanged-shell-exclusive-container"
        ],
        "replacementReport": "fallback-mounted",
        "replacementPreservesDomIdentity": false
      },
      "positiveCases": [
        "ssr-limited-mount-fallback"
      ],
      "negativeCases": [
        "ssr-invalid-signature-expiry",
        "ssr-identity-mismatch",
        "ssr-shell-container-tamper",
        "ssr-adoption-error-no-fallback"
      ]
    },
    {
      "id": "layout",
      "rules": {
        "owner": "author-container-and-styles",
        "platformClsGuarantee": false,
        "implicitReservation": false,
        "byteBudgetsAreLayoutBudgets": false
      },
      "positiveCases": [
        "author-owned-layout"
      ],
      "negativeCases": [
        "no-implicit-layout-guarantee"
      ]
    },
    {
      "id": "provider-boundary",
      "rules": {
        "schemaOwner": "provider",
        "liveIntentValidation": "each-intent-before-model-command",
        "replayValidation": "whole-batch-before-first-model-command",
        "crossOwnership": false,
        "localUiState": "provider-local-under-host-lifetime",
        "controlledModelStateAuthority": "model",
        "deepLinkedState": "xtend-state",
        "slots": "declared-owned-slots-only",
        "automaticDeploymentMigration": false
      },
      "positiveCases": [
        "provider-schema-authority",
        "ssr-intent-dedupe"
      ],
      "negativeCases": [
        "csr-invalid-boundary",
        "ssr-invalid-replay-batch",
        "cross-owner-slot-denied",
        "deployment-migration-denied"
      ]
    }
  ],
