import { RMT, model, item } from '@ccslabs/xtend/rmt-language/rmtx';
export default <RMT.Program id="release.ssr">
  <RMT.Import path="./shared.rmt" />
  <RMT.Repeat from={model.catalog.items} keyBy={item.id}>
    <RMT.Surface id="product" component="article" present={item.enabled}>
      <RMT.Lane name="visible">
        <RMT.Mount target="product" when={model.ui.mount} />
        <RMT.Hydrate target="product" when={model.ui.hydrate} />
      </RMT.Lane>
      <RMT.View>
        <RMT.Component tag="x-header" ref="heading" properties={{ title: item.title }}>
          <RMT.Slot name="title"><RMT.Element tag="h2"><RMT.Text value={item.title} /></RMT.Element></RMT.Slot>
        </RMT.Component>
        <RMT.Component tag="x-button" ref="trigger" attributes={{ label: 'Capture native' }}>
          <RMT.On event="button-interaction" action="native.select" payload={{}} keys={{ productId: 0 }} />
        </RMT.Component>
        <RMT.Element tag="output" attributes={{ 'data-native-title': 'true' }}><RMT.Text value={item.title} /></RMT.Element>
      </RMT.View>
      <RMT.Surface id="gallery" component="div">
        <RMT.XTension id="product-gallery" provider="react-product-gallery" owner="product" lane="visible"
          props={{ images: item.images, selectedImageId: item.selectedImageId, context: { displayId: item.title, flags: [item.enabled, true] } }}
          intents={{ selectImage: { action: 'image.select', payload: { imageId: 'imageId' }, keys: { productId: 0 } } }} />
      </RMT.Surface>
      <RMT.Surface id="reviews" component="div">
        <RMT.XTension id="product-reviews" provider="vue-product-reviews" owner="product" lane="idle"
          props={{ productId: item.title, sort: item.sort }}
          intents={{ changeSort: { action: 'reviews.sort', payload: { sort: 'order' }, keys: { productId: 0 } } }} />
      </RMT.Surface>
    </RMT.Surface>
  </RMT.Repeat>
</RMT.Program>;
