      "findingId": "navigation-api",
      "outcome": "corrected-candidate",
      "facts": [
        "Navigation API is an Interop 2025 carry-over in Interop 2026, not a first-time 2026 focus.",
        "The API reached Baseline Newly Available in 2026.",
        "x-router owns navigation cancellation, focus, announcements and scroll restoration."
      ],
      "xtendHypotheses": [
        "A capability-gated host adapter may map native navigate events onto existing x-router lifecycle contracts."
      ],
      "sources": [
        { "id": "mozilla-interop-2026", "url": "https://hacks.mozilla.org/2026/02/launching-interop-2026/", "kind": "standards-program" },
