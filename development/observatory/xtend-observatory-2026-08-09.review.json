      "findingId": "scoped-custom-element-registries",
      "outcome": "new-radar-candidate",
      "facts": [
        "Scoped Custom Element Registries are a real Interop 2026 focus.",
        "Chromium ships the feature and Firefox exposes experimental support behind a preference.",
        "XTend components predominantly self-register in the global customElements registry."
      ],
      "xtendHypotheses": [
        "Registry injection in the RMT component adapter and Surface hosts may enable isolated tag namespaces.",
        "Constructor exports and side-effect-free registration are prerequisites for broad scope support."
      ],
      "sources": [
        { "id": "chrome-scoped-registries", "url": "https://developer.chrome.com/blog/scoped-registries", "kind": "engine-docs" },
        { "id": "firefox-experimental-features", "url": "https://developer.mozilla.org/en-US/docs/Mozilla/Firefox/Experimental_features", "kind": "engine-docs" }
      ],
      "browserEvidence": [
        { "engine": "Chromium", "version": "146", "status": "shipping", "sourceRef": "chrome-scoped-registries" },
        { "engine": "Firefox", "version": "experimental", "status": "behind-flag", "sourceRef": "firefox-experimental-features" },
        { "engine": "WebKit", "version": "26", "status": "insufficient-evidence", "sourceRef": null }
      ],
