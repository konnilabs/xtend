template surfaces.page {
  surface root kind root component x-surface-region {
    lane critical weight 100 {
      mount app-shell
      hydrate app-shell
    }
  }

  surface modal.settings kind modal component x-modal {
    lane critical {
      mount settings-card
    }
  }

  surface panel.tools kind panel component x-side-panel {
    lane normal {
      hydrate tool-panel
    }
  }

  surface overlay.toast kind toast component x-toast {
    lane idle {
      prewarm toast-feed
    }
  }

  surface workspace.editor kind workspace component x-surface-region {
    lane transition {
      invalidate editor-frame
    }
  }

  surface portal.help kind overlay-host component x-surface-portal {
    lane background {
      hydrate help-center
    }
  }
}
