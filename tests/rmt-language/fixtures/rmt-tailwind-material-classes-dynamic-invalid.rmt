template material.inventory.dynamicInvalid {
  state material.inventory.dynamic type object preserve {
    initial {
      id "dynamic-material"
      text "Dynamic class"
      viewTemplate {
        class "$model.materialClass"
      }
    }
  }

  selector material.inventory.dynamic from state material.inventory.dynamic {
    output MaterialInventoryDynamic
  }

  portal surface.root root "#material-root" layer surface

  surface material.inventory.dynamic kind content component main {
    source selector material.inventory.dynamic
    key dynamic.id
    portal surface.root
    bounds x 0 y 0 width 640 height 480
  }
}
