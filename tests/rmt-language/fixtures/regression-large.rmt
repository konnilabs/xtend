{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "regression.large",
    "namespace": "regression"
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter"
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter"
    }
  ],
  "components": [
    {
      "id": "pages.home",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "component.visible.mount"
    },
    {
      "id": "pages.docs",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-card",
      "schedule": "component.visible.mount"
    },
    {
      "id": "pages.settings",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-tabs",
      "schedule": "component.idle.hydrate"
    },
    {
      "id": "pages.media",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-player",
      "schedule": "component.idle.hydrate"
    }
  ],
  "routes": [
    {
      "id": "home",
      "path": "/",
      "router": "xtend.xrouter",
      "component": "pages.home",
      "template": "home.shell",
      "schedule": "route.visible.render",
      "documentTitle": "Home | Large Regression"
    },
    {
      "id": "docs",
      "path": "/docs",
      "router": "xtend.xrouter",
      "component": "pages.docs",
      "template": "docs.shell",
      "schedule": "route.visible.render",
      "documentTitle": "Docs | Large Regression"
    },
    {
      "id": "settings",
      "path": "/settings",
      "router": "xtend.xrouter",
      "component": "pages.settings",
      "template": "settings.shell",
      "schedule": "route.visible.render",
      "documentTitle": "Settings | Large Regression"
    },
    {
      "id": "media",
      "path": "/media",
      "router": "xtend.xrouter",
      "component": "pages.media",
      "template": "media.shell",
      "schedule": "route.visible.render",
      "documentTitle": "Media | Large Regression"
    }
  ],
  "schedules": [
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "lane": "visible",
      "priority": 80
    },
    {
      "id": "component.visible.mount",
      "endpointName": "xtendrmt.component.mount",
      "lane": "visible",
      "priority": 70
    },
    {
      "id": "component.idle.hydrate",
      "endpointName": "xtendrmt.component.hydrate",
      "lane": "idle",
      "priority": 40,
      "preferIdle": true
    }
  ],
  "templates": [
    {
      "id": "home.shell",
      "mode": "dom_descriptor",
      "nodes": []
    },
    {
      "id": "docs.shell",
      "mode": "dom_descriptor",
      "nodes": []
    },
    {
      "id": "settings.shell",
      "mode": "dom_descriptor",
      "nodes": []
    },
    {
      "id": "media.shell",
      "mode": "dom_descriptor",
      "nodes": []
    }
  ]
}
