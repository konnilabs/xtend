{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "fixture.xtend.remote-compat.legacy-surface",
    "namespace": "fixture.xtend.remoteCompatibility",
    "metadata": {
      "contractVersion": "xtend.rmt.surface-authoring.v1",
      "workpackage": "WP-E16-10",
      "status": "legacy-surface-manager-roundtrip"
    }
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter",
      "providedCapabilities": [
        "components",
        "slots",
        "events",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.surface",
      "kind": "surface_adapter",
      "providedCapabilities": [
        "surfaces",
        "stateBridge",
        "diagnostics"
      ],
      "kernelVisible": false
    }
  ],
  "components": [
    {
      "id": "app.shell",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "app.shell.render",
      "slots": {
        "default": {
          "component": "legacy.manager"
        }
      }
    },
    {
      "id": "legacy.manager",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-manager",
      "schedule": "surface.visible.render",
      "metadata": {
        "surfaceManager": {
          "schema": "xtend.surface.manager.v1",
          "stateKey": "legacy.surface.registry",
          "defaultLayer": "workspace",
          "stackPolicy": "single-active-surface"
        }
      }
    },
    {
      "id": "legacy.inspector",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-window",
      "schedule": "surface.user-blocking.open",
      "attributes": {
        "surface-id": "legacy.inspector",
        "open": "true",
        "active": "true",
        "initial-x": "96",
        "initial-y": "88",
        "initial-width": "520",
        "initial-height": "360"
      },
      "events": {
        "surface-closed": {
          "command": "surface.legacyInspector.close"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "id": "legacy.inspector",
          "type": "window",
          "manager": "legacy.manager",
          "stateKey": "legacy.surface.inspector.state",
          "initialBounds": {
            "x": 96,
            "y": 88,
            "width": 520,
            "height": 360
          },
          "capabilities": [
            "move",
            "resize",
            "close"
          ],
          "persistence": {
            "mode": "session",
            "key": "legacy.inspector.layout"
          }
        }
      }
    }
  ],
  "routes": [
    {
      "id": "legacy",
      "path": "/legacy",
      "component": "app.shell",
      "schedule": "route.visible.render",
      "metadata": {
        "routeBoundSurfaces": [
          "legacy.inspector"
        ]
      }
    }
  ],
  "surfaces": [
    {
      "id": "legacy.inspector",
      "schema": "xtend.surface.record.v1",
      "type": "window",
      "adapter": "xtend.surface",
      "manager": "legacy.manager",
      "component": "legacy.inspector",
      "route": "legacy",
      "schedule": "surface.user-blocking.open",
      "stateKey": "legacy.surface.inspector.state",
      "defaultOpen": true,
      "active": true,
      "bounds": {
        "x": 96,
        "y": 88,
        "width": 520,
        "height": 360
      },
      "capabilities": [
        "move",
        "resize",
        "close"
      ],
      "persistence": {
        "mode": "session",
        "key": "legacy.inspector.layout"
      }
    }
  ],
  "schedules": [
    {
      "id": "app.shell.render",
      "endpointName": "xtendrmt.shell.render",
      "scope": "xtend.shell",
      "lane": "critical",
      "priority": 90
    },
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "xtend.route",
      "lane": "critical",
      "priority": 80
    },
    {
      "id": "surface.visible.render",
      "endpointName": "xtendrmt.surface.render",
      "scope": "xtend.surface",
      "lane": "critical",
      "priority": 80
    },
    {
      "id": "surface.user-blocking.open",
      "endpointName": "xtendrmt.surface.open",
      "scope": "xtend.surface.open",
      "lane": "critical",
      "priority": 100
    }
  ]
}
