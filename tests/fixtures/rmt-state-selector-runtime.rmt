// Migrated from legacy JSON RMT. Runtime parity target: tests/fixtures/rmt-state-selector-runtime.core.json
template epic18.typed.stateRecord.selectorRecord.fixtureRecord {
  state stateRecord_items type collection initial []

  state stateRecord_selection type object preserve {
    initial {
      activeId "alpha"
    }
  }

  state stateRecord_filters type object preserve {
    initial {
      query ""
      kindRecord "all"
    }
  }

  state stateRecord_ui type object preserve {
    initial {
      panelOpen true
    }
  }

  state stateRecord_loading type boolean initial false

  state stateRecord_status type string initial "idle"

  state stateRecord_total type number initial 3

  state stateRecord_optional_detail type nullable initial null

  surface component_shell kind window component x-section {
    lane visible weight 70 {
      hydrate component_shellView from state stateRecord_items
    }
  }
}
