// Migrated from legacy JSON RMT. Runtime parity target: tests/fixtures/rmt-component-template-primitives.core.json
template epic18.component.templateRecord.primitives.fixtureRecord {
  state stateRecord_items type collection initial []

  state stateRecord_selection type object preserve {
    initial {
      id null
    }
  }

  state stateRecord_filters type object preserve {
    initial {
      query ""
      kindRecord "all"
    }
  }

  state stateRecord_error type object preserve {
    initial {
      message ""
    }
  }

  portal app root "#app-root" layer surface

  surface surfaceRecord_workspace kind window component x-section {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_workspaceView from state stateRecord_items
    }
  }

  surface surfaceRecord_detail kind window component x-section {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_detailView from state stateRecord_selection
    }
  }

  surface surfaceRecord_feedback kind window component x-section {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_feedbackView from state stateRecord_error
    }
  }
}
