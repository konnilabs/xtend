{
  "kind": "rmt_document",
  "schema": "xtend.epic18.rmt-app-platform-tooling-fixture.v1",
  "manifest": {
    "id": "epic18.app-platform-tooling.fixture",
    "metadata": {
      "contractVersion": "xtend.epic18.rmt-app-platform-tooling.v1",
      "surfaceGraphContract": "xtend.epic18.rmt-surface-resource-graph-runtime.v2",
      "workpackage": "WP-E18-11",
      "manualHtmlRendererAllowed": false,
      "productSurfaceTaxonomyAllowed": false,
      "productRegistryRepaintRequired": false,
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types"
    },
    "sourceSyntax": "rmt-vnext",
    "authoringSource": "tests/fixtures/rmt-app-platform-tooling.rmt"
  },
  "records": {
    "records.generic-items": [
      {
        "id": "alpha",
        "title": "Alpha"
      },
      {
        "id": "beta",
        "title": "Beta"
      }
    ]
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter"
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter"
    }
  ],
  "schedules": [
    {
      "id": "schedule.render",
      "endpointName": "rmt.app.render",
      "lane": "visible"
    }
  ],
  "routes": [
    {
      "id": "route.workspace",
      "path": "/workspace",
      "router": "xtend.xrouter",
      "component": "component.workspace",
      "template": "template.workspace",
      "schedule": "schedule.render",
      "documentTitle": "Workspace",
      "metadata": {
        "announcement": "Workspace ready"
      }
    }
  ],
  "state": [
    {
      "id": "state.items",
      "type": "collection",
      "initial": []
    }
  ],
  "dataSources": [
    {
      "id": "datasource.items",
      "kind": "fixture",
      "records": "$records.records.generic-items",
      "contract": "domain.record.generic-item.v1[]"
    }
  ],
  "actions": [
    {
      "id": "action.open-detail",
      "statusState": "state.action-status"
    },
    {
      "id": "action.load-items",
      "datasource": "datasource.items",
      "resultState": "state.items"
    }
  ],
  "resources": [
    {
      "id": "resource.preview-stream",
      "kind": "stream"
    },
    {
      "id": "resource.preview-url",
      "kind": "object-url"
    }
  ],
  "portals": [
    {
      "id": "portal.app",
      "policy": "stacked",
      "root": "app-root"
    },
    {
      "id": "portal.overlay",
      "policy": "modal",
      "root": "overlay-root"
    },
    {
      "id": "portal.toast",
      "policy": "toast-region",
      "root": "toast-root"
    }
  ],
  "surfaces": [
    {
      "id": "surface.workspace",
      "kind": "window",
      "source": "records.generic-items",
      "repeat": true,
      "key": "$record.id",
      "owner": "$instance.id",
      "component": "component.workspace",
      "template": "template.workspace",
      "portal": "portal.app",
      "resources": [
        "resource.preview-stream"
      ],
      "initialState": "closed",
      "persistent": true
    }
  ],
  "overlays": [
    {
      "id": "overlay.toast",
      "kind": "toast",
      "portal": "portal.toast",
      "dismissible": true
    },
    {
      "id": "overlay.lightbox",
      "kind": "lightbox",
      "portal": "portal.overlay",
      "resources": [
        "resource.preview-url"
      ],
      "dismissible": true
    }
  ],
  "components": [
    {
      "id": "component.workspace",
      "adapter": "xtend.component",
      "tag": "x-generic-workspace",
      "template": "template.workspace",
      "schedule": "schedule.render"
    }
  ],
  "templates": [
    {
      "id": "template.workspace",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "component": "component.workspace",
          "props": {
            "title": "$record.title"
          }
        }
      ]
    }
  ],
  "events": [
    {
      "id": "event.open-detail",
      "kind": "custom",
      "event": "open-detail",
      "target": "ref.row",
      "component": "component.workspace",
      "owner": "surface.workspace",
      "action": "action.open-detail",
      "payload": {
        "id": "$detail.id"
      },
      "payloadContract": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": "string"
        }
      }
    }
  ],
  "acceptance": {
    "scaffoldPipelineForRmtAppSources": true,
    "noManualShellHtmlSinkDiagnostics": true,
    "unkeyedRepeatDiagnostics": true,
    "untypedEventDiagnostics": true,
    "resourceOwnershipDiagnostics": true,
    "lspCompletionsForAppPlatform": true,
    "sourceMapBuildReport": true,
    "productSurfaceTaxonomyAllowed": false,
    "manualHtmlRendererAllowed": false
  }
}
