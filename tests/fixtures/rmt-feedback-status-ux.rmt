{
  "kind": "rmt_document",
  "id": "fixture.feedback-status-ux",
  "manifest": {
    "id": "feedback-status-shell",
    "version": "0.1.0",
    "metadata": {
      "contractVersion": "xtend.component.feedback-status-ux.v1",
      "workpackage": "WP-E11-09",
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types"
    }
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "host_component_adapter",
      "kernelVisible": false,
      "providedCapabilities": ["shell", "style", "a11y", "events", "commands", "fabric"]
    },
    {
      "id": "rmt.state-scheduler-diagnostics",
      "kind": "diagnostics_adapter",
      "kernelVisible": false,
      "providedCapabilities": ["state", "scheduler", "diagnostics"]
    }
  ],
  "schedules": [
    {
      "id": "component.visible.mount",
      "lane": "visible",
      "policy": "mount-when-visible"
    },
    {
      "id": "component.idle.hydrate",
      "lane": "idle",
      "policy": "hydrate-on-idle"
    },
    {
      "id": "a11y.announce",
      "lane": "a11y",
      "policy": "screenreader-announcement"
    },
    {
      "id": "feedback.status.update",
      "lane": "feedback",
      "policy": "status-update"
    },
    {
      "id": "feedback.progress.update",
      "lane": "background",
      "policy": "progress-update"
    },
    {
      "id": "diagnostics.snapshot",
      "lane": "diagnostics",
      "policy": "snapshot-after-feedback"
    }
  ],
  "components": [
    {
      "id": "feedback.surface",
      "adapter": "xtend.component",
      "tag": "x-section",
      "template": "feedback.surface.template",
      "schedule": "component.visible.mount",
      "shell": {
        "slots": {
          "default": {
            "template": "feedback.surface.content"
          }
        }
      },
      "style": {
        "variant": "neutral",
        "density": "comfortable"
      },
      "a11y": {
        "role": "region",
        "label": "Feedback status UX fixture"
      },
      "fabric": {
        "lane": "visible",
        "fiber": "feedback.surface.mount"
      }
    },
    {
      "id": "feedback.alert",
      "adapter": "xtend.component",
      "tag": "x-alert",
      "template": "feedback.alert.template",
      "schedule": "a11y.announce",
      "props": {
        "type": "warning",
        "closable": true,
        "duration": 0
      },
      "events": {
        "alert-shown": {
          "command": "feedback.alert.announce"
        },
        "alert-dismissed": {
          "command": "feedback.alert.dismiss"
        }
      },
      "commands": {
        "announce": {
          "schedule": "a11y.announce"
        },
        "dismiss": {
          "schedule": "diagnostics.snapshot"
        }
      },
      "a11y": {
        "role": "alert",
        "live": "assertive",
        "atomic": true
      },
      "fabric": {
        "lane": "a11y",
        "fiber": "feedback.alert.announce"
      }
    },
    {
      "id": "feedback.toast",
      "adapter": "xtend.component",
      "tag": "x-toast",
      "template": "feedback.toast.template",
      "schedule": "a11y.announce",
      "props": {
        "type": "success",
        "duration": 3000
      },
      "events": {
        "toast-shown": {
          "command": "feedback.toast.announce"
        },
        "toast-dismissed": {
          "command": "feedback.toast.dismiss"
        }
      },
      "commands": {
        "announce": {
          "schedule": "a11y.announce"
        },
        "dismiss": {
          "schedule": "diagnostics.snapshot"
        }
      },
      "a11y": {
        "role": "status",
        "live": "polite",
        "atomic": true
      },
      "fabric": {
        "lane": "a11y",
        "fiber": "feedback.toast.announce"
      }
    },
    {
      "id": "feedback.status",
      "adapter": "xtend.component",
      "tag": "x-status",
      "template": "feedback.status.template",
      "schedule": "feedback.status.update",
      "props": {
        "type": "error",
        "state": "invalid",
        "message": "The form needs attention.",
        "dismissible": true,
        "busy": false
      },
      "events": {
        "status-changed": {
          "command": "feedback.status.update"
        },
        "status-dismissed": {
          "command": "feedback.status.dismiss"
        }
      },
      "commands": {
        "announce": {
          "schedule": "a11y.announce"
        },
        "update-status": {
          "schedule": "feedback.status.update"
        },
        "dismiss": {
          "schedule": "diagnostics.snapshot"
        }
      },
      "a11y": {
        "role": "alert",
        "live": "assertive",
        "atomic": true,
        "busy": false
      },
      "fabric": {
        "lane": "feedback",
        "a11yLane": "a11y",
        "fiber": "feedback.status.update"
      }
    },
    {
      "id": "feedback.progress",
      "adapter": "xtend.component",
      "tag": "x-progress",
      "template": "feedback.progress.template",
      "schedule": "feedback.progress.update",
      "props": {
        "value": 64,
        "max": 100,
        "status": "Hydrating route",
        "busy": true
      },
      "events": {
        "progress-changed": {
          "command": "feedback.progress.update"
        },
        "progress-complete": {
          "command": "feedback.progress.complete"
        }
      },
      "commands": {
        "set-progress": {
          "schedule": "feedback.progress.update"
        },
        "complete": {
          "schedule": "a11y.announce"
        }
      },
      "a11y": {
        "role": "progressbar",
        "live": "polite",
        "valuetext": "64 percent"
      },
      "fabric": {
        "lane": "background",
        "a11yLane": "a11y",
        "fiber": "feedback.progress.update"
      }
    },
    {
      "id": "feedback.spinner",
      "adapter": "xtend.component",
      "tag": "x-spinner",
      "template": "feedback.spinner.template",
      "schedule": "component.visible.mount",
      "props": {
        "type": "dots",
        "aria-label": "Loading preview",
        "aria-valuetext": "Loading preview",
        "aria-busy": true
      },
      "events": {
        "spinner-started": {
          "command": "feedback.spinner.start"
        },
        "spinner-stopped": {
          "command": "feedback.spinner.stop"
        },
        "paused": {
          "command": "feedback.spinner.pause"
        },
        "resumed": {
          "command": "feedback.spinner.resume"
        }
      },
      "commands": {
        "pause": {
          "schedule": "diagnostics.snapshot"
        },
        "resume": {
          "schedule": "component.visible.mount"
        }
      },
      "a11y": {
        "role": "status",
        "live": "polite",
        "busy": true
      },
      "fabric": {
        "lane": "feedback",
        "fiber": "feedback.spinner.lifecycle"
      }
    }
  ],
  "templates": [
    {
      "id": "feedback.surface.template",
      "kind": "dom_descriptor",
      "metadata": {
        "renderMode": "shell-first"
      },
      "nodes": [
        {
          "component": "feedback.alert"
        },
        {
          "component": "feedback.toast"
        },
        {
          "component": "feedback.status"
        },
        {
          "component": "feedback.progress"
        },
        {
          "component": "feedback.spinner"
        }
      ]
    },
    {
      "id": "feedback.surface.content",
      "kind": "dom_descriptor",
      "nodes": []
    },
    {
      "id": "feedback.alert.template",
      "kind": "dom_descriptor",
      "nodes": [
        {
          "tag": "span",
          "text": "Validation warning"
        }
      ]
    },
    {
      "id": "feedback.toast.template",
      "kind": "dom_descriptor",
      "nodes": [
        {
          "tag": "span",
          "text": "Saved"
        }
      ]
    },
    {
      "id": "feedback.status.template",
      "kind": "dom_descriptor",
      "nodes": [
        {
          "tag": "span",
          "slot": "label",
          "text": "Form status"
        },
        {
          "tag": "span",
          "text": "The form needs attention."
        }
      ]
    },
    {
      "id": "feedback.progress.template",
      "kind": "dom_descriptor",
      "nodes": [
        {
          "tag": "span",
          "slot": "label",
          "text": "Route hydration"
        },
        {
          "tag": "span",
          "text": "Hydrating route"
        }
      ]
    },
    {
      "id": "feedback.spinner.template",
      "kind": "dom_descriptor",
      "nodes": [
        {
          "tag": "span",
          "slot": "content",
          "text": "Loading preview"
        }
      ]
    }
  ]
}
