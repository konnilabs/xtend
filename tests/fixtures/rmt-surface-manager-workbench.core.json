{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "fixture.xtend.surface-manager-workbench",
    "namespace": "fixture.xtend.surface",
    "metadata": {
      "contractVersion": "xtend.rmt.surface-authoring.v1",
      "workpackage": "WP-SM-01",
      "status": "surface-manager-authoring-fixture",
      "appModel": "rmt-first-surface-workbench",
      "renderMode": "shell-first",
      "surfaceManager": "xtend.surface.manager.v1",
      "surfaceRecord": "xtend.surface.record.v1",
      "componentContract": "xtend.component.contract.v2",
      "componentAdapter": "xtend.component",
      "reservedSurfaceAdapter": "xtend.surface",
      "futureSurfaceDomain": "surfaces",
      "fabricApi": "@xtend-fabric",
      "kernelBoundary": "RMT owns surface intent, component refs, schedules, templates and metadata only. XTend component execution, manifest lookup, state access, Fabric execution and DOM materialization stay in host adapters."
    },
    "sourceSyntax": "rmt-vnext",
    "authoringSource": "tests/fixtures/rmt-surface-manager-workbench.rmt"
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "components",
        "customElements",
        "manifestLookup",
        "props",
        "attributes",
        "slots",
        "events",
        "hydration",
        "scheduleRefs",
        "fabricContext",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "routes",
        "navigation",
        "params",
        "query",
        "scheduleRefs",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "rmt.state-scheduler-diagnostics",
      "kind": "scheduler_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "stateBridge",
        "schedulerEndpoints",
        "diagnostics",
        "adapterResults",
        "performanceBudgets",
        "lifecycleEvents"
      ],
      "kernelVisible": false
    }
  ],
  "components": [
    {
      "id": "app.shell",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "app.shell.render",
      "props": {
        "label": "XTend Surface Workbench"
      },
      "attributes": {
        "layout": "column",
        "data-rmt-shell": "true"
      },
      "slots": {
        "default": {
          "component": "workbench.manager"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "visible",
          "fiber": "component.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "workbench.manager",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-manager",
      "schedule": "surface.visible.render",
      "props": {
        "label": "Workbench Surfaces"
      },
      "attributes": {
        "layout": "workspace",
        "restore-key": "fixture.surface.workbench",
        "route-aware": "true",
        "modal-policy": "topmost"
      },
      "slots": {
        "windows": {
          "components": [
            "workbench.inspector",
            "workbench.editor"
          ]
        },
        "panels": {
          "component": "workbench.properties"
        }
      },
      "metadata": {
        "surfaceManager": {
          "schema": "xtend.surface.manager.v1",
          "stateKey": "xtend.surface.registry",
          "defaultLayer": "workspace",
          "stackPolicy": "single-active-surface",
          "persistence": {
            "mode": "session",
            "key": "fixture.surface.workbench.layout"
          }
        },
        "fabric": {
          "lane": "visible",
          "fiber": "surface.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "workbench.inspector",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-window",
      "schedule": "surface.user-blocking.open",
      "props": {
        "label": "Inspector"
      },
      "attributes": {
        "surface-id": "inspector",
        "open": "true",
        "active": "true",
        "resizable": "true",
        "draggable": "true",
        "initial-x": "96",
        "initial-y": "88",
        "initial-width": "520",
        "initial-height": "360"
      },
      "slots": {
        "default": {
          "component": "inspector.content"
        }
      },
      "events": {
        "surface-focused": {
          "command": "surface.inspector.focus"
        },
        "surface-closed": {
          "command": "surface.inspector.close"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "window",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.inspector.state",
          "initialBounds": {
            "x": 96,
            "y": 88,
            "width": 520,
            "height": 360
          },
          "capabilities": [
            "move",
            "resize",
            "minimize",
            "maximize",
            "close"
          ],
          "persistence": {
            "mode": "session",
            "key": "workbench.inspector.layout"
          }
        },
        "fabric": {
          "lane": "user-blocking",
          "fiber": "surface.open",
          "telemetry": true
        },
        "a11y": {
          "role": "dialog",
          "label": "Inspector",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "workbench.editor",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-window",
      "schedule": "surface.user-blocking.open",
      "props": {
        "label": "Editor"
      },
      "attributes": {
        "surface-id": "editor",
        "open": "true",
        "resizable": "true",
        "draggable": "true",
        "initial-x": "660",
        "initial-y": "112",
        "initial-width": "600",
        "initial-height": "420"
      },
      "slots": {
        "default": {
          "component": "editor.content"
        }
      },
      "events": {
        "surface-layout-changed": {
          "command": "surface.editor.layout.changed"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "window",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.editor.state",
          "initialBounds": {
            "x": 660,
            "y": 112,
            "width": 600,
            "height": 420
          },
          "capabilities": [
            "move",
            "resize",
            "minimize",
            "maximize",
            "close"
          ],
          "persistence": {
            "mode": "session",
            "key": "workbench.editor.layout"
          }
        },
        "fabric": {
          "lane": "user-blocking",
          "fiber": "surface.open",
          "telemetry": true
        },
        "a11y": {
          "role": "dialog",
          "label": "Editor",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "workbench.properties",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-side-panel",
      "schedule": "surface.visible.render",
      "props": {
        "label": "Properties"
      },
      "attributes": {
        "surface-id": "properties",
        "placement": "right",
        "mode": "docked",
        "pinned": "true",
        "resizable": "true"
      },
      "slots": {
        "default": {
          "component": "properties.content"
        }
      },
      "events": {
        "surface-collapsed": {
          "command": "surface.properties.collapse"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "side-panel",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.properties.state",
          "placement": "right",
          "mode": "docked",
          "capabilities": [
            "dock",
            "collapse",
            "resize",
            "pin"
          ],
          "responsive": {
            "mobileMode": "fullscreen-panel"
          }
        },
        "fabric": {
          "lane": "visible",
          "fiber": "surface.render",
          "telemetry": true
        },
        "a11y": {
          "role": "complementary",
          "label": "Properties",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "inspector.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "component.visible.mount",
      "props": {
        "label": "Inspector Content"
      },
      "slots": {
        "default": {
          "template": "inspector.content.template"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "visible",
          "fiber": "component.mount"
        }
      }
    },
    {
      "id": "editor.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-code",
      "schedule": "component.idle.hydrate",
      "props": {
        "language": "json",
        "code": "{\"surface\":\"editor\"}"
      },
      "metadata": {
        "fabric": {
          "lane": "idle",
          "fiber": "component.hydrate"
        }
      }
    },
    {
      "id": "properties.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-form",
      "schedule": "component.idle.hydrate",
      "props": {
        "label": "Properties"
      },
      "slots": {
        "default": {
          "template": "properties.content.template"
        }
      },
      "events": {
        "submit": {
          "command": "surface.properties.save"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "idle",
          "fiber": "component.hydrate"
        }
      }
    }
  ],
  "routes": [
    {
      "id": "workbench",
      "path": "/",
      "router": "xtend.xrouter",
      "component": "app.shell",
      "template": "app.shell",
      "shell": "app.shell",
      "schedule": "route.visible.render",
      "metadata": {
        "surfaceManager": "workbench.manager",
        "contentKind": "surface-workbench"
      }
    }
  ],
  "schedules": [
    {
      "id": "app.shell.render",
      "endpointName": "xtendrmt.shell.render",
      "scope": "xtend.surface.shell",
      "lane": "visible",
      "priority": 82,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "xtend.surface.route",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "surface.visible.render",
      "endpointName": "xtendrmt.surface.render",
      "scope": "xtend.surface.render",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "visible",
        "surfaceContract": "xtend.surface.manager.v1"
      }
    },
    {
      "id": "surface.user-blocking.open",
      "endpointName": "xtendrmt.surface.open",
      "scope": "xtend.surface.open",
      "lane": "user-blocking",
      "priority": 100,
      "deadlineMs": 80,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "user-blocking",
        "surfaceContract": "xtend.surface.record.v1"
      }
    },
    {
      "id": "surface.user-blocking.close",
      "endpointName": "xtendrmt.surface.close",
      "scope": "xtend.surface.close",
      "lane": "user-blocking",
      "priority": 100,
      "deadlineMs": 80,
      "preferIdle": false
    },
    {
      "id": "surface.transition.layout",
      "endpointName": "xtendrmt.surface.layout",
      "scope": "xtend.surface.layout",
      "lane": "transition",
      "priority": 65,
      "deadlineMs": 240,
      "preferIdle": false
    },
    {
      "id": "surface.background.persist",
      "endpointName": "xtendrmt.surface.persist",
      "scope": "xtend.surface.persist",
      "lane": "background",
      "priority": 25,
      "deadlineMs": 1000,
      "preferIdle": true
    },
    {
      "id": "surface.diagnostics.snapshot",
      "endpointName": "xtendrmt.surface.diagnostics",
      "scope": "xtend.surface.diagnostics",
      "lane": "diagnostics",
      "priority": 20,
      "deadlineMs": 750,
      "preferIdle": true
    },
    {
      "id": "component.visible.mount",
      "endpointName": "xtendrmt.component.mount",
      "scope": "xtend.component.visible",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "component.idle.hydrate",
      "endpointName": "xtendrmt.component.hydrate",
      "scope": "xtend.component.idle",
      "lane": "idle",
      "priority": 35,
      "deadlineMs": 500,
      "preferIdle": true
    },
    {
      "id": "a11y.user-blocking.announce",
      "endpointName": "xtendrmt.a11y.announce",
      "scope": "xtend.surface.a11y",
      "lane": "user-blocking",
      "priority": 95,
      "deadlineMs": 80,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "a11y"
      }
    },
    {
      "id": "diagnostics.snapshot",
      "endpointName": "xtendrmt.diagnostics.snapshot",
      "scope": "xtend.surface.global-diagnostics",
      "lane": "diagnostics",
      "priority": 20,
      "deadlineMs": 750,
      "preferIdle": true
    }
  ],
  "templates": [
    {
      "id": "app.shell",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-surface-manager",
          "component": "workbench.manager"
        }
      ],
      "metadata": {
        "renderMode": "shell-first",
        "surfaceManager": "workbench.manager"
      }
    },
    {
      "id": "inspector.content.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-alert",
          "props": {
            "type": "info",
            "message": "Surface registry is RMT-authored."
          }
        }
      ]
    },
    {
      "id": "properties.content.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-input",
          "props": {
            "name": "surfaceLabel",
            "value": "Inspector"
          },
          "events": {
            "input-changed": "surface.properties.label.changed"
          }
        }
      ],
      "metadata": {
        "eventBindingMode": "dom-event-to-rmt-command"
      }
    }
  ]
}
