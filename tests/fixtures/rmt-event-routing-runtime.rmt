{
  "kind": "rmt_document",
  "schema": "xtend.epic18.rmt-event-routing-runtime-fixture.v1",
  "manifest": {
    "id": "epic18.event-routing-runtime.fixture",
    "metadata": {
      "contractVersion": "xtend.epic18.rmt-event-routing-runtime.v1",
      "actionEffectContract": "xtend.epic18.rmt-action-effect-runtime.v1",
      "stateSelectorContract": "xtend.epic18.rmt-state-selector-runtime.v1",
      "workpackage": "WP-E18-09",
      "renderMode": "component_native_dom_descriptor",
      "manualHtmlRendererAllowed": false,
      "htmlStringRendererRequired": false,
      "productSurfaceClone": false,
      "productEventFrameworkAllowed": false,
      "eventDelegationMode": "declarative-owner-scoped-bindings",
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types"
    }
  },
  "state": [
    {
      "id": "state.items",
      "type": "collection",
      "schema": "domain.record.generic-item.v1",
      "initial": []
    },
    {
      "id": "state.loading",
      "type": "boolean",
      "initial": false,
      "preserve": "attribute-sync"
    },
    {
      "id": "state.action-status",
      "type": "object",
      "schema": "domain.action.status.v1",
      "initial": { "status": "idle", "action": "" },
      "preserve": "attribute-sync"
    },
    {
      "id": "state.feedback",
      "type": "object",
      "schema": "domain.feedback.generic.v1",
      "initial": { "status": "idle", "message": "" },
      "preserve": "component-state"
    }
  ],
  "selectors": [
    {
      "id": "selector.items",
      "from": "state.items",
      "output": "domain.record.generic-item.v1[]",
      "structural": true
    },
    {
      "id": "selector.loading",
      "from": "state.loading",
      "compute": "boolean",
      "output": "boolean",
      "structural": false
    }
  ],
  "dataSources": [
    {
      "id": "datasource.fixture.items",
      "kind": "fixture",
      "records": [
        { "id": "alpha", "title": "Alpha", "kind": "task" },
        { "id": "beta", "title": "Beta", "kind": "note" }
      ],
      "contract": "domain.record.generic-item.v1[]"
    },
    {
      "id": "datasource.rest.search",
      "kind": "rest",
      "endpoint": "/api/generic-items",
      "adapter": "rest",
      "resultPath": "items",
      "contract": "domain.record.generic-item.v1[]"
    },
    {
      "id": "datasource.host.mutate",
      "kind": "host",
      "adapter": "host.mutate",
      "resultPath": "record",
      "contract": "domain.record.generic-item.v1"
    },
    {
      "id": "datasource.host.pending",
      "kind": "host",
      "adapter": "host.pending",
      "contract": "domain.record.generic-item.v1[]"
    }
  ],
  "effects": [
    {
      "id": "effect.feedback.loaded",
      "kind": "toast",
      "target": "feedback.toast",
      "severity": "success",
      "message": "Records loaded"
    },
    {
      "id": "effect.feedback.saved",
      "kind": "feedback",
      "target": "feedback.toast",
      "severity": "success",
      "message": "$result.title"
    },
    {
      "id": "effect.navigation.detail",
      "kind": "navigation",
      "path": "$payload.path"
    },
    {
      "id": "effect.lazy.preview",
      "kind": "lazy-import",
      "resources": ["resource.preview-import"]
    }
  ],
  "resources": [
    {
      "id": "resource.preview-import",
      "kind": "lazy-import",
      "importId": "generic-preview-panel"
    }
  ],
  "actions": [
    {
      "id": "action.load-items",
      "datasource": "datasource.fixture.items",
      "resultState": "state.items",
      "loadingState": "state.loading",
      "statusState": "state.action-status",
      "effects": ["effect.feedback.loaded"]
    },
    {
      "id": "action.rest-search",
      "datasource": "datasource.rest.search",
      "resultState": "state.items",
      "loadingState": "state.loading",
      "statusState": "state.action-status"
    },
    {
      "id": "action.host-mutate",
      "datasource": "datasource.host.mutate",
      "resultState": "state.feedback",
      "loadingState": "state.loading",
      "statusState": "state.action-status",
      "effects": ["effect.feedback.saved"]
    },
    {
      "id": "action.navigate-detail",
      "statusState": "state.action-status",
      "effects": ["effect.navigation.detail"]
    },
    {
      "id": "action.preload-preview",
      "statusState": "state.action-status",
      "effects": ["effect.lazy.preview"]
    },
    {
      "id": "action.cancelable-load",
      "datasource": "datasource.host.pending",
      "loadingState": "state.loading",
      "statusState": "state.action-status",
      "cancelable": true
    }
  ],
  "components": [
    {
      "id": "component.toolbar",
      "tag": "x-toolbar",
      "refs": ["ref.load-button", "ref.search-input"]
    },
    {
      "id": "component.form",
      "tag": "x-form",
      "refs": ["ref.save-form"]
    },
    {
      "id": "component.collection-row",
      "tag": "x-card",
      "refs": ["ref.item-row"]
    },
    {
      "id": "component.preview-card",
      "tag": "x-card",
      "refs": ["ref.preview-card"]
    },
    {
      "id": "component.drop-zone",
      "tag": "x-drop-zone",
      "refs": ["ref.drop-zone"]
    }
  ],
  "events": [
    {
      "id": "event.load-click",
      "kind": "dom",
      "event": "click",
      "target": "ref.load-button",
      "component": "component.toolbar",
      "owner": "scope.toolbar",
      "action": "action.load-items",
      "payload": {
        "source": "$target.dataset.source"
      },
      "payloadContract": {
        "type": "object",
        "required": ["source"],
        "properties": { "source": "string" }
      },
      "governance": {
        "preventDefault": true,
        "stopPropagation": true,
        "retarget": "target"
      }
    },
    {
      "id": "event.search-input",
      "kind": "dom",
      "event": "input",
      "target": "ref.search-input",
      "component": "component.toolbar",
      "owner": "scope.toolbar",
      "action": "action.rest-search",
      "payload": {
        "query": "$event.target.value"
      },
      "payloadContract": {
        "type": "object",
        "required": ["query"],
        "properties": { "query": "string" }
      },
      "governance": {
        "passive": true,
        "retarget": "target"
      }
    },
    {
      "id": "event.save-submit",
      "kind": "form",
      "event": "submit",
      "target": "ref.save-form",
      "component": "component.form",
      "owner": "scope.form",
      "action": "action.host-mutate",
      "payload": {
        "id": "$detail.id",
        "title": "$detail.title"
      },
      "payloadContract": {
        "type": "object",
        "required": ["id", "title"],
        "properties": { "id": "string", "title": "string" }
      },
      "governance": {
        "preventDefault": true,
        "stopPropagation": true,
        "retarget": "current-target"
      }
    },
    {
      "id": "event.preview-open",
      "kind": "custom",
      "event": "open-preview",
      "target": "ref.preview-card",
      "component": "component.preview-card",
      "owner": "scope.preview",
      "action": "action.preload-preview",
      "payload": {
        "id": "$detail.id",
        "origin": "$source.dataset.origin"
      },
      "payloadContract": {
        "type": "object",
        "required": ["id", "origin"],
        "properties": { "id": "string", "origin": "string" }
      },
      "governance": {
        "capture": true,
        "once": true,
        "retarget": "composed-path"
      }
    },
    {
      "id": "event.row-activate",
      "kind": "custom",
      "event": "item-activated",
      "target": "ref.item-row",
      "component": "component.collection-row",
      "owner": "scope.collection",
      "action": "action.navigate-detail",
      "payload": {
        "id": "$source.dataset.id",
        "path": "$source.dataset.path"
      },
      "payloadContract": {
        "type": "object",
        "required": ["id", "path"],
        "properties": { "id": "string", "path": "string" }
      },
      "governance": {
        "stopImmediatePropagation": true,
        "retarget": "composed-path"
      }
    },
    {
      "id": "event.surface-close",
      "kind": "surface",
      "event": "surface-closed",
      "target": "ref.preview-card",
      "component": "component.preview-card",
      "owner": "scope.preview",
      "action": "action.navigate-detail",
      "payload": {
        "path": "$detail.returnTo"
      },
      "payloadContract": {
        "type": "object",
        "required": ["path"],
        "properties": { "path": "string" }
      },
      "governance": {
        "stopPropagation": true,
        "retarget": "current-target"
      }
    },
    {
      "id": "event.drop-files",
      "kind": "drop",
      "event": "drop",
      "target": "ref.drop-zone",
      "component": "component.drop-zone",
      "owner": "scope.drop-zone",
      "action": "action.host-mutate",
      "payload": {
        "id": "$detail.id",
        "title": "$detail.title",
        "files": "$event.dataTransfer.files"
      },
      "payloadContract": {
        "type": "object",
        "required": ["id", "title", "files"],
        "properties": { "id": "string", "title": "string", "files": "array" }
      },
      "governance": {
        "preventDefault": true,
        "stopPropagation": true,
        "retarget": "target"
      }
    },
    {
      "id": "event.cancel-load",
      "kind": "keyboard",
      "event": "keydown",
      "target": "ref.search-input",
      "component": "component.toolbar",
      "owner": "scope.toolbar",
      "action": "action.cancelable-load",
      "actionMode": "cancel-action",
      "payload": {
        "key": "$event.key"
      },
      "payloadContract": {
        "type": "object",
        "required": ["key"],
        "properties": { "key": "string" }
      },
      "condition": {
        "left": "$event.key",
        "op": "equals",
        "right": "Escape"
      },
      "governance": {
        "stopPropagation": true,
        "retarget": "current-target"
      }
    }
  ],
  "acceptance": {
    "domAndCustomEvents": true,
    "eventToActionMapping": true,
    "payloadContracts": true,
    "governancePolicies": true,
    "ownerScopedListenerCleanup": true,
    "componentInteractionDiagnostics": true,
    "productLocalClosestDelegationAllowed": false,
    "manualHtmlRendererAllowed": false
  }
}
