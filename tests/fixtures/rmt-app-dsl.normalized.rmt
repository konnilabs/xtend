{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "fixture.app-dsl.normalized",
    "namespace": "fixture"
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter",
      "providedCapabilities": [
        "customElements",
        "hydration"
      ]
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter",
      "providedCapabilities": [
        "routes",
        "navigation"
      ]
    }
  ],
  "components": [
    {
      "id": "pages.home",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "component.visible.mount"
    }
  ],
  "routes": [
    {
      "id": "home",
      "path": "/",
      "router": "xtend.xrouter",
      "component": "pages.home",
      "title": "Home",
      "documentTitle": "Home | XTend RMT Fixture",
      "template": "home.shell",
      "schedule": "route.visible.render"
    }
  ],
  "schedules": [
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "fixture.route",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 120,
      "preferIdle": false,
      "coalesceKey": "fixture.route",
      "budgetClass": "interactive"
    },
    {
      "id": "component.visible.mount",
      "endpointName": "xtendrmt.component.mount",
      "scope": "fixture.component",
      "lane": "visible",
      "priority": 70,
      "deadlineMs": 160,
      "preferIdle": false,
      "coalesceKey": "fixture.component",
      "budgetClass": "interactive"
    }
  ],
  "templates": [
    {
      "id": "home.shell",
      "mode": "html_fragment",
      "markup": "<main><x-section></x-section></main>",
      "hydration": {
        "mode": "runtime_render",
        "metadata": {
          "endpointHint": "xtendrmt.component.mount"
        }
      }
    }
  ]
}
