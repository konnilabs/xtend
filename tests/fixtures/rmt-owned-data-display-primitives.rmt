{
  "kind": "rmt_document",
  "schema": "xtend.rmt-ui-maximality-owned-data-display-primitives.rmt-fixture.v1",
  "manifest": {
    "id": "rmo.owned-data-display.fixture",
    "metadata": {
      "contractVersion": "xtend.rmt-ui-maximality-owned-data-display-primitives.v1",
      "workpackage": "WP-RMO-03",
      "renderMode": "component_native_dom_descriptor",
      "manualHtmlRendererAllowed": false,
      "htmlStringRendererRequired": false,
      "externalUiFrameworkDependencyAllowed": false,
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types"
    }
  },
  "dataSources": [
    {
      "id": "datasource.orders",
      "owner": "component-data-display-owner",
      "adapter": "static-fixture",
      "policy": "resource-owner-required",
      "records": [
        { "id": "ord-100", "title": "Native First Audit", "status": "ready", "value": 42 },
        { "id": "ord-200", "title": "Contract Review", "status": "blocked", "value": 7 }
      ]
    }
  ],
  "resources": [
    {
      "id": "resource.orders",
      "dataSource": "datasource.orders",
      "lifecycle": "query",
      "cachePolicy": "owner-scoped",
      "loadingState": "state.orders.loading",
      "errorState": "state.orders.error"
    }
  ],
  "state": [
    { "id": "state.orders.loading", "type": "boolean", "initial": false },
    { "id": "state.orders.error", "type": "string", "initial": "" },
    { "id": "state.orders.selection", "type": "single-selection", "key": "$record.id", "initial": "ord-100" },
    { "id": "state.orders.sort", "type": "sort-descriptor", "field": "title", "direction": "ascending" },
    { "id": "state.orders.filter", "type": "text-filter", "field": "status", "initial": "" }
  ],
  "selectors": [
    {
      "id": "selector.visibleOrders",
      "source": "resource.orders",
      "filter": "state.orders.filter",
      "sort": "state.orders.sort",
      "resultState": "state.orders.visible"
    }
  ],
  "components": [
    { "id": "component.collection.section", "tag": "x-section", "adapter": "xtend.component", "parts": ["root", "header", "content", "footer"] },
    { "id": "component.collection.cards", "tag": "x-cards", "adapter": "xtend.component", "parts": ["root", "grid", "item"] },
    { "id": "component.collection.summary", "tag": "x-summary", "adapter": "xtend.component", "parts": ["root", "value", "label"] },
    { "id": "component.collection.status", "tag": "x-status", "adapter": "xtend.component", "parts": ["root", "icon", "label"] },
    { "id": "component.collection.loading", "tag": "x-progress", "adapter": "xtend.component", "parts": ["root", "bar", "label"] },
    { "id": "component.collection.empty", "tag": "x-alert", "adapter": "xtend.component", "attributes": { "type": "info", "title": "No records" }, "parts": ["root", "title", "content"] },
    { "id": "component.collection.error", "tag": "x-alert", "adapter": "xtend.component", "attributes": { "type": "error", "title": "Load failed" }, "parts": ["root", "title", "content"] }
  ],
  "templates": [
    {
      "id": "template.collection.shell",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.collection.section",
        "slots": {
          "header": "template.collection.summary",
          "content": "collection.orders",
          "footer": "template.collection.status"
        }
      }
    },
    {
      "id": "template.collection.summary",
      "renderMode": "dom_descriptor",
      "root": { "type": "component", "component": "component.collection.summary", "props": { "value": "$selector.visibleOrders.count", "label": "Orders" } }
    },
    {
      "id": "template.order-card",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.collection.cards",
        "props": { "title": "$record.title", "status": "$record.status", "selected": "$selection.current" }
      }
    },
    {
      "id": "template.collection.empty",
      "renderMode": "dom_descriptor",
      "root": { "type": "component", "component": "component.collection.empty" }
    },
    {
      "id": "template.collection.loading",
      "renderMode": "dom_descriptor",
      "root": { "type": "component", "component": "component.collection.loading", "props": { "label": "Loading records" } }
    },
    {
      "id": "template.collection.error",
      "renderMode": "dom_descriptor",
      "root": { "type": "component", "component": "component.collection.error", "props": { "message": "$state.orders.error" } }
    }
  ],
  "collectionViews": [
    {
      "id": "collection.orders",
      "source": "selector.visibleOrders",
      "layoutMode": "list-grid",
      "key": "$record.id",
      "itemTemplate": "template.order-card",
      "emptyTemplate": "template.collection.empty",
      "loadingTemplate": "template.collection.loading",
      "errorTemplate": "template.collection.error",
      "selection": "state.orders.selection",
      "sorting": "state.orders.sort",
      "maxItemsPerFrame": 50,
      "virtualization": "deferred-to-WP-RMO-06",
      "a11y": {
        "role": "list",
        "itemRole": "listitem",
        "selectionAnnouncement": "polite"
      }
    }
  ],
  "events": [
    { "id": "event.collection.select", "source": "collection.orders", "type": "select", "action": "action.orders.select" },
    { "id": "event.collection.sort", "source": "collection.orders", "type": "sort", "action": "action.orders.sort" }
  ],
  "actions": [
    { "id": "action.orders.select", "kind": "state-update", "target": "state.orders.selection", "payload": "$event.key" },
    { "id": "action.orders.sort", "kind": "state-update", "target": "state.orders.sort", "payload": "$event.sort" }
  ],
  "schedules": [
    { "id": "schedule.collection.render", "lane": "visible", "budgetMs": 16 },
    { "id": "schedule.collection.resource", "lane": "resource", "budgetMs": 50 },
    { "id": "schedule.collection.diagnostics", "lane": "diagnostics", "budgetMs": 8 }
  ],
  "sourceMap": [
    { "source": "/collectionViews/0", "target": "collection.orders" },
    { "source": "/dataSources/0", "target": "datasource.orders" },
    { "source": "/templates/2", "target": "template.order-card" }
  ],
  "negativeClaims": [
    "full-datagrid-parity",
    "framework-table-api-copy",
    "virtualization-default-without-browser-evidence"
  ]
}

