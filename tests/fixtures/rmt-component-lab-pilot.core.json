        "adapterResults",
        "performanceBudgets",
        "lifecycleEvents"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.fabric-telemetry",
      "kind": "telemetry_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "fabricSnapshot",
        "componentTelemetry",
        "backpressureSignals",
        "performanceWarnings"
      ],
      "kernelVisible": false
    }
