        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "components",
        "customElements",
        "manifestLookup",
        "props",
        "attributes",
        "slots",
        "events",
        "hydration",
        "scheduleRefs",
        "fabricContext",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
