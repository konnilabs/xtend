// Migrated from legacy JSON RMT. Runtime parity target: tests/fixtures/rmt-surface-native-domain.core.json
template fixtureRecord.xtend.native.surfaces.workbench {
  portal app root "#app-root" layer surface

  surface surfaceRecord_inspector kind window component workbench_inspector {
    portal app
    bounds x 96 y 88 width 520 height 360
    lane visible weight 70 {
      hydrate surfaceRecord_inspectorView
    }
  }

  surface surfaceRecord_editor kind window component workbench_editor {
    portal app
    bounds x 660 y 112 width 600 height 420
    lane visible weight 70 {
      hydrate surfaceRecord_editorView
    }
  }

  surface surfaceRecord_properties kind side-panel component workbench_properties {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_propertiesView
    }
  }

  surface surfaceRecord_commandPalette kind modal component workbench_commandPalette {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_commandPaletteView
    }
  }

  surface surfaceRecord_confirmDialog kind dialog component workbench_confirmDialog {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_confirmDialogView
    }
  }

  surface surfaceRecord_drawer kind drawer component workbench_drawer {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_drawerView
    }
  }
}
