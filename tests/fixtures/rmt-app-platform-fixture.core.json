{
  "kind": "rmt_document",
  "schema": "xtend.epic18.rmt-app-platform-fixture-source.v1",
  "manifest": {
    "id": "epic18.app-platform-fixture.generic",
    "metadata": {
      "contractVersion": "xtend.epic18.rmt-app-platform-fixture.v1",
      "toolingContract": "xtend.epic18.rmt-app-platform-tooling.v1",
      "stateContract": "xtend.epic18.rmt-state-selector-runtime.v2",
      "actionContract": "xtend.epic18.rmt-action-effect-runtime.v1",
      "eventContract": "xtend.epic18.rmt-event-routing-runtime.v2",
      "surfaceGraphContract": "xtend.epic18.rmt-surface-resource-graph-runtime.v2",
      "workpackage": "WP-E18-12",
      "manualHtmlRendererAllowed": false,
      "productSurfaceTaxonomyAllowed": false,
      "fixedRecordContractRequired": false,
      "domainVariants": [
        "generic-catalog",
        "admin-queue",
        "content-board"
      ],
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types"
    },
    "sourceSyntax": "rmt-vnext",
    "authoringSource": "tests/fixtures/rmt-app-platform-fixture.rmt"
  },
  "records": {
    "records.generic-items": [
      {
        "id": "alpha",
        "title": "Alpha dossier",
        "kind": "record",
        "status": "ready",
        "owner": "team-a",
        "score": 8
      },
      {
        "id": "beta",
        "title": "Beta brief",
        "kind": "task",
        "status": "review",
        "owner": "team-b",
        "score": 5
      }
    ],
    "records.admin-queue": [
      {
        "id": "job-1",
        "title": "Queue audit",
        "kind": "job",
        "status": "pending",
        "owner": "ops"
      },
      {
        "id": "job-2",
        "title": "Policy check",
        "kind": "job",
        "status": "blocked",
        "owner": "ops"
      }
    ],
    "records.content-board": [
      {
        "id": "story-1",
        "title": "Release note",
        "kind": "story",
        "status": "draft",
        "owner": "editorial"
      },
      {
        "id": "story-2",
        "title": "Campaign page",
        "kind": "page",
        "status": "ready",
        "owner": "editorial"
      }
    ]
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter"
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter"
    },
    {
      "id": "host.record-api",
      "kind": "datasource_adapter"
    }
  ],
  "schedules": [
    {
      "id": "schedule.render",
      "endpointName": "rmt.app.render",
      "lane": "visible"
    },
    {
      "id": "schedule.action",
      "endpointName": "rmt.app.action",
      "lane": "interaction"
    },
    {
      "id": "schedule.idle",
      "endpointName": "rmt.app.idle",
      "lane": "background"
    }
  ],
  "routes": [
    {
      "id": "route.workspace",
      "path": "/workspace",
      "router": "xtend.xrouter",
      "component": "component.app-shell",
      "template": "template.app-shell",
      "schedule": "schedule.render",
      "documentTitle": "Generic Workspace",
      "metadata": {
        "announcement": "Workspace ready"
      }
    },
    {
      "id": "route.admin",
      "path": "/admin",
      "router": "xtend.xrouter",
      "component": "component.record-list",
      "template": "template.record-list",
      "schedule": "schedule.render",
      "documentTitle": "Admin Queue",
      "metadata": {
        "announcement": "Queue ready"
      }
    },
    {
      "id": "route.content",
      "path": "/content",
      "router": "xtend.xrouter",
      "component": "component.record-list",
      "template": "template.record-list",
      "schedule": "schedule.render",
      "documentTitle": "Content Board",
      "metadata": {
        "announcement": "Board ready"
      }
    }
  ],
  "state": [
    {
      "id": "state.items",
      "type": "collection",
      "initial": []
    },
    {
      "id": "state.selected",
      "type": "object",
      "initial": {}
    },
    {
      "id": "state.filters",
      "type": "object",
      "preserve": "attribute-sync",
      "initial": {
        "query": "",
        "status": "all"
      }
    },
    {
      "id": "state.loading",
      "type": "boolean",
      "initial": false
    },
    {
      "id": "state.feedback",
      "type": "object",
      "initial": {}
    },
    {
      "id": "state.action-status",
      "type": "object",
      "initial": {}
    }
  ],
  "selectors": [
    {
      "id": "selector.items",
      "from": "state.items",
      "sort": {
        "by": "title",
        "direction": "asc"
      }
    },
    {
      "id": "selector.has-items",
      "from": "state.items",
      "compute": "not-empty"
    },
    {
      "id": "selector.selected",
      "from": "state.selected"
    },
    {
      "id": "selector.ready-items",
      "from": "state.items",
      "where": [
        {
          "path": "status",
          "op": "equals",
          "value": "ready"
        }
      ]
    },
    {
      "id": "selector.item-count",
      "from": "state.items",
      "compute": "count"
    },
    {
      "id": "selector.has-selection",
      "from": "state.selected",
      "path": "id",
      "compute": "boolean"
    }
  ],
  "dataSources": [
    {
      "id": "datasource.fixture.items",
      "kind": "fixture",
      "records": [
        {
          "id": "alpha",
          "title": "Alpha dossier",
          "kind": "record",
          "status": "ready",
          "owner": "team-a",
          "score": 8
        },
        {
          "id": "beta",
          "title": "Beta brief",
          "kind": "task",
          "status": "review",
          "owner": "team-b",
          "score": 5
        }
      ],
      "contract": "domain.record.generic-item.v1[]"
    },
    {
      "id": "datasource.rest.search",
      "kind": "rest",
      "adapter": "rest",
      "endpoint": "/api/generic-records",
      "resultPath": "items",
      "contract": "domain.record.generic-item.v1[]"
    },
    {
      "id": "datasource.ssr.bootstrap",
      "kind": "ssr",
      "payload": {
        "data": [
          {
            "id": "bootstrap-1",
            "title": "Server bootstrap",
            "kind": "record",
            "status": "ready",
            "owner": "server"
          }
        ]
      },
      "resultPath": "data",
      "contract": "domain.record.generic-item.v1[]"
    },
    {
      "id": "datasource.host.mutate",
      "kind": "host",
      "adapter": "host.record-api",
      "resultPath": "record",
      "contract": "domain.record.generic-item.v1"
    },
    {
      "id": "datasource.admin-queue",
      "kind": "fixture",
      "records": [
        {
          "id": "job-1",
          "title": "Queue audit",
          "kind": "job",
          "status": "pending",
          "owner": "ops"
        },
        {
          "id": "job-2",
          "title": "Policy check",
          "kind": "job",
          "status": "blocked",
          "owner": "ops"
        }
      ],
      "contract": "domain.record.generic-item.v1[]"
    }
  ],
  "effects": [
    {
      "id": "effect.feedback.loaded",
      "kind": "feedback",
      "target": "portal.toast",
      "severity": "success",
      "message": "Records loaded"
    },
    {
      "id": "effect.feedback.saved",
      "kind": "toast",
      "target": "portal.toast",
      "severity": "success",
      "message": "$result.title"
    },
    {
      "id": "effect.navigate.detail",
      "kind": "navigation",
      "path": "$payload.id"
    },
    {
      "id": "effect.focus.detail",
      "kind": "focus",
      "target": "component.detail-panel"
    },
    {
      "id": "effect.preload.detail",
      "kind": "lazy-import",
      "resources": [
        "resource.detail-module"
      ]
    },
    {
      "id": "effect.audit.side-channel",
      "kind": "side-effect",
      "target": "host.audit"
    }
  ],
  "resources": [
    {
      "id": "resource.preview-stream",
      "kind": "stream",
      "source": "records.generic-items"
    },
    {
      "id": "resource.detail-url",
      "kind": "object-url",
      "source": "$payload.blob"
    },
    {
      "id": "resource.selection-observer",
      "kind": "observer",
      "source": "state.selected"
    },
    {
      "id": "resource.refresh-timer",
      "kind": "timer",
      "delayMs": 25
    },
    {
      "id": "resource.detail-module",
      "kind": "lazy-import",
      "importId": "generic-detail-panel"
    },
    {
      "id": "resource.overlay-observer",
      "kind": "observer",
      "source": "overlay.command-menu"
    }
  ],
  "actions": [
    {
      "id": "action.load-items",
      "datasource": "datasource.fixture.items",
      "resultState": "state.items",
      "loadingState": "state.loading",
      "statusState": "state.action-status",
      "resources": [
        "resource.refresh-timer"
      ],
      "effects": [
        "effect.feedback.loaded",
        "effect.focus.detail"
      ]
    },
    {
      "id": "action.bootstrap-ssr",
      "datasource": "datasource.ssr.bootstrap",
      "resultState": "state.items",
      "statusState": "state.action-status",
      "effects": [
        "effect.feedback.loaded"
      ]
    },
    {
      "id": "action.search",
      "datasource": "datasource.rest.search",
      "resultState": "state.items",
      "loadingState": "state.loading",
      "statusState": "state.action-status",
      "effects": [
        "effect.feedback.loaded"
      ]
    },
    {
      "id": "action.select-record",
      "resultState": "state.selected",
      "statusState": "state.action-status",
      "effects": [
        "effect.navigate.detail",
        "effect.focus.detail"
      ]
    },
    {
      "id": "action.save-record",
      "datasource": "datasource.host.mutate",
      "resultState": "state.feedback",
      "statusState": "state.action-status",
      "resources": [
        "resource.selection-observer",
        "resource.detail-url"
      ],
      "effects": [
        "effect.feedback.saved",
        "effect.audit.side-channel"
      ]
    },
    {
      "id": "action.preload-detail",
      "statusState": "state.action-status",
      "resources": [
        "resource.detail-module"
      ],
      "effects": [
        "effect.preload.detail"
      ]
    }
  ],
  "portals": [
    {
      "id": "portal.app",
      "policy": "stacked",
      "root": "app-root",
      "focusPolicy": "preserve"
    },
    {
      "id": "portal.panel",
      "policy": "nonmodal",
      "root": "panel-root",
      "focusPolicy": "restore"
    },
    {
      "id": "portal.overlay",
      "policy": "modal",
      "root": "overlay-root",
      "focusPolicy": "trap"
    },
    {
      "id": "portal.toast",
      "policy": "toast-region",
      "root": "toast-root",
      "focusPolicy": "preserve"
    },
    {
      "id": "portal.escape",
      "policy": "clipping-escape",
      "root": "escape-root",
      "focusPolicy": "restore"
    }
  ],
  "surfaces": [
    {
      "id": "surface.workspace",
      "kind": "window",
      "source": "records.generic-items",
      "repeat": true,
      "key": "$record.id",
      "owner": "$instance.id",
      "component": "component.app-shell",
      "template": "template.app-shell",
      "portal": "portal.app",
      "resources": [
        "resource.preview-stream"
      ],
      "initialState": "closed",
      "persistent": true,
      "bounds": {
        "x": 24,
        "y": 24,
        "width": 720,
        "height": 520
      }
    },
    {
      "id": "surface.detail-panel",
      "kind": "panel",
      "source": "records.generic-items",
      "repeat": true,
      "key": "$record.id",
      "owner": "$instance.id",
      "component": "component.detail-panel",
      "template": "template.detail-panel",
      "portal": "portal.panel",
      "resources": [
        "resource.selection-observer"
      ],
      "initialState": "closed",
      "persistent": true,
      "bounds": {
        "x": 760,
        "y": 24,
        "width": 360,
        "height": 520
      }
    },
    {
      "id": "surface.admin-board",
      "kind": "window",
      "source": "datasource.admin-queue",
      "repeat": true,
      "key": "$record.id",
      "owner": "$instance.id",
      "component": "component.record-list",
      "template": "template.record-list",
      "portal": "portal.app",
      "resources": [
        "resource.refresh-timer"
      ],
      "initialState": "closed",
      "persistent": true
    },
    {
      "id": "surface.content-board",
      "kind": "window",
      "source": "state.items",
      "repeat": true,
      "key": "$record.id",
      "owner": "$instance.id",
      "component": "component.record-list",
      "template": "template.record-list",
      "portal": "portal.app",
      "resources": [
        "resource.preview-stream"
      ],
      "initialState": "closed",
      "persistent": true
    },
    {
      "id": "surface.overlay-host",
      "kind": "overlay-host",
      "owner": "$instance.id",
      "component": "component.overlay-host",
      "template": "template.overlay-host",
      "portal": "portal.escape",
      "resources": [
        "resource.detail-module"
      ],
      "initialState": "open",
      "destroyOnClose": true
    }
  ],
  "overlays": [
    {
      "id": "overlay.toast",
      "kind": "toast",
      "portal": "portal.toast",
      "dismissible": true,
      "singleton": false
    },
    {
      "id": "overlay.lightbox",
      "kind": "lightbox",
      "portal": "portal.overlay",
      "resources": [
        "resource.detail-url"
      ],
      "dismissible": true,
      "singleton": true
    },
    {
      "id": "overlay.command-menu",
      "kind": "dialog",
      "portal": "portal.escape",
      "resources": [
        "resource.overlay-observer"
      ],
      "dismissible": true,
      "singleton": true
    }
  ],
  "components": [
    {
      "id": "component.app-shell",
      "adapter": "xtend.component",
      "tag": "x-app-shell",
      "template": "template.app-shell",
      "schedule": "schedule.render",
      "slots": {
        "toolbar": "slot.app-shell.toolbar",
        "content": "slot.app-shell.content",
        "detail": "slot.app-shell.detail"
      }
    },
    {
      "id": "component.toolbar",
      "adapter": "xtend.component",
      "tag": "x-toolbar",
      "template": "template.toolbar",
      "schedule": "schedule.render"
    },
    {
      "id": "component.record-list",
      "adapter": "xtend.component",
      "tag": "x-record-list",
      "template": "template.record-list",
      "schedule": "schedule.render"
    },
    {
      "id": "component.record-row",
      "adapter": "xtend.component",
      "tag": "x-record-row",
      "template": "template.record-row",
      "schedule": "schedule.render"
    },
    {
      "id": "component.detail-panel",
      "adapter": "xtend.component",
      "tag": "x-detail-panel",
      "template": "template.detail-panel",
      "schedule": "schedule.render"
    },
    {
      "id": "component.feedback-toast",
      "adapter": "xtend.component",
      "tag": "x-feedback-toast",
      "template": "template.feedback-toast",
      "schedule": "schedule.render"
    },
    {
      "id": "component.overlay-host",
      "adapter": "xtend.component",
      "tag": "x-overlay-host",
      "template": "template.overlay-host",
      "schedule": "schedule.render"
    }
  ],
  "extensionSlots": [
    {
      "id": "slot.app-shell.toolbar",
      "owner": "template.app-shell",
      "name": "toolbar",
      "template": "template.toolbar"
    },
    {
      "id": "slot.app-shell.content",
      "owner": "template.app-shell",
      "name": "content",
      "template": "template.record-list"
    },
    {
      "id": "slot.app-shell.detail",
      "owner": "template.app-shell",
      "name": "detail",
      "template": "template.detail-panel"
    }
  ],
  "templates": [
    {
      "id": "template.app-shell",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.app-shell",
        "id": "node.app-shell",
        "attributes": {
          "aria-label": "Generic App Platform"
        },
        "source": {
          "pointer": "/templates/0/root"
        }
      },
      "nodes": [
        {
          "component": "component.app-shell",
          "props": {
            "title": "Generic App Platform"
          }
        }
      ]
    },
    {
      "id": "template.toolbar",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.toolbar",
        "id": "node.toolbar",
        "attributes": {
          "data-rmt-ref": "ref.toolbar",
          "label": "Workspace tools"
        },
        "children": [
          {
            "type": "text",
            "text": "Workspace tools"
          }
        ]
      },
      "nodes": [
        {
          "component": "component.toolbar",
          "props": {
            "label": "Workspace tools"
          }
        }
      ]
    },
    {
      "id": "template.record-list",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "when",
        "test": "hasItems",
        "then": {
          "type": "component",
          "component": "component.record-list",
          "id": "node.record-list",
          "attributes": {
            "data-rmt-surface": "surface.workspace"
          },
          "children": [
            {
              "type": "repeat",
              "source": "items",
              "key": "item.id",
              "item": "template.record-row"
            }
          ]
        },
        "else": {
          "type": "component",
          "component": "component.feedback-toast",
          "attributes": {
            "severity": "info"
          },
          "children": [
            {
              "type": "text",
              "text": "No records"
            }
          ]
        }
      },
      "nodes": [
        {
          "component": "component.record-list",
          "props": {
            "items": "$selector.items"
          }
        }
      ]
    },
    {
      "id": "template.record-row",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.record-row",
        "id": "node.record-row",
        "key": "$item.id",
        "attributes": {
          "data-rmt-ref": "ref.record-row",
          "data-status": "$item.status",
          "title": "$item.title"
        },
        "properties": {
          "value": "$item.id"
        },
        "events": {
          "click": "event.record-select"
        },
        "children": [
          {
            "type": "text",
            "text": "$item.title"
          }
        ]
      },
      "nodes": [
        {
          "component": "component.record-row",
          "props": {
            "title": "$record.title"
          }
        }
      ]
    },
    {
      "id": "template.detail-panel",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.detail-panel",
        "id": "node.detail-panel",
        "attributes": {
          "data-rmt-ref": "ref.detail-panel",
          "label": "Details",
          "title": "$model.selected.title"
        },
        "children": [
          {
            "type": "text",
            "text": "$model.selected.title"
          }
        ]
      },
      "nodes": [
        {
          "component": "component.detail-panel",
          "props": {
            "selected": "$selector.selected"
          }
        }
      ]
    },
    {
      "id": "template.feedback-toast",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.feedback-toast",
        "id": "node.feedback-toast",
        "attributes": {
          "role": "status",
          "data-rmt-ref": "ref.feedback"
        },
        "children": [
          {
            "type": "text",
            "text": "$model.feedback.message"
          }
        ]
      },
      "nodes": [
        {
          "component": "component.feedback-toast",
          "props": {
            "message": "$state.feedback.message"
          }
        }
      ]
    },
    {
      "id": "template.overlay-host",
      "mode": "dom_descriptor",
      "renderMode": "dom_descriptor",
      "root": {
        "type": "component",
        "component": "component.overlay-host",
        "id": "node.overlay-host",
        "attributes": {
          "data-rmt-ref": "ref.overlay-host",
          "data-portal": "portal.escape"
        }
      },
      "nodes": [
        {
          "component": "component.overlay-host",
          "props": {
            "portal": "portal.escape"
          }
        }
      ]
    }
  ],
  "events": [
    {
      "id": "event.load-click",
      "kind": "dom",
      "event": "click",
      "target": "ref.toolbar",
      "component": "component.toolbar",
      "owner": "app.toolbar",
      "action": "action.load-items",
      "payload": {
        "source": "fixture"
      },
      "payloadContract": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": "string"
        }
      }
    },
    {
      "id": "event.search-submit",
      "kind": "form",
      "event": "submit",
      "target": "ref.toolbar",
      "component": "component.toolbar",
      "owner": "app.toolbar",
      "action": "action.search",
      "payload": {
        "query": "$detail.query"
      },
      "payloadContract": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": "string"
        }
      },
      "preventDefault": true
    },
    {
      "id": "event.record-select",
      "kind": "dom",
      "event": "click",
      "target": "ref.record-row",
      "component": "component.record-row",
      "owner": "surface.workspace:alpha",
      "action": "action.select-record",
      "payload": {
        "id": "$detail.id",
        "title": "$detail.title",
        "status": "$detail.status",
        "owner": "$detail.owner"
      },
      "payloadContract": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
