{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "fixture.xtend.first-class-app",
    "namespace": "fixture.xtend.app",
    "metadata": {
      "contractVersion": "xtend.rmt.first-class-app-authoring.v1",
      "workpackage": "WP-E10-04",
      "status": "first-class-rmt-app-authoring-fixture",
      "appModel": "rmt-first-xtend-app",
      "renderMode": "shell-first",
      "componentContract": "xtend.component.contract.v2",
      "typescriptSourceStrategy": "xtend.typescript.component-source-strategy.v1",
      "routerAdapter": "xtend.xrouter",
      "componentAdapter": "xtend.component",
      "fabricApi": "@xtend-fabric",
      "kernelBoundary": "RMT owns app records, schedules, routes, templates and metadata only. XTend component execution, manifest lookup, XRouter registration, xstate access, Fabric execution and DOM materialization stay in host adapters."
    }
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "components",
        "customElements",
        "manifestLookup",
        "props",
        "attributes",
        "slots",
        "events",
        "hydration",
        "scheduleRefs",
        "fabricContext",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "routes",
        "navigation",
        "params",
        "query",
        "scheduleRefs",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "rmt.state-scheduler-diagnostics",
      "kind": "scheduler_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "stateBridge",
        "schedulerEndpoints",
        "diagnostics",
        "adapterResults",
        "performanceBudgets",
        "lifecycleEvents"
      ],
      "kernelVisible": false
    }
  ],
  "components": [
    {
      "id": "app.shell",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "app.shell.render",
      "props": {
        "label": "XTend RMT App"
      },
      "attributes": {
        "layout": "column",
        "data-rmt-shell": "true"
      },
      "slots": {
        "header": {
          "template": "app.header"
        },
        "default": {
          "component": "app.router"
        }
      },
      "hydration": {
        "mode": "runtime_render",
        "ownershipMode": "managed_subtree"
      },
      "metadata": {
        "componentContract": "xtend.component.contract.v2",
        "fabric": {
          "lane": "visible",
          "fiber": "component.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "app.header",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-header",
      "schedule": "component.visible.mount",
      "props": {
        "title": "RMT-first XTend App"
      },
      "slots": {
        "default": {
          "template": "app.nav"
        }
      }
    },
    {
      "id": "app.router",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-router",
      "schedule": "route.visible.render",
      "attributes": {
        "mode": "hash",
        "data-rmt-router": "xtend.xrouter"
      }
    },
    {
      "id": "pages.dashboard",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "component.visible.mount",
      "props": {
        "label": "Dashboard"
      },
      "attributes": {
        "layout": "column",
        "data-route": "dashboard"
      },
      "slots": {
        "default": {
          "template": "pages.dashboard.template"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "visible",
          "fiber": "component.mount"
        }
      }
    },
    {
      "id": "dashboard.health",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-alert",
      "schedule": "component.visible.mount",
      "props": {
        "type": "success",
        "message": "RMT schedules, XTend renders."
      },
      "events": {
        "alert-dismissed": {
          "command": "dashboard.health.dismiss"
        }
      }
    },
    {
      "id": "pages.settings",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-form",
      "schedule": "component.idle.hydrate",
      "props": {
        "label": "Settings"
      },
      "attributes": {
        "data-route": "settings"
      },
      "events": {
        "submit": {
          "command": "settings.save"
        },
        "invalid": {
          "command": "settings.validation.failed"
        }
      },
      "hydration": {
        "mode": "runtime_render",
        "ownershipMode": "managed_subtree"
      },
      "metadata": {
        "fabric": {
          "lane": "idle",
          "fiber": "component.hydrate",
          "telemetry": true
        }
      }
    },
    {
      "id": "settings.email",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-input",
      "schedule": "component.idle.hydrate",
      "props": {
        "type": "email",
        "name": "email",
        "value": "demo@example.test"
      },
      "attributes": {
        "required": "true",
        "aria-label": "Notification email"
      },
      "events": {
        "input-changed": {
          "command": "settings.email.changed"
        }
      }
    },
    {
      "id": "pages.tutorial",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-player",
      "schedule": "media.lazy.hydrate",
      "props": {
        "title": "RMT-first tutorial",
        "src": "/media/rmt-first-tutorial.mp4"
      },
      "hydration": {
        "mode": "runtime_render",
        "ownershipMode": "managed_subtree"
      },
      "metadata": {
        "contentKind": "xplayerTutorial",
        "fabric": {
          "lane": "background",
          "fiber": "component.hydrate",
          "telemetry": true
        }
      }
    }
  ],
  "routes": [
    {
      "id": "dashboard",
      "path": "/",
      "router": "xtend.xrouter",
      "component": "pages.dashboard",
      "template": "pages.dashboard.template",
      "shell": "app.shell",
      "schedule": "route.visible.render",
      "metadata": {
        "title": "Dashboard",
        "contentKind": "xtendComponentTree"
      }
    },
    {
      "id": "settings",
      "path": "/settings",
      "router": "xtend.xrouter",
      "component": "pages.settings",
      "template": "pages.settings.template",
      "shell": "app.shell",
      "schedule": "route.transition.render",
      "metadata": {
        "title": "Settings",
        "contentKind": "xtendComponentTree"
      }
    },
    {
      "id": "tutorial",
      "path": "/tutorial",
      "router": "xtend.xrouter",
      "component": "pages.tutorial",
      "template": "pages.tutorial.template",
      "shell": "app.shell",
      "schedule": "route.transition.render",
      "metadata": {
        "title": "Tutorial",
        "contentKind": "xplayerTutorial"
      }
    }
  ],
  "schedules": [
    {
      "id": "app.shell.render",
      "endpointName": "xtendrmt.shell.render",
      "scope": "fixture.xtend.app.shell",
      "lane": "visible",
      "priority": 95,
      "deadlineMs": 80,
      "preferIdle": false,
      "coalesceKey": "fixture.xtend.app.shell",
      "budgetClass": "critical"
    },
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "fixture.xtend.app.route.visible",
      "lane": "visible",
      "priority": 90,
      "deadlineMs": 160,
      "preferIdle": false,
      "coalesceKey": "fixture.xtend.app.route.visible",
      "budgetClass": "interactive"
    },
    {
      "id": "route.transition.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "fixture.xtend.app.route.transition",
      "lane": "transition",
      "priority": 75,
      "deadlineMs": 220,
      "preferIdle": false,
      "coalesceKey": "fixture.xtend.app.route.transition",
      "budgetClass": "interactive"
    },
    {
      "id": "component.visible.mount",
      "endpointName": "xtendrmt.component.mount",
      "scope": "fixture.xtend.app.component.mount",
      "lane": "visible",
      "priority": 70,
      "deadlineMs": 160,
      "preferIdle": false,
      "coalesceKey": "fixture.xtend.app.component.mount",
      "budgetClass": "interactive"
    },
    {
      "id": "component.idle.hydrate",
      "endpointName": "xtendrmt.component.hydrate",
      "scope": "fixture.xtend.app.component.hydrate",
      "lane": "idle",
      "priority": 40,
      "deadlineMs": 420,
      "preferIdle": true,
      "coalesceKey": "fixture.xtend.app.component.hydrate",
      "budgetClass": "background"
    },
    {
      "id": "ui.user-blocking.input",
      "endpointName": "xtendrmt.ui.user-blocking",
      "scope": "fixture.xtend.app.input",
      "lane": "user-blocking",
      "priority": 100,
      "deadlineMs": 80,
      "preferIdle": false,
      "coalesceKey": "fixture.xtend.app.input",
      "budgetClass": "critical"
    },
    {
      "id": "media.lazy.hydrate",
      "endpointName": "xtendrmt.component.hydrate",
      "scope": "fixture.xtend.app.media",
      "lane": "background",
      "priority": 25,
      "deadlineMs": 900,
      "preferIdle": true,
      "coalesceKey": "fixture.xtend.app.media",
      "budgetClass": "best_effort"
    },
    {
      "id": "diagnostics.snapshot",
      "endpointName": "xtendrmt.diagnostics.snapshot",
      "scope": "fixture.xtend.app.diagnostics",
      "lane": "diagnostics",
      "priority": 20,
      "deadlineMs": 260,
      "preferIdle": true,
      "coalesceKey": "fixture.xtend.app.diagnostics",
      "budgetClass": "diagnostics"
    }
  ],
  "templates": [
    {
      "id": "app.shell",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-section",
          "attributes": {
            "layout": "column",
            "data-rmt-template": "app.shell"
          },
          "slots": {
            "header": {
              "component": "app.header"
            },
            "default": {
              "component": "app.router"
            }
          }
        }
      ],
      "hydration": {
        "mode": "runtime_render",
        "metadata": {
          "endpointHint": "xtendrmt.shell.render"
        }
      },
      "metadata": {
        "renderMode": "shell-first",
        "componentRefs": [
          "app.header",
          "app.router"
        ]
      }
    },
    {
      "id": "app.header",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-header",
          "attributes": {
            "title": "RMT-first XTend App"
          },
          "children": [
            {
              "tag": "nav",
              "attributes": {
                "data-rmt-nav": "primary"
              },
              "children": [
                {
                  "tag": "x-link",
                  "attributes": {
                    "href": "/",
                    "data-route": "dashboard"
                  },
                  "text": "Dashboard"
                },
                {
                  "tag": "x-link",
                  "attributes": {
                    "href": "/settings",
                    "data-route": "settings"
                  },
                  "text": "Settings"
                },
                {
                  "tag": "x-link",
                  "attributes": {
                    "href": "/tutorial",
                    "data-route": "tutorial"
                  },
                  "text": "Tutorial"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "pages.dashboard.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-section",
          "attributes": {
            "label": "Dashboard",
            "layout": "column"
          },
          "slots": {
            "default": {
              "component": "dashboard.health"
            }
          }
        }
      ],
      "hydration": {
        "mode": "runtime_render",
        "metadata": {
          "endpointHint": "xtendrmt.component.mount"
        }
      }
    },
    {
      "id": "pages.settings.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-form",
          "attributes": {
            "data-rmt-component": "pages.settings"
          },
          "events": {
            "submit": "settings.save",
            "invalid": "settings.validation.failed"
          },
          "slots": {
            "default": {
              "component": "settings.email"
            }
          }
        }
      ],
      "hydration": {
        "mode": "runtime_render",
        "metadata": {
          "endpointHint": "xtendrmt.component.hydrate"
        }
      }
    },
    {
      "id": "pages.tutorial.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-player",
          "attributes": {
            "data-rmt-component": "pages.tutorial",
            "title": "RMT-first tutorial"
          }
        }
      ],
      "hydration": {
        "mode": "runtime_render",
        "metadata": {
          "endpointHint": "xtendrmt.component.hydrate"
        }
      },
      "metadata": {
        "lazySchedule": "media.lazy.hydrate"
      }
    }
  ]
}
