{
  "kind": "rmt_dsl_authoring_polish_fixture",
  "schema": "xtend.rmt.dsl-authoring-polish-fixture.v1",
  "contract": "xtend.rmt.dsl-authoring-polish.v1",
  "workpackage": "WP-E12-13",
  "kernelBoundary": "no-rmt-kernel-import-of-xtend-types",
  "sourceContracts": [
    "xtend.rmt.shell-authoring.v1",
    "xtend.rmt.style-authoring.v1",
    "xtend.rmt.first-class-app-authoring.v1",
    "xtend.rmt.xrouter-adapter.v1",
    "xtend.component.network.v1",
    "xtend.design-tokens.product-contract.v1"
  ],
  "dslAliases": [
    {
      "alias": "component",
      "expandsTo": "components[]",
      "fields": ["id", "tag", "template", "shell", "style", "a11y", "events", "commands", "hydration", "fabric"],
      "adapter": "xtend.component",
      "kernelVisible": false
    },
    {
      "alias": "shell",
      "expandsTo": "components[].shell",
      "fields": ["state", "slots", "parts", "focus", "attributes"],
      "adapter": "xtend.component",
      "kernelVisible": false
    },
    {
      "alias": "slot",
      "expandsTo": "components[].shell.slots",
      "fields": ["name", "template", "component", "text"],
      "adapter": "xtend.component",
      "kernelVisible": false
    },
    {
      "alias": "style",
      "expandsTo": "components[].style",
      "fields": ["variant", "size", "density", "theme", "tokens", "parts"],
      "sourceContract": "xtend.rmt.style-authoring.v1",
      "kernelVisible": false
    },
    {
      "alias": "token",
      "expandsTo": "components[].style.tokens",
      "fields": ["name", "value"],
      "sourceContract": "xtend.design-tokens.product-contract.v1",
      "kernelVisible": false
    },
    {
      "alias": "theme",
      "expandsTo": "components[].style.theme",
      "fields": ["name"],
      "sourceContract": "xtend.design-tokens.product-contract.v1",
      "kernelVisible": false
    },
    {
      "alias": "density",
      "expandsTo": "components[].style.density",
      "fields": ["name"],
      "sourceContract": "xtend.design-tokens.product-contract.v1",
      "kernelVisible": false
    },
    {
      "alias": "a11y",
      "expandsTo": "components[].a11y",
      "fields": ["role", "label", "description", "live", "keyboard", "focus", "announcements"],
      "adapter": "xtend.component",
      "kernelVisible": false
    },
    {
      "alias": "on",
      "expandsTo": "components[].events",
      "fields": ["event", "command", "bubbles", "composed"],
      "sourceContract": "xtend.component.network.v1",
      "kernelVisible": false
    },
    {
      "alias": "command",
      "expandsTo": "components[].commands",
      "fields": ["name", "schedule", "payload"],
      "sourceContract": "xtend.component.network.v1",
      "kernelVisible": false
    },
    {
      "alias": "hydrate",
      "expandsTo": "components[].hydration",
      "fields": ["policy", "schedule", "ownershipMode"],
      "adapter": "xtend.component",
      "kernelVisible": false
    },
    {
      "alias": "lane",
      "expandsTo": "components[].fabric.lane",
      "fields": ["lane", "fiber", "telemetry"],
      "sourceContract": "xtend.component.fabric-boundary.v2",
      "kernelVisible": false
    },
    {
      "alias": "route",
      "expandsTo": "routes[]",
      "fields": ["path", "component", "template", "schedule", "announce"],
      "adapter": "xtend.xrouter",
      "sourceContract": "xtend.rmt.xrouter-adapter.v1",
      "kernelVisible": false
    },
    {
      "alias": "link",
      "expandsTo": "components[] + routes[]",
      "fields": ["href", "label", "route", "active", "focusRestore"],
      "adapter": "xtend.component",
      "sourceContract": "xtend.rmt.xrouter-adapter.v1",
      "kernelVisible": false
    },
    {
      "alias": "outlet",
      "expandsTo": "templates[].nodes[]",
      "fields": ["route", "slot", "fallback"],
      "sourceContract": "xtend.rmt.first-class-app-authoring.v1",
      "kernelVisible": false
    }
  ],
  "authoringExamples": [
    {
      "id": "settings-shell",
      "aliases": ["component", "shell", "slot", "style", "token", "a11y", "hydrate", "lane"],
      "dsl": {
        "component": "settings.shell",
        "tag": "x-section",
        "shell": {
          "slot": {
            "header": "settings.header.template",
            "feedback": "feedback.toast"
          }
        },
        "style": {
          "theme": "dark",
          "density": "comfortable",
          "token": {
            "--xtend-surface": "var(--xtend-surface)",
            "--xtend-color-primary": "var(--xtend-color-primary)"
          }
        },
        "a11y": {
          "role": "region",
          "label": "Settings"
        },
        "hydrate": {
          "policy": "visible",
          "schedule": "component.visible.mount"
        },
        "lane": {
          "lane": "visible",
          "fiber": "component.render"
        }
      },
      "normalized": {
        "components": [
          {
            "id": "settings.shell",
            "tag": "x-section",
            "adapter": "xtend.component",
            "template": "settings.shell.template",
            "shell": {
              "state": "ready",
              "slots": {
                "header": {
                  "template": "settings.header.template"
                },
                "feedback": {
                  "component": "feedback.toast"
                }
              },
              "parts": ["root", "content", "header"]
            },
            "style": {
              "theme": "dark",
              "density": "comfortable",
              "tokens": {
                "--xtend-surface": "var(--xtend-surface)",
                "--xtend-color-primary": "var(--xtend-color-primary)",
                "--xtend-density-spacing": "var(--xtend-density-spacing)"
              }
            },
            "a11y": {
              "role": "region",
              "label": "Settings",
              "announcements": "a11y.announce"
            },
            "hydration": {
              "policy": "visible",
              "schedule": "component.visible.mount",
              "ownershipMode": "host-adapter"
            },
            "fabric": {
              "lane": "visible",
              "fiber": "component.render",
              "telemetry": "fabric.component.render"
            }
          }
        ],
        "templates": [
          {
            "id": "settings.shell.template",
            "nodes": [
              {
                "component": "settings.shell",
                "slots": {
                  "header": "settings.header.template"
                }
              }
            ]
          }
        ],
        "schedules": [
          {
            "id": "component.visible.mount",
            "lane": "visible"
          }
        ]
      }
    },
    {
      "id": "settings-route-link",
      "aliases": ["route", "link", "outlet", "on", "command"],
      "dsl": {
        "route": "/settings",
        "component": "settings.shell",
        "link": {
          "label": "Settings",
          "href": "/settings",
          "active": "aria-current"
        },
        "outlet": "primary"
      },
      "normalized": {
        "routes": [
          {
            "path": "/settings",
            "component": "settings.shell",
            "adapter": "xtend.xrouter",
            "schedule": "route.transition.render",
            "announce": "a11y.announce"
          }
        ],
        "components": [
          {
            "id": "settings.nav.link",
            "tag": "x-link",
            "adapter": "xtend.component",
            "events": {
              "xtend:route-change": {
                "command": "route.navigate",
                "bubbles": true,
                "composed": true
              }
            },
            "commands": {
              "route.navigate": {
                "schedule": "route.transition.render",
                "payload": {
                  "path": "/settings"
                }
              }
            },
            "a11y": {
              "role": "link",
              "label": "Settings"
            }
          }
        ],
        "templates": [
          {
            "id": "app.route.outlet",
            "nodes": [
              {
                "outlet": {
                  "route": "current",
                  "slot": "primary",
                  "fallback": "not-found.template"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "feedback-slot",
      "aliases": ["component", "slot", "a11y", "command", "lane"],
      "dsl": {
        "component": "feedback.toast",
        "tag": "x-toast",
        "slot": "feedback",
        "a11y": {
          "live": "polite",
          "label": "Status updates"
        },
        "command": {
          "announce": "a11y.announce"
        }
      },
      "normalized": {
        "components": [
          {
            "id": "feedback.toast",
            "tag": "x-toast",
            "adapter": "xtend.component",
            "shell": {
              "slots": {
                "content": {
                  "text": "Ready"
                }
              }
            },
            "a11y": {
              "live": "polite",
              "label": "Status updates"
            },
            "commands": {
              "announce": {
                "schedule": "a11y.announce"
              }
            },
            "fabric": {
              "lane": "a11y",
              "fiber": "component.feedback"
            }
          }
        ],
        "templates": [
          {
            "id": "settings.feedback.template",
            "nodes": [
              {
                "component": "feedback.toast"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "theme-density-pack",
      "aliases": ["theme", "density", "token", "style"],
      "dsl": {
        "theme": "high-contrast",
        "density": "dense",
        "token": [
          "--xtend-surface",
          "--xtend-text",
          "--xtend-radius"
        ]
      },
      "normalized": {
        "themePacks": [
          {
            "id": "high-contrast",
            "schema": "xtend.design-tokens.pack.v1",
            "tokens": {
              "--xtend-surface": "Canvas",
              "--xtend-text": "CanvasText",
              "--xtend-color-primary": "Highlight"
            }
          }
        ],
        "densityPacks": [
          {
            "id": "dense",
            "tokens": {
              "--xtend-density-spacing": "0.375rem"
            }
          }
        ],
        "components": [
          {
            "id": "compact.action",
            "tag": "x-button",
            "style": {
              "theme": "high-contrast",
              "density": "dense",
              "tokens": {
                "--xtend-radius": "0.375rem"
              }
            }
          }
        ]
      }
    }
  ],
  "diagnosticFixtures": [
    {
      "code": "rmt.dsl.alias.unknown",
      "severity": "error",
      "sample": {
        "alias": "widget"
      },
      "repairHint": "Use a supported alias from the polish plan."
    },
    {
      "code": "rmt.dsl.alias.required-field-missing",
      "severity": "error",
      "sample": {
        "component": "settings.shell"
      },
      "repairHint": "Add required tag or template fields before normalization."
    },
    {
      "code": "rmt.dsl.token.unknown",
      "severity": "warning",
      "sample": {
        "token": "--app-private-color"
      },
      "repairHint": "Use a documented --xtend-* token or register an app-local pack."
    },
    {
      "code": "rmt.dsl.route.target-unresolved",
      "severity": "error",
      "sample": {
        "route": "/missing",
        "component": "unknown.shell"
      },
      "repairHint": "Declare the target component before routing to it."
    },
    {
      "code": "rmt.dsl.link.route-unresolved",
      "severity": "error",
      "sample": {
        "link": "/missing"
      },
      "repairHint": "Declare a route alias for the link path."
    },
    {
      "code": "rmt.dsl.slot.target-unresolved",
      "severity": "error",
      "sample": {
        "slot": "feedback",
        "component": "unknown.toast"
      },
      "repairHint": "Bind the slot to declared text, template or component refs."
    },
    {
      "code": "rmt.dsl.schedule.unresolved",
      "severity": "error",
      "sample": {
        "command": "validate",
        "schedule": "unknown.schedule"
      },
      "repairHint": "Use an existing schedule id."
    },
    {
      "code": "rmt.dsl.inline-runtime-code-refused",
      "severity": "error",
      "sample": {
        "on": "click",
        "handler": "host-adapter-command"
      },
      "repairHint": "Bind events to commands instead of inline JavaScript."
    },
    {
      "code": "rmt.dsl.kernel-boundary.refused",
      "severity": "error",
      "sample": {
        "import": "xtend.component.class"
      },
      "repairHint": "Keep XTend behind host adapters."
    }
  ],
  "upstreamHandoff": {
    "target": "XTendRMT upstream",
    "stableInputs": ["dslAliases", "diagnosticFixtures", "authoringExamples"],
    "expectedWork": ["syntax-normalization", "friendly-parser-errors", "editor-snippets", "schema-autocomplete"],
    "nonGoals": ["import XTend component classes in the RMT kernel", "execute DOM event handlers in RMT", "replace host adapters"]
  }
}
