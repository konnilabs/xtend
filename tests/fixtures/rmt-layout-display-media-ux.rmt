{
  "manifest": {
    "id": "xtend.layout-display-media-ux.fixture",
    "name": "XTend Layout Display Media UX Shell",
    "version": "0.1.0",
    "metadata": {
      "contractVersion": "xtend.component.layout-display-media-ux.v1",
      "workpackage": "WP-E11-12",
      "kernelBoundary": "no-rmt-kernel-import-of-xtend-types",
      "authoringMode": "shell-first"
    }
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component-host",
      "kernelVisible": false
    },
    {
      "id": "rmt.layout-host",
      "kind": "layout-scheduler",
      "kernelVisible": true
    },
    {
      "id": "rmt.media-host",
      "kind": "media-scheduler",
      "kernelVisible": true
    },
    {
      "id": "rmt.state-scheduler-diagnostics",
      "kind": "diagnostics",
      "kernelVisible": true
    }
  ],
  "schedules": [
    {
      "id": "component.shell.render",
      "lane": "visible",
      "policy": "shell-first"
    },
    {
      "id": "component.visible.mount",
      "lane": "visible",
      "policy": "mount-visible"
    },
    {
      "id": "component.idle.hydrate",
      "lane": "idle",
      "policy": "hydrate-idle"
    },
    {
      "id": "component.lazy.hydrate",
      "lane": "lazy",
      "policy": "hydrate-lazy"
    },
    {
      "id": "layout.measure",
      "lane": "visible",
      "policy": "read-layout"
    },
    {
      "id": "layout.reflow.commit",
      "lane": "visible",
      "policy": "write-layout"
    },
    {
      "id": "media.lazy.load",
      "lane": "media",
      "policy": "load-on-intent"
    },
    {
      "id": "media.playback.user",
      "lane": "user-blocking",
      "policy": "user-gesture"
    },
    {
      "id": "a11y.announce",
      "lane": "a11y",
      "policy": "polite"
    },
    {
      "id": "diagnostics.snapshot",
      "lane": "diagnostics",
      "policy": "read-only"
    }
  ],
  "components": [
    {
      "id": "layout.section",
      "tag": "x-section",
      "adapter": "xtend.component",
      "template": "tpl.section",
      "schedule": "layout.measure",
      "state": "xsection-state-docs-shell",
      "shell": { "slots": ["header", "aside", "default", "footer"], "parts": ["root", "container", "header", "aside", "content", "footer"] },
      "a11y": { "role": "region", "label": "Docs content section" },
      "fabric": { "lane": "visible", "fiber": "layout.section" },
      "commands": {
        "measure": { "schedule": "layout.measure" },
        "layout": { "schedule": "layout.reflow.commit" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "layout.cards",
      "tag": "x-cards",
      "adapter": "xtend.component",
      "template": "tpl.cards",
      "schedule": "layout.reflow.commit",
      "state": "xcards-state-docs-grid",
      "shell": { "slots": ["default"], "parts": ["root", "grid", "item"] },
      "a11y": { "role": "list", "label": "Related documentation cards" },
      "fabric": { "lane": "visible", "fiber": "layout.cards" },
      "commands": {
        "measure": { "schedule": "layout.measure" },
        "layout": { "schedule": "layout.reflow.commit" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "layout.header",
      "tag": "x-header",
      "adapter": "xtend.component",
      "template": "tpl.header",
      "schedule": "component.visible.mount",
      "state": "xheader-state-docs-header",
      "shell": {
        "slots": ["logo", "title", "search", "actions", "utility", "nav"],
        "parts": ["root", "title", "logo", "search", "actions", "utility", "drawer", "nav"],
        "compatibility": { "legacyUtilitySlot": true }
      },
      "a11y": { "role": "banner", "label": "Documentation header" },
      "fabric": { "lane": "visible", "fiber": "layout.header" },
      "commands": {
        "render": { "schedule": "component.shell.render" },
        "layout": { "schedule": "layout.reflow.commit" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "layout.footer",
      "tag": "x-footer",
      "adapter": "xtend.component",
      "template": "tpl.footer",
      "schedule": "component.visible.mount",
      "state": "xfooter-state-docs-footer",
      "shell": { "slots": ["logo", "title", "nav", "extra"], "parts": ["root", "logo", "title", "nav", "extra"] },
      "a11y": { "role": "contentinfo", "label": "Documentation footer" },
      "fabric": { "lane": "visible", "fiber": "layout.footer" },
      "commands": {
        "render": { "schedule": "component.shell.render" },
        "layout": { "schedule": "layout.reflow.commit" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "display.hero",
      "tag": "x-hero",
      "adapter": "xtend.component",
      "template": "tpl.hero",
      "schedule": "component.shell.render",
      "state": "xhero-state-docs-hero",
      "shell": { "slots": ["hero-title", "default"], "parts": ["root", "overlay", "content", "scroll-button"] },
      "a11y": { "role": "banner", "label": "Documentation hero" },
      "fabric": { "lane": "visible", "fiber": "display.hero" },
      "commands": {
        "render": { "schedule": "component.shell.render" },
        "measure": { "schedule": "layout.measure" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "display.type",
      "tag": "x-type",
      "adapter": "xtend.component",
      "template": "tpl.type",
      "schedule": "component.idle.hydrate",
      "state": "xtype-current",
      "shell": { "slots": ["default"], "parts": ["root", "text", "cursor"] },
      "a11y": { "role": "text", "live": "polite" },
      "fabric": { "lane": "idle", "fiber": "display.type" },
      "commands": {
        "hydrate": { "schedule": "component.idle.hydrate" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "display.code",
      "tag": "x-code",
      "adapter": "xtend.component",
      "template": "tpl.code",
      "schedule": "component.idle.hydrate",
      "state": "xcode-state-docs-snippet",
      "shell": { "slots": ["default"], "parts": ["root", "copy", "pre", "code"] },
      "a11y": { "role": "region", "label": "Code sample" },
      "fabric": { "lane": "idle", "fiber": "display.code" },
      "commands": {
        "copy": { "schedule": "a11y.announce" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "layout.masonry",
      "tag": "x-masonry",
      "adapter": "xtend.component",
      "template": "tpl.masonry",
      "schedule": "layout.reflow.commit",
      "state": "xmasonry-state-docs-gallery",
      "shell": { "slots": ["default"], "parts": ["root", "grid", "item", "toggle", "content"] },
      "a11y": { "role": "list", "label": "Documentation media grid" },
      "fabric": { "lane": "visible", "fiber": "layout.masonry" },
      "commands": {
        "measure": { "schedule": "layout.measure" },
        "layout": { "schedule": "layout.reflow.commit" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "display.summary",
      "tag": "x-summary",
      "adapter": "xtend.component",
      "template": "tpl.summary",
      "schedule": "component.visible.mount",
      "state": "xsummary-open-docs-summary",
      "shell": { "slots": ["title", "default"], "parts": ["container", "summary", "content"] },
      "a11y": { "role": "button", "expanded": "aria-expanded" },
      "fabric": { "lane": "visible", "fiber": "display.summary" },
      "commands": {
        "expand": { "schedule": "component.visible.mount" },
        "collapse": { "schedule": "a11y.announce" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "media.player",
      "tag": "x-player",
      "adapter": "xtend.component",
      "template": "tpl.player",
      "schedule": "media.lazy.load",
      "state": "xplayer-state-docs-video",
      "shell": { "slots": ["default"], "parts": ["root", "media", "controls", "progress", "overlay"] },
      "a11y": { "role": "region", "label": "Tutorial video" },
      "fabric": { "lane": "media", "fiber": "media.player" },
      "commands": {
        "preload-media": { "schedule": "media.lazy.load" },
        "play-media": { "schedule": "media.playback.user" },
        "pause-media": { "schedule": "media.playback.user" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    },
    {
      "id": "media.lightbox",
      "tag": "x-lightbox",
      "adapter": "xtend.component",
      "template": "tpl.lightbox",
      "schedule": "media.lazy.load",
      "state": "xlightbox-open-docs-lightbox",
      "shell": { "slots": ["default"], "parts": ["overlay", "content", "close", "media"] },
      "a11y": { "role": "dialog", "modal": true },
      "fabric": { "lane": "media", "fiber": "media.lightbox" },
      "commands": {
        "lazy-load": { "schedule": "media.lazy.load" },
        "expand": { "schedule": "component.lazy.hydrate" },
        "collapse": { "schedule": "a11y.announce" },
        "snapshot": { "schedule": "diagnostics.snapshot" }
      }
    }
  ],
  "templates": [
    {
      "id": "tpl.shell",
      "nodes": [
        { "component": "layout.header" },
        { "component": "display.hero" },
        { "component": "layout.section" },
        { "component": "media.player" },
        { "component": "layout.footer" }
      ]
    },
    {
      "id": "tpl.section",
      "nodes": [
        { "component": "display.summary" },
        { "component": "display.code" },
        { "component": "layout.cards" }
      ]
    },
    {
      "id": "tpl.cards",
      "nodes": [
        { "component": "display.type" },
        { "component": "layout.masonry" }
      ]
    },
    {
      "id": "tpl.masonry",
      "nodes": [
        { "component": "media.lightbox" }
      ]
    },
    {
      "id": "tpl.header",
      "nodes": []
    },
    {
      "id": "tpl.footer",
      "nodes": []
    },
    {
      "id": "tpl.hero",
      "nodes": []
    },
    {
      "id": "tpl.type",
      "nodes": []
    },
    {
      "id": "tpl.code",
      "nodes": []
    },
    {
      "id": "tpl.summary",
      "nodes": []
    },
    {
      "id": "tpl.player",
      "nodes": []
    },
    {
      "id": "tpl.lightbox",
      "nodes": []
    }
  ],
  "diagnostics": {
    "snapshots": [
      {
        "id": "layout-media-snapshot",
        "schedule": "diagnostics.snapshot",
        "targets": [
          "layout.section",
          "layout.cards",
          "layout.header",
          "layout.footer",
          "display.hero",
          "display.type",
          "display.code",
          "layout.masonry",
          "display.summary",
          "media.player",
          "media.lightbox"
        ]
      }
    ]
  }
}
