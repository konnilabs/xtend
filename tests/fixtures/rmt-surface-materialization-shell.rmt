// Migrated from legacy JSON RMT. Runtime parity target: tests/fixtures/rmt-surface-materialization-shell.core.json
template fixtureRecord.xtend.surfaceRecord.materialization.shell {
  portal app root "#app-root" layer surface

  surface surfaceRecord_inspector kind window component inspector_content {
    portal app
    bounds x 96 y 88 width 520 height 360
    lane visible weight 70 {
      hydrate surfaceRecord_inspectorView
    }
  }

  surface surfaceRecord_editor kind window component editor_content {
    portal app
    bounds mode responsive scope viewport x "1rem" y "1rem" width "clamp(20rem, 70vi, 52rem)" height "min(80dvh, 42rem)" minWidth "18rem" maxHeight "48rem"
    lane visible weight 70 {
      hydrate surfaceRecord_editorView
    }
  }

  surface surfaceRecord_properties kind side-panel component properties_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_propertiesView
    }
  }

  surface surfaceRecord_commandPalette kind modal component command_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_commandPaletteView
    }
  }

  surface surfaceRecord_confirmDialog kind dialog component confirm_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_confirmDialogView
    }
  }

  surface surfaceRecord_drawer kind drawer component drawer_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_drawerView
    }
  }

  surface surfaceRecord_summaryCard kind card component region_content {
    portal app
    bounds x 24 y 24 width 420 height 180
    lane visible weight 70 {
      hydrate surfaceRecord_summaryCardView
    }
  }

  surface surfaceRecord_popover kind popover component popover_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_popoverView
    }
  }

  surface surfaceRecord_tooltip kind tooltip component tooltip_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_tooltipView
    }
  }

  surface surfaceRecord_toast kind toast component toast_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_toastView
    }
  }

  surface surfaceRecord_lightbox kind lightbox component lightbox_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_lightboxView
    }
  }

  surface surfaceRecord_menu kind menu component menu_content {
    portal app
    lane visible weight 70 {
      hydrate surfaceRecord_menuView
    }
  }
}
