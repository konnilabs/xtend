import "./shared/*.rmt"

template xtendrmt.bestcase.demo {
  state demo.runtime.metrics type object preserve {
    initial {
      id "bestcase-runtime"
      status "ready"
      activeRoute "/"
      completedJobs 0
    }
  }

  state demo.component.capabilities type object preserve {
    initial {
      id "component-capability-matrix"
      manifestCount 42
      publicComponents 38
      browserSmokeFamilies 5
    }
  }

  state demo.player.session type object preserve {
    initial {
      id "bestcase-player"
      mediaId "intro"
      title "XTendRMT Runtime Walkthrough"
      status "paused"
    }
  }

  state demo.flagship.evidence type object preserve {
    initial {
      id "bestcase-flagship-evidence"
      status "ready"
      streamingBoundary "xtend.security.streaming-boundary.v1"
      sourceToSeaPrimitive "bestcase.evidence.summary"
      fabricLane "visible"
      remoteExecution false
      networkRequests 0
    }
  }

  state demo.enterprise.contract type object preserve {
    initial {
      id "bestcase-enterprise-contract"
      status "contract-only"
      remoteSurface "bestcase.audit"
      fallbackSurface "enterpriseFallback"
      eventGovernance "strict"
    }
  }

  state demo.nativeFirst.coverage type object preserve {
    initial {
      id "bestcase-native-first-coverage"
      domDescriptorProofs true
      ownedRecipes true
      actionEffectDataResource true
      runtimeParity true
    }
  }

  selector demo.runtime.summary from state demo.runtime.metrics {
    output BestcaseRuntimeSummary
  }

  selector demo.component.matrix from state demo.component.capabilities {
    output ComponentCapabilityMatrix
  }

  selector demo.player.contract from state demo.player.session {
    output RmtPlayerContract
  }

  selector demo.flagship.summary from state demo.flagship.evidence {
    output RmtBestcaseFlagshipSummary
  }

  selector demo.enterprise.summary from state demo.enterprise.contract {
    output RmtBestcaseEnterpriseSummary
  }

  selector demo.nativeFirst.summary from state demo.nativeFirst.coverage {
    output RmtBestcaseNativeFirstSummary
  }

  datasource demo.component.manifest from endpoint "/components/manifest.json" {
    method GET
    contract ComponentManifest
    result capabilities
    fallback fixture xtend.component.manifest
  }

  datasource demo.runtime.evidence from endpoint "/.xtend-test-results/xtend-rmt-vnext-primitives-gate-report.json" {
    method GET
    contract RmtVNextPrimitiveGateReport
    result suites
    fallback fixture rmt.vnext.primitive.report
  }

  datasource demo.flagship.releaseEvidence from endpoint "/.xtend-test-results/xtend-rmt-vnext-primitives-gate-report.json" {
    method GET
    contract RmtBestcaseFlagshipEvidence
    result suites
    fallback fixture rmt.bestcase.flagship.report
  }

  action demo.primitive.refresh {
    input route string
    reduce state.demo.runtime.metrics.activeRoute = input.route
    reduce state.demo.runtime.metrics.status = "primitive-matrix-refreshed"
    emit demo.primitive.refreshed with route input.route
  }

  action demo.player.play {
    input mediaId string
    reduce state.demo.player.session.mediaId = input.mediaId
    reduce state.demo.player.session.status = "playing"
    emit demo.player.requested with mediaId input.mediaId
  }

  action demo.player.pause {
    input mediaId string
    reduce state.demo.player.session.mediaId = input.mediaId
    reduce state.demo.player.session.status = "paused"
    emit demo.player.paused with mediaId input.mediaId
  }

  action xtendrmt.template-pilot.inspect {
    input templateRef string
    reduce state.demo.runtime.metrics.status = "template-pilot-inspected"
    emit xtendrmt.template.pilot.inspected with templateRef input.templateRef
  }

  action demo.flagship.sourceToSea.inspect {
    input primitiveId string
    reduce state.demo.flagship.evidence.status = "source-to-sea-inspected"
    emit demo.flagship.sourceToSea.inspected with primitiveId input.primitiveId
  }

  action demo.enterprise.audit.request {
    input surfaceRef string
    reduce state.demo.enterprise.contract.status = "audit-requested"
    emit demo.enterprise.audit.requested with surfaceRef input.surfaceRef
  }

  action demo.governance.publish {
    input eventName string
    reduce state.demo.enterprise.contract.eventGovernance = "typed-cross-surface-event-published"
    emit demo.governance.published with eventName input.eventName
  }

  action demo.nativeFirst.verify {
    input recipeRef string
    reduce state.demo.nativeFirst.coverage.runtimeParity = true
    emit demo.nativeFirst.verified with recipeRef input.recipeRef
  }

  portal bestcase.surface.root root "#rmt-demo-router" layer surface

  portal bestcase.overlay.root root "body" layer overlay z 1000 {
    focus policy restore
    pointer policy passthrough
    scroll policy lock-when-modal
  }

  overlay bestcase.toast kind toast portal bestcase.overlay.root {
    escape close topmost
    focus policy none
  }

  resource bestcase.capabilityRegistry kind lazy-import owner surface.primitives {
    import "./rmt-component-capability-registry.js"
  }

  resource bestcase.playerObjectUrl kind object-url owner surface.media {
    source selector demo.player.contract
    dispose on surface.destroy
  }

  resource bestcase.runtimeSubscription kind subscription owner surface.scheduler {
    dispose on surface.destroy
  }

  resource bestcase.streamSubscription kind subscription owner surface.streaming {
    dispose on surface.destroy
  }

  resource bestcase.enterpriseRemoteManifest kind lazy-import owner surface.enterprise {
    import "./fixtures/bestcase-enterprise-remote-manifest.json"
  }

  resource bestcase.nativeFirstRecipeRegistry kind lazy-import owner surface.nativeFirst {
    import "./fixtures/bestcase-native-first-recipes.json"
  }

  surface kernel kind window component x-rmt-route-overview {
    source selector demo.runtime.summary
    key runtime.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane visible weight 88 {
      mount x-rmt-route-overview from endpoint xtendrmt.route.render
    }

    lane idle weight 1 {
      hydrate code.`snapshot`
    }
  }

  surface scheduler kind window component x-rmt-route-scheduler {
    source selector demo.runtime.summary
    key runtime.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.runtimeSubscription

    lane visible weight 88 {
      mount x-rmt-route-scheduler from endpoint xtendrmt.route.render
    }

    lane idle weight 42 {
      hydrate scheduler.`snapshot` from endpoint xtendrmt.component-hydrate
    }

    lane diagnostics weight 34 {
      prewarm diagnostics.`snapshot` from worker xtendrmt.diagnostics.`snapshot`
    }
  }

  surface routing kind window component x-rmt-route-routing {
    source selector demo.runtime.summary
    key runtime.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane visible weight 88 {
      mount x-rmt-route-routing from endpoint xtendrmt.route.render when route.visible == true
    }
  }

  surface templating kind window component x-rmt-route-template-pilot {
    source selector demo.runtime.summary
    key runtime.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane visible weight 70 {
      mount x-rmt-route-template-pilot from endpoint xtendrmt.template-inspect {
        slot title {
          hydrate pilot.title
        }

        slot cards {
          hydrate kernel.cards
        }

        slot feedback {
          hydrate feedback.status
        }

        on pilot-run -> action xtendrmt.template-pilot.inspect {
          payload templateRef from surface.id
        }
      }
    }
  }

  surface primitives kind window component x-rmt-route-primitives {
    source selector demo.component.matrix
    key capabilities.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.capabilityRegistry

    lane visible weight 92 {
      hydrate x-rmt-route-primitives from selector demo.component.matrix
    }

    lane idle weight 36 {
      prewarm component-capabilities from datasource demo.component.manifest
    }

    on click "[data-demo-run='primitive-matrix']" -> action demo.primitive.refresh {
      preventDefault true
      payload route from target.dataset.demoRoute
    }
  }

  surface media kind window component x-rmt-route-media {
    source selector demo.player.contract
    key player.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.playerObjectUrl

    lane visible weight 84 {
      hydrate x-rmt-route-media from selector demo.player.contract
    }

    lane idle weight 24 {
      prewarm primitive-report from datasource demo.runtime.evidence
    }

    on xplayer-play target bestcase-player -> action demo.player.play {
      payload mediaId from detail.mediaId
    }

    on xplayer-pause target bestcase-player -> action demo.player.pause {
      payload mediaId from detail.mediaId
    }
  }

  surface adapter kind window component x-rmt-route-adapter {
    source selector demo.runtime.summary
    key runtime.id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane idle weight 42 {
      hydrate x-rmt-route-adapter from endpoint xtendrmt.component-hydrate
    }
  }

  surface streaming kind window component x-rmt-route-streaming {
    source selector demo.flagship.summary
    key id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.streamSubscription

    lane visible weight 86 {
      mount x-rmt-route-streaming from endpoint xtendrmt.route.render
    }

    lane idle weight 32 {
      stream activity-feed from sse feed.activity {
        trust boundary "xtend.security.streaming-boundary.v1"
        sanitize html
      }
    }
  }

  surface sourceToSea kind window component x-rmt-route-source-to-sea {
    source selector demo.flagship.summary
    key id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane visible weight 90 {
      mount x-rmt-route-source-to-sea from endpoint xtendrmt.source-to-sea.render {
        on evidence-click -> action demo.flagship.sourceToSea.inspect {
          payload primitiveId from target.dataset.rmtPrimitiveId
        }
      }
    }

    lane diagnostics weight 44 {
      prewarm source-to-sea-evidence from datasource demo.flagship.releaseEvidence
    }
  }

  surface enterprise kind window component x-rmt-route-enterprise {
    source selector demo.enterprise.summary
    key id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.enterpriseRemoteManifest

    lane visible weight 89 {
      mount x-rmt-route-enterprise from endpoint xtendrmt.enterprise.contract
    }

    lane idle weight 31 {
      prewarm enterprise-remote-manifest from datasource demo.flagship.releaseEvidence
    }

    on click "[data-demo-run='enterprise-audit']" -> action demo.enterprise.audit.request {
      preventDefault true
      payload surfaceRef from target.dataset.remoteSurface
    }
  }

  surface enterpriseFallback kind panel component x-rmt-route-enterprise-fallback {
    source selector demo.enterprise.summary
    key id
    portal bestcase.surface.root
    bounds x 820 y 48 width 320 height 520

    lane visible weight 76 {
      mount x-rmt-route-enterprise-fallback from endpoint xtendrmt.enterprise.fallback
    }
  }

  surface governance kind window component x-rmt-route-governance {
    source selector demo.enterprise.summary
    key id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620

    lane visible weight 82 {
      mount x-rmt-route-governance from endpoint xtendrmt.event-governance.render {
        on governance-publish -> action demo.governance.publish {
          payload eventName from detail.eventName
        }
      }
    }
  }

  surface nativeFirst kind window component x-rmt-route-native-first {
    source selector demo.nativeFirst.summary
    key id
    portal bestcase.surface.root
    bounds x 24 y 24 width 1120 height 620
    destroy releases resource bestcase.nativeFirstRecipeRegistry

    lane visible weight 85 {
      mount x-rmt-route-native-first from endpoint xtendrmt.native-first.render
    }

    lane idle weight 38 {
      prewarm native-first-recipes from datasource demo.flagship.releaseEvidence
    }

    on click "[data-demo-run='native-first']" -> action demo.nativeFirst.verify {
      preventDefault true
      payload recipeRef from target.dataset.recipeRef
    }
  }
}

remote surface bestcase.audit from remote "@xtend/audit-panel" {
  owner team "platform-runtime"
  version "^2.0.0"
  origin "https://cdn.xtend.example"
  integrity sha256 "sha256-bestcaseauditpanel000000000000000000000000000001"
  trust boundary "xtend.security.remote-surface.v1"
  fallback surface enterpriseFallback

  exposes lane critical -> shell.slot "enterprise.audit"
  exposes lane idle -> shell.slot "background.audit-prefetch"

  emits bestcase.audit.opened.v1 {
    owner team "platform-runtime"
    direction outbound
    lane critical
    payload "xtend.schemas.bestcaseAuditOpened.v1"
  }

  consumes demo.primitive.refreshed.v1 {
    owner team "platform-runtime"
    direction inbound
    from shell.session
    lane critical
    payload "xtend.schemas.primitiveRefreshed.v1"
  }

  consumes demo.enterprise.audit.requested.v1 {
    owner team "platform-runtime"
    direction inbound
    from shell.session
    lane critical
    payload "xtend.schemas.enterpriseAuditRequested.v1"
  }

  consumes demo.governance.published.v1 {
    owner team "platform-runtime"
    direction inbound
    from shell.session
    lane critical
    payload "xtend.schemas.governancePublished.v1"
  }
}
