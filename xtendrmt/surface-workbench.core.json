{
  "kind": "rmt_document",
  "version": "1.0",
  "manifest": {
    "documentId": "demo.xtend.surface-workbench",
    "namespace": "demo.xtend.surface",
    "metadata": {
      "contractVersion": "xtend.surface.workbench-fixture.v1",
      "sourceAuthoringContract": "xtend.rmt.surface-authoring.v1",
      "workpackage": "WP-SM-05",
      "status": "rmt-first-workbench-fixture",
      "appModel": "rmt-first-surface-workbench",
      "renderMode": "shell-first",
      "manualShellAllowed": false,
      "hostShellMarkup": false,
      "routeBoundContent": true,
      "sharedSurfaceSnapshot": true,
      "surfaceManager": "xtend.surface.manager.v1",
      "surfaceRecord": "xtend.surface.record.v1",
      "surfaceController": "xtend.surface.controller.v1",
      "surfaceSnapshot": "xtend.surface.snapshot.v1",
      "componentContract": "xtend.component.contract.v2",
      "componentAdapter": "xtend.component",
      "reservedSurfaceAdapter": "xtend.surface",
      "kernelBoundary": "RMT owns surface intent, route binding, component refs, schedules, templates and metadata only. XTend component execution, manifest lookup, xstate access, Fabric execution and DOM materialization stay in host adapters."
    },
    "sourceSyntax": "rmt-vnext",
    "authoringSource": "xtendrmt/surface-workbench.rmt"
  },
  "adapters": [
    {
      "id": "xtend.component",
      "kind": "component_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "components",
        "customElements",
        "manifestLookup",
        "props",
        "attributes",
        "slots",
        "events",
        "hydration",
        "scheduleRefs",
        "fabricContext",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "xtend.xrouter",
      "kind": "router_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "routes",
        "navigation",
        "params",
        "query",
        "scheduleRefs",
        "diagnostics"
      ],
      "kernelVisible": false
    },
    {
      "id": "rmt.state-scheduler-diagnostics",
      "kind": "scheduler_adapter",
      "runtimeSurface": [
        "esm",
        "browser_classic"
      ],
      "providedCapabilities": [
        "stateBridge",
        "schedulerEndpoints",
        "diagnostics",
        "adapterResults",
        "performanceBudgets",
        "lifecycleEvents"
      ],
      "kernelVisible": false
    }
  ],
  "components": [
    {
      "id": "app.shell",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "app.shell.render",
      "props": {
        "label": "XTend Surface Workbench"
      },
      "attributes": {
        "layout": "column",
        "data-rmt-shell": "true"
      },
      "slots": {
        "default": {
          "template": "app.shell.template"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "visible",
          "fiber": "component.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "app.router",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-router",
      "schedule": "route.visible.render",
      "props": {
        "label": "Workbench Router"
      },
      "attributes": {
        "mode": "hash",
        "data-route-bound-surfaces": "true"
      },
      "metadata": {
        "router": {
          "schema": "xtend.xrouter.route-bound-surface.v1",
          "mountsSurfaceManager": "workbench.manager"
        },
        "fabric": {
          "lane": "visible",
          "fiber": "route.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "workbench.manager",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-manager",
      "schedule": "surface.visible.render",
      "props": {
        "label": "Workbench Surfaces"
      },
      "attributes": {
        "layout": "workspace",
        "manager-id": "workbench.manager",
        "state-key": "xtend.surface.registry",
        "restore-key": "demo.surface.workbench",
        "route-aware": "true",
        "modal-policy": "topmost"
      },
      "slots": {
        "windows": {
          "components": [
            "workbench.inspector",
            "workbench.editor"
          ]
        },
        "panels": {
          "component": "workbench.properties"
        }
      },
      "metadata": {
        "surfaceManager": {
          "schema": "xtend.surface.manager.v1",
          "stateKey": "xtend.surface.registry",
          "snapshotKey": "xtend.surface.snapshot",
          "defaultLayer": "workspace",
          "stackPolicy": "single-active-surface",
          "routeBinding": {
            "route": "workbench",
            "contentKind": "surface-workbench"
          },
          "persistence": {
            "mode": "session",
            "key": "demo.surface.workbench.layout"
          }
        },
        "fabric": {
          "lane": "visible",
          "fiber": "surface.render",
          "telemetry": true
        }
      }
    },
    {
      "id": "workbench.inspector",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-window",
      "schedule": "surface.user-blocking.open",
      "props": {
        "label": "Inspector"
      },
      "attributes": {
        "surface-id": "inspector",
        "open": "true",
        "active": "true",
        "resizable": "true",
        "draggable": "true",
        "initial-x": "72",
        "initial-y": "72",
        "initial-width": "500",
        "initial-height": "340"
      },
      "slots": {
        "default": {
          "component": "inspector.content"
        }
      },
      "events": {
        "surface-window-command": {
          "command": "surface.inspector.command"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "window",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.inspector.state",
          "route": "workbench",
          "initialBounds": {
            "x": 72,
            "y": 72,
            "width": 500,
            "height": 340
          },
          "capabilities": [
            "move",
            "resize",
            "minimize",
            "maximize",
            "close"
          ],
          "persistence": {
            "mode": "session",
            "key": "workbench.inspector.layout"
          }
        },
        "fabric": {
          "lane": "user-blocking",
          "fiber": "surface.open",
          "telemetry": true
        },
        "a11y": {
          "role": "dialog",
          "label": "Inspector",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "workbench.editor",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-surface-window",
      "schedule": "surface.user-blocking.open",
      "props": {
        "label": "Editor"
      },
      "attributes": {
        "surface-id": "editor",
        "open": "true",
        "resizable": "true",
        "draggable": "true",
        "initial-x": "610",
        "initial-y": "96",
        "initial-width": "560",
        "initial-height": "390"
      },
      "slots": {
        "default": {
          "component": "editor.content"
        }
      },
      "events": {
        "surface-window-command": {
          "command": "surface.editor.command"
        },
        "surface-layout-changed": {
          "command": "surface.editor.layout.changed"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "window",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.editor.state",
          "route": "workbench",
          "initialBounds": {
            "x": 610,
            "y": 96,
            "width": 560,
            "height": 390
          },
          "capabilities": [
            "move",
            "resize",
            "minimize",
            "maximize",
            "close"
          ],
          "persistence": {
            "mode": "session",
            "key": "workbench.editor.layout"
          }
        },
        "fabric": {
          "lane": "user-blocking",
          "fiber": "surface.open",
          "telemetry": true
        },
        "a11y": {
          "role": "dialog",
          "label": "Editor",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "workbench.properties",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-side-panel",
      "schedule": "surface.visible.render",
      "props": {
        "label": "Properties"
      },
      "attributes": {
        "surface-id": "properties",
        "open": "true",
        "placement": "right",
        "mode": "pinned",
        "pinned": "true",
        "resizable": "true",
        "route-aware": "true",
        "initial-width": "320"
      },
      "slots": {
        "default": {
          "component": "properties.content"
        }
      },
      "events": {
        "surface-panel-command": {
          "command": "surface.properties.command"
        }
      },
      "metadata": {
        "surface": {
          "schema": "xtend.surface.record.v1",
          "type": "side-panel",
          "manager": "workbench.manager",
          "stateKey": "xtend.surface.properties.state",
          "route": "workbench",
          "placement": "right",
          "mode": "pinned",
          "capabilities": [
            "dock",
            "collapse",
            "resize",
            "pin"
          ],
          "responsive": {
            "mobileMode": "fullscreen-panel"
          },
          "persistence": {
            "mode": "session",
            "key": "workbench.properties.layout"
          }
        },
        "fabric": {
          "lane": "visible",
          "fiber": "surface.render",
          "telemetry": true
        },
        "a11y": {
          "role": "complementary",
          "label": "Properties",
          "modal": false,
          "focusRestore": true
        }
      }
    },
    {
      "id": "inspector.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-section",
      "schedule": "component.visible.mount",
      "props": {
        "label": "Inspector Content"
      },
      "attributes": {
        "data-route-bound": "workbench",
        "data-surface-content": "inspector"
      },
      "slots": {
        "default": {
          "template": "inspector.content.template"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "visible",
          "fiber": "component.mount",
          "telemetry": true
        }
      }
    },
    {
      "id": "editor.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-code",
      "schedule": "component.idle.hydrate",
      "props": {
        "language": "json",
        "code": "{\n  \"surface\": \"editor\",\n  \"route\": \"workbench\",\n  \"snapshot\": \"xtend.surface.snapshot\"\n}"
      },
      "attributes": {
        "data-route-bound": "workbench",
        "data-surface-content": "editor"
      },
      "metadata": {
        "fabric": {
          "lane": "idle",
          "fiber": "component.hydrate",
          "telemetry": true
        }
      }
    },
    {
      "id": "properties.content",
      "kind": "custom_element",
      "adapter": "xtend.component",
      "tag": "x-form",
      "schedule": "component.idle.hydrate",
      "props": {
        "label": "Properties"
      },
      "attributes": {
        "data-route-bound": "workbench",
        "data-surface-content": "properties"
      },
      "slots": {
        "default": {
          "template": "properties.content.template"
        }
      },
      "events": {
        "submit": {
          "command": "surface.properties.save"
        }
      },
      "metadata": {
        "fabric": {
          "lane": "idle",
          "fiber": "component.hydrate",
          "telemetry": true
        }
      }
    }
  ],
  "routes": [
    {
      "id": "workbench",
      "path": "/",
      "router": "xtend.xrouter",
      "component": "workbench.manager",
      "template": "workbench.route.template",
      "shell": "app.shell.template",
      "schedule": "route.visible.render",
      "metadata": {
        "surfaceManager": "workbench.manager",
        "routeBoundContent": true,
        "routeBoundSurfaces": [
          "inspector",
          "editor",
          "properties"
        ],
        "sharedSnapshotKey": "xtend.surface.snapshot",
        "contentKind": "surface-workbench"
      }
    }
  ],
  "schedules": [
    {
      "id": "app.shell.render",
      "endpointName": "xtendrmt.shell.render",
      "scope": "xtend.surface.shell",
      "lane": "visible",
      "priority": 82,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "route.visible.render",
      "endpointName": "xtendrmt.route.render",
      "scope": "xtend.surface.route",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "surface.visible.render",
      "endpointName": "xtendrmt.surface.render",
      "scope": "xtend.surface.render",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "visible",
        "surfaceContract": "xtend.surface.manager.v1"
      }
    },
    {
      "id": "surface.user-blocking.open",
      "endpointName": "xtendrmt.surface.open",
      "scope": "xtend.surface.open",
      "lane": "user-blocking",
      "priority": 100,
      "deadlineMs": 80,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "user-blocking",
        "surfaceContract": "xtend.surface.record.v1"
      }
    },
    {
      "id": "surface.user-blocking.close",
      "endpointName": "xtendrmt.surface.close",
      "scope": "xtend.surface.close",
      "lane": "user-blocking",
      "priority": 100,
      "deadlineMs": 80,
      "preferIdle": false
    },
    {
      "id": "surface.transition.layout",
      "endpointName": "xtendrmt.surface.layout",
      "scope": "xtend.surface.layout",
      "lane": "transition",
      "priority": 65,
      "deadlineMs": 240,
      "preferIdle": false
    },
    {
      "id": "surface.background.persist",
      "endpointName": "xtendrmt.surface.persist",
      "scope": "xtend.surface.persist",
      "lane": "background",
      "priority": 25,
      "deadlineMs": 1000,
      "preferIdle": true
    },
    {
      "id": "surface.diagnostics.snapshot",
      "endpointName": "xtendrmt.surface.diagnostics",
      "scope": "xtend.surface.diagnostics",
      "lane": "diagnostics",
      "priority": 20,
      "deadlineMs": 750,
      "preferIdle": true
    },
    {
      "id": "component.visible.mount",
      "endpointName": "xtendrmt.component.mount",
      "scope": "xtend.component.visible",
      "lane": "visible",
      "priority": 80,
      "deadlineMs": 160,
      "preferIdle": false
    },
    {
      "id": "component.idle.hydrate",
      "endpointName": "xtendrmt.component.hydrate",
      "scope": "xtend.component.idle",
      "lane": "idle",
      "priority": 35,
      "deadlineMs": 500,
      "preferIdle": true
    },
    {
      "id": "a11y.user-blocking.announce",
      "endpointName": "xtendrmt.a11y.announce",
      "scope": "xtend.surface.a11y",
      "lane": "user-blocking",
      "priority": 95,
      "deadlineMs": 80,
      "preferIdle": false,
      "metadata": {
        "fabricLane": "a11y"
      }
    },
    {
      "id": "diagnostics.snapshot",
      "endpointName": "xtendrmt.diagnostics.snapshot",
      "scope": "xtend.surface.global-diagnostics",
      "lane": "diagnostics",
      "priority": 20,
      "deadlineMs": 750,
      "preferIdle": true
    }
  ],
  "templates": [
    {
      "id": "app.shell.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "section",
          "attributes": {
            "class": "surface-workbench-shell",
            "data-rmt-template": "app.shell.template"
          },
          "children": [
            {
              "tag": "header",
              "attributes": {
                "class": "surface-workbench-header"
              },
              "children": [
                {
                  "tag": "div",
                  "attributes": {
                    "class": "surface-workbench-title"
                  },
                  "children": [
                    {
                      "tag": "strong",
                      "text": "XTend Surface Workbench"
                    },
                    {
                      "tag": "span",
                      "text": "RMT-first App Shell"
                    }
                  ]
                },
                {
                  "tag": "nav",
                  "attributes": {
                    "aria-label": "Workbench routes"
                  },
                  "children": [
                    {
                      "tag": "a",
                      "attributes": {
                        "href": "#/",
                        "data-rmt-route-link": "workbench"
                      },
                      "text": "Workbench"
                    }
                  ]
                }
              ]
            },
            {
              "tag": "main",
              "attributes": {
                "class": "surface-workbench-main"
              },
              "children": [
                {
                  "component": "app.router"
                }
              ]
            }
          ]
        }
      ],
      "metadata": {
        "renderMode": "shell-first",
        "routeOutlet": "app.router"
      }
    },
    {
      "id": "workbench.route.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "component": "workbench.manager"
        }
      ],
      "metadata": {
        "routeBoundContent": true,
        "surfaceManager": "workbench.manager"
      }
    },
    {
      "id": "inspector.content.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-alert",
          "props": {
            "type": "info",
            "message": "Surface registry, z-order and route binding are authored in RMT."
          }
        },
        {
          "tag": "x-status",
          "props": {
            "label": "Snapshot",
            "message": "xtend.surface.snapshot"
          }
        }
      ],
      "metadata": {
        "trustedDom": "dom_descriptor"
      }
    },
    {
      "id": "properties.content.template",
      "mode": "dom_descriptor",
      "nodes": [
        {
          "tag": "x-input",
          "props": {
            "name": "surfaceLabel",
            "label": "Surface label",
            "value": "Inspector"
          },
          "events": {
            "input-changed": "surface.properties.label.changed"
          }
        },
        {
          "tag": "x-status",
          "props": {
            "label": "Route",
            "message": "workbench"
          }
        }
      ],
      "metadata": {
        "eventBindingMode": "dom-event-to-rmt-command"
      }
    }
  ],
  "diagnostics": {
    "schema": "xtend.surface.workbench-fixture-diagnostics.v1",
    "snapshotKey": "xtend.surface.snapshot",
    "assertions": [
      "two-windows",
      "one-side-panel",
      "route-bound-content",
      "shared-surface-snapshot",
      "no-manual-shell",
      "no-rmt-kernel-import-of-xtend-types"
    ]
  }
}
