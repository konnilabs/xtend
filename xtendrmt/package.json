    "url": "git+https://github.com/konnilabs/xtend.git",
    "directory": "xtendrmt"
  },
  "type": "module",
  "keywords": [
    "ccslabs",
    "xtend",
    "xtendrmt",
    "scheduler",
    "runtime"
  ],
  "main": "./rmt-runtime.esm.js",
