  "browser": "./rmt-runtime.browser.js",
  "files": [
    "rmt-core.d.ts",
    "rmt-core.esm.js",
    "rmt-runtime.esm.js",
    "rmt-runtime.browser.js",
    "rmt-dom-descriptor-renderer.d.ts",
    "rmt-dom-descriptor-renderer.js",
    "rmt-component-capability-registry.d.ts",
    "rmt-component-capability-registry.js",
    "rmt-state-selector-runtime.d.ts",
    "rmt-state-selector-runtime.js",
    "rmt-action-effect-runtime.d.ts",
    "rmt-action-effect-runtime.js",
    "rmt-event-routing-runtime.d.ts",
    "rmt-event-routing-runtime.js",
    "rmt-surface-resource-graph-runtime.d.ts",
    "rmt-surface-resource-graph-runtime.js",
    "rmt-native-shell-runtime.d.ts",
    "rmt-native-shell-runtime.js",
    "rmt-node-ssr-adapter.d.ts",
    "rmt-node-ssr-adapter.js",
    "rmt.schema.json",
    "rmt-manifest.json",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./rmt-core.d.ts",
      "browser": "./rmt-runtime.browser.js",
      "default": "./rmt-runtime.esm.js"
    },
    "./core": {
      "types": "./rmt-core.d.ts",
      "default": "./rmt-core.esm.js"
    },
    "./runtime": {
      "types": "./rmt-core.d.ts",
      "browser": "./rmt-runtime.browser.js",
      "default": "./rmt-runtime.esm.js"
    },
    "./browser": {
      "types": "./rmt-core.d.ts",
      "browser": "./rmt-runtime.browser.js",
      "default": "./rmt-runtime.browser.js"
    },
    "./dom-descriptor-renderer": {
      "types": "./rmt-dom-descriptor-renderer.d.ts",
      "default": "./rmt-dom-descriptor-renderer.js"
    },
    "./component-capability-registry": {
      "types": "./rmt-component-capability-registry.d.ts",
      "default": "./rmt-component-capability-registry.js"
    },
    "./state-selector-runtime": {
      "types": "./rmt-state-selector-runtime.d.ts",
      "default": "./rmt-state-selector-runtime.js"
    },
    "./action-effect-runtime": {
      "types": "./rmt-action-effect-runtime.d.ts",
      "default": "./rmt-action-effect-runtime.js"
    },
    "./event-routing-runtime": {
      "types": "./rmt-event-routing-runtime.d.ts",
      "default": "./rmt-event-routing-runtime.js"
    },
    "./surface-resource-graph-runtime": {
      "types": "./rmt-surface-resource-graph-runtime.d.ts",
      "default": "./rmt-surface-resource-graph-runtime.js"
    },
    "./native-shell-runtime": {
      "types": "./rmt-native-shell-runtime.d.ts",
      "default": "./rmt-native-shell-runtime.js"
    },
    "./node-ssr-adapter": {
      "types": "./rmt-node-ssr-adapter.d.ts",
      "default": "./rmt-node-ssr-adapter.js"
    },
    "./schema": "./rmt.schema.json",
    "./manifest": "./rmt-manifest.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
